# "Hello, world!" for Linux x86-64, written in BitterASM — including its
# ELF executable header (`std.formats.elf`).
#
# Build and run (from the repository root):
# bitter build examples/x86_64/hello.basm -o /tmp/hello
# /tmp/hello

from std.x86_64.nasm import *
from std.formats.elf import *
from std.linux.x86_64 import SYS_write, SYS_exit, STDOUT_FILENO

elf64_executable EM_X86_64, _start

const text = "Hello, World!\n"

section .rodata
msg:
    db text

section .text
pub _start:
    mov eax, SYS_write
    mov edi, STDOUT_FILENO
    lea rsi, [rel msg]  # buffer
    mov edx, text.len   # length
    syscall

    mov eax, SYS_exit
    xor edi, edi        # status 0
    syscall
