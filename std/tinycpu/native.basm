from std.binary import *
from std import cstring
from std.cstring import CString

pub struct Reg<const width: int> {
    pub const id: bits<2>
}

pub type Reg64 = Reg<64>

macro make_reg64(id: bits<2>) {
    pub const r`id` = Reg64(`id`)
}

@for i in 0..16 {
    make_reg64(i)
}

# =================
# Instructions
# =================

macro make_binary_math_instr(
    name: CString,
    opcode: bits<32>,
) {
    struct `cstring.title(name)`Instr {
        const opcode: bits<32>,
        const dest: Reg64,
        const src1: Reg64,
        const src2: Reg64
    }

    pub macro `name`(dest: Reg64, src1: Reg64, src2: Reg64) {
        @emit `cstring.title(name)`Instr {
            opcode: `opcode`,
            dest: \`dest\`,
            src1: \`src1\`,
            src2: \`src2\`
        }
    }
}

make_binary_math_instr("add", 0x00000001)
make_binary_math_instr("sub", 0x00000002)
make_binary_math_instr("and", 0x00000003)
make_binary_math_instr("or",  0x00000004)
make_binary_math_instr("xor", 0x00000005)
make_binary_math_instr("shl", 0x00000006) # shift left
make_binary_math_instr("shr", 0x00000007) # shift right
make_binary_math_instr("sar", 0x00000008) # shift arithmetic right
make_binary_math_instr("slt", 0x00000009) # set less than
make_binary_math_instr("sltu", 0x0000000A) # set less than unsigned