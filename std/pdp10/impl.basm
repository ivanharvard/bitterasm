#! The PDP-10: 36-bit words, 16 accumulators, and a representative subset
#! of its instructions, all in the one word format.
#!
#! ```
#! from std.pdp10.impl import *
#!
#! movei ac1, 0, Index(0), 42
#! ```
#!
#! ```bytes
#! 04 08 80 00 2a
#! ```
#!
#! Each instruction takes its operands as the manual's fields: accumulator
#! `ac`, indirect bit `i`, index register `x`, and address `y`. The machine
#! is word-addressed, so a word has no byte order; `bitter` packs its 36
#! bits into 5 bytes with 4 zero bits above them.
#!
#! Opcodes are from the DEC PDP-10 System Reference Manual (DEC-10-HGAA-D),
#! Appendix A.

from std.binary import *
from std.bitfield import *

# =================
# accumulators
# =================
# 16 general-purpose accumulators. Unlike RISC-V's `x0`, no accumulator is
# wired to zero by the ISA, and no ABI names are assigned here: ITS,
# TOPS-10, and TOPS-20 each had their own accumulator conventions (which
# one is the stack pointer, if any), and picking one would be inventing a
# convention this language has no business asserting.

## An accumulator number, 0 to 15.
pub type AC = bits<4>

@for i in 0..16 {
    ## An accumulator. None is wired to zero, and there are no ABI names:
    ## each PDP-10 operating system had its own conventions.
    pub const ac`i` = AC(i)
}

# =================
# field widths
# =================
# One alias per distinct instruction-word field, even where widths
# coincide (`Index` and `AC` are both `bits<4>` — any accumulator can
# double as an index register — but each gets its own alias so a struct
# field stays self-documenting about which role it plays).

## The 9-bit opcode.
pub type Opcode = bits<9>
## The indirect bit: 1 means `y` holds the address of the operand's address.
pub type Indirect = bits<1>
## An index register number. Any accumulator but 0 can be one; 0 means
## none.
pub type Index = bits<4>
## An 18-bit address.
pub type Addr = bits<18>

# =================
# instruction format
# =================
# Nearly every PDP-10 instruction shares this one 36-bit shape (opcode 9 /
# ac 4 / indirect 1 / index 4 / address 18 — field order is bit order,
# most-significant field first, matching how `bitter`'s packer concatenates
# a struct's fields, and matching the field order the DEC PDP-10 System
# Reference Manual's own "BASIC INSTRUCTIONS" word-format diagram uses).
#
# Unlike RV32I there's no second or third format to disambiguate: opcode
# alone always picks the instruction, and `i`/`x`/`y` always mean the same
# thing structurally. What `i`/`x`/`y` mean once a real CPU resolves them
# into an effective address at runtime is exactly the kind of execution
# semantics bitterasm has no business modeling — same boundary RISC-V's own
# instruction macros already draw around their own operand fields. Every
# macro below just encodes the literal bits its caller supplies.
#
# No `LittleEndian<Instr, 36>` wrapper: the PDP-10 is word-addressed, not
# byte-addressable, so byte order isn't a property it has (see
# `std.bitter.byte_order`'s own doc comment). `bitter`'s packer pads this
# struct's 36 bits to 5 bytes on its own, with no help needed here.
## The PDP-10 instruction word: opcode (9 bits), `ac` (4), `i` (1), `x` (4)
## and `y` (18), most significant first.
pub struct Instr {
    opcode: Opcode,
    ac: AC,
    i: Indirect,
    x: Index,
    y: Addr,
}

# =================
# instructions
# =================
# A representative subset, not full ISA coverage — enough categories to
# prove the 36-bit format actually works: no-address control, jumps to a
# direct address, immediate load, memory load/store, arithmetic (register-
# and immediate-addressed), logical, compare-and-skip, and exchange.
# Opcode values below are from the DEC PDP-10 System Reference Manual
# (DEC-10-HGAA-D), Appendix A's numeric instruction-mnemonic listing.

## An instruction with any opcode, for one this module doesn't name, such as
## an operating system's monitor call.
pub macro instr(
    opcode: int,
    ac: int,
    i: int,
    x: int,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(opcode),
        ac = AC(ac),
        i = truncate(i, 1),
        x = Index(x),
        y = truncate(y, 18)
    )
}

# HALT is documented in the manual's own word-format chart as `JRST 4,` —
# opcode 0254 with the ac field fixed to 4, not a separate opcode of its
# own.
## Stops the processor. It's `JRST 4,`.
pub macro halt()
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o254),
        ac = AC(4),
        i = Indirect(0),
        x = Index(0),
        y = Addr(0)
    )
}

## Jumps to the effective address.
pub macro jrst(
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o254),
        ac = AC(0),
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Jumps to the effective address. `JUMPA` is `JUMP` with the "always"
## condition.
pub macro jumpa(
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o324),
        ac = AC(0),
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Loads the effective address itself, not what's there, into `ac`: an
## immediate load.
pub macro movei(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o201),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Loads the word at the effective address into `ac`.
pub macro move(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o200),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Stores `ac` at the effective address.
pub macro movem(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o202),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

# `y` doubles as another accumulator's address when the caller wants
# AC-to-AC arithmetic: the first 16 words of memory (addresses 0-17 octal)
# are wired to the accumulators themselves, so `add(ac1, 0, 0, 2)` adds
# `ac2` into `ac1` with no separate register-register format needed.
## Adds the word at the effective address into `ac`. Addresses 0 to 15 are
## the accumulators, so `add(ac1, 0, Index(0), 2)` adds `ac2` into `ac1`.
pub macro add(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o270),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Adds the effective address itself into `ac`.
pub macro addi(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o271),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Subtracts the word at the effective address from `ac`.
pub macro sub(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o274),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## ANDs the word at the effective address into `ac`.
pub macro and(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o404),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

# Compare AC with the effective operand and skip the next instruction if
# not equal — PDP-10's actual conditional-control-flow primitive. It never
# needs a PC-relative delta the way RISC-V's `beq`/`bne` do (no `here()`,
# no `Positioned<N>`): "skip the next instruction" needs no address at all.
## Compares `ac` with the effective address itself, and skips the next
## instruction if they're not equal.
pub macro cain(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o306),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

## Swaps `ac` with the word at the effective address.
pub macro exch(
    ac: AC,
    i: int,
    x: Index,
    y: int
)
    | emits Instr
{
    @emit Instr(
        opcode = Opcode(0o250),
        ac = ac,
        i = truncate(i, 1),
        x = x,
        y = truncate(y, 18)
    )
}

# =================
# data
# =================

## A 36-bit data word.
pub type Word = bits<36>

# Character `i` of `source`, or NUL past its end.
macro char_or_nul<S>(source: S, i: int) -> int {
    @if i < source.len {
        const c = source.__el`i`
        @assert c >= 0 && c < 0x80, "asciz takes 7-bit ASCII"
        @return c
    } @else {
        @return 0
    }
}

## A string packed the way MACRO-10's `ASCIZ` packs it: five 7-bit
## characters to a word, first character in the high bits, low bit unused,
## and at least one NUL at the end. Each word is its own emitted value, so a
## label after it still counts words.
pub macro asciz<S>(source: S) {
    @for k in 0..source.len / 5 + 1 {
        const first = place(char_or_nul(source, 5 * k), 35, 29) | place(char_or_nul(source, 5 * k + 1), 28, 22)
        const rest = place(char_or_nul(source, 5 * k + 2), 21, 15) | place(char_or_nul(source, 5 * k + 3), 14, 8) | place(char_or_nul(source, 5 * k + 4), 7, 1)
        @emit Word(first | rest)
    }
}
