from std.binary import BITS_PER_BYTE, Endian

# Every per-character walk below either loops with `@for` or recurses by
# halving its range, never one call per character: macro calls nest at most
# 32 deep, and halving keeps the depth at log2(len) + a few, so string length
# is effectively unbounded.
#
# Packed strings store exactly `len` bytes in `value`. Endianness controls
# which packed byte is logical byte zero; it does not change UTF-8 itself.
pub struct String<const len: int>
    | invariant validate_string(value, len)
    | to string_to_ascii(source, target.len, target.endian)
    | to string_to_utf8(source, target.len, target.endian)
{
    pub value: int,
    pub len: int,
}

pub struct AsciiString<const len: int, const endian: Endian>
    | invariant validate_ascii(value, len, endian)
    | to ascii_to_utf8(source, target.len, target.endian)
{
    pub value: int,
    pub len: int,
    pub endian: Endian,
}

pub struct Utf8String<const len: int, const endian: Endian>
    | invariant validate_utf8(value, len, endian)
{
    pub value: int,
    pub len: int,
    pub endian: Endian,
}

macro validate_string(
    value: int,
    len: int
) -> int {
    @assert len >= 0, "string length cannot be negative"
    @assert value >= 0, "packed strings cannot be negative"
    @if len == 0 {
        @assert value == 0, "an empty string must have value zero"
        @return 1
    }
    @assert value < (1 << (BITS_PER_BYTE * len)), "string value exceeds its declared length"
    @return 1
}

pub macro byte_at(
    value: int,
    len: int,
    index: int,
    endian: Endian
) -> int {
    @assert index >= 0, "string indices cannot be negative"
    @assert index < len, "string byte index is out of bounds"
    @if endian == Endian.Little {
        @return (value >> (index * BITS_PER_BYTE)) & 0xFF
    }
    @return (value >> ((len - index - 1) * BITS_PER_BYTE)) & 0xFF
}

macro utf8_codepoint_byte_len(codepoint: int) -> int {
    @assert codepoint >= 0, "UTF-8 code point cannot be negative"
    @assert codepoint <= 0x10FFFF, "UTF-8 code point exceeds U+10FFFF"
    @assert codepoint < 0xD800 || codepoint > 0xDFFF, "UTF-8 cannot encode a surrogate"
    @if codepoint <= 0x7F {
        @return 1
    }
    @if codepoint <= 0x7FF {
        @return 2
    }
    @if codepoint <= 0xFFFF {
        @return 3
    }
    @return 4
}

# UTF-8 byte length of code points `lo..hi` of `source`.
macro utf8_struct_byte_len_range<S>(
    source: S,
    lo: int,
    hi: int
) -> int {
    @if hi - lo == 0 {
        @return 0
    }
    @if hi - lo == 1 {
        @return utf8_codepoint_byte_len(source.__el`lo`)
    }
    const mid = (lo + hi) / 2
    @return utf8_struct_byte_len_range(source, lo, mid) + utf8_struct_byte_len_range(source, mid, hi)
}

pub macro utf8_struct_byte_len<S>(source: S) -> int {
    @return utf8_struct_byte_len_range(source, 0, source.len)
}

macro utf8_codepoint_packed(codepoint: int) -> int {
    const len = utf8_codepoint_byte_len(codepoint)
    @if len == 1 {
        @return codepoint
    }
    @if len == 2 {
        const b0 = 0xC0 | (codepoint >> 6)
        const b1 = 0x80 | (codepoint & 0x3F)
        @return (b0 << 8) | b1
    }
    @if len == 3 {
        const b0 = 0xE0 | (codepoint >> 12)
        const b1 = 0x80 | ((codepoint >> 6) & 0x3F)
        const b2 = 0x80 | (codepoint & 0x3F)
        @return (b0 << 16) | (b1 << 8) | b2
    }
    const b0 = 0xF0 | (codepoint >> 18)
    const b1 = 0x80 | ((codepoint >> 12) & 0x3F)
    const b2 = 0x80 | ((codepoint >> 6) & 0x3F)
    const b3 = 0x80 | (codepoint & 0x3F)
    @return (b0 << 24) | (b1 << 16) | (b2 << 8) | b3
}

# Code points `lo..hi` of `source`, UTF-8 encoded and packed first byte most
# significant.
macro utf8_struct_value_range<S>(
    source: S,
    lo: int,
    hi: int
) -> int {
    @if hi - lo == 0 {
        @return 0
    }
    @if hi - lo == 1 {
        @return utf8_codepoint_packed(source.__el`lo`)
    }
    const mid = (lo + hi) / 2
    const high = utf8_struct_value_range(source, lo, mid)
    const low_len = utf8_struct_byte_len_range(source, mid, hi)
    const low = utf8_struct_value_range(source, mid, hi)
    @return (high << (low_len * BITS_PER_BYTE)) | low
}

pub macro string_from_struct<S>(source: S)
{
    const byte_len = utf8_struct_byte_len(source)
    @return String<byte_len> {
        value: utf8_struct_value_range(source, 0, source.len),
        len: byte_len,
    }
}

# 0x80 in each of `len` bytes: a string is ASCII exactly when it has none of
# these bits set, whatever its byte order.
macro high_bits_mask(len: int) -> int {
    @return (((1 << (BITS_PER_BYTE * len)) - 1) / 0xFF) * 0x80
}

pub macro validate_ascii(
    value: int,
    len: int,
    endian: Endian
) -> int {
    @assert validate_string(value, len)
    @assert (value & high_bits_mask(len)) == 0, "non-ASCII byte"
    @return 1
}

macro is_continuation(byte: int) -> int {
    @return byte >= 0x80 && byte <= 0xBF
}

# Sequence length a UTF-8 leading byte announces (1 for anything that isn't a
# valid multi-byte lead).
macro utf8_lead_len(byte: int) -> int {
    @if byte >= 0xC2 && byte <= 0xDF {
        @return 2
    }
    @if byte >= 0xE0 && byte <= 0xEF {
        @return 3
    }
    @if byte >= 0xF0 && byte <= 0xF4 {
        @return 4
    }
    @return 1
}

# Checks the sequence that starts at non-continuation byte `index`.
macro validate_utf8_lead(
    value: int,
    len: int,
    index: int,
    endian: Endian
) -> int {
    const b0 = byte_at(value, len, index, endian)
    @if b0 <= 0x7F {
        @return 1
    }

    @if b0 >= 0xC2 && b0 <= 0xDF {
        @assert index + 1 < len, "truncated two-byte UTF-8 sequence"
        @assert is_continuation(byte_at(
                value,
                len,
                index + 1,
                endian
        )), "invalid UTF-8 continuation byte"
        @return 1
    }

    @if b0 >= 0xE0 && b0 <= 0xEF {
        @assert index + 2 < len, "truncated three-byte UTF-8 sequence"
        const b1 = byte_at(value, len, index + 1, endian)
        const b2 = byte_at(value, len, index + 2, endian)
        @assert is_continuation(b1) && is_continuation(b2), "invalid UTF-8 continuation byte"
        @assert b0 != 0xE0 || b1 >= 0xA0, "overlong UTF-8 sequence"
        @assert b0 != 0xED || b1 <= 0x9F, "UTF-8 cannot encode a surrogate"
        @return 1
    }

    @if b0 >= 0xF0 && b0 <= 0xF4 {
        @assert index + 3 < len, "truncated four-byte UTF-8 sequence"
        const b1 = byte_at(value, len, index + 1, endian)
        const b2 = byte_at(value, len, index + 2, endian)
        const b3 = byte_at(value, len, index + 3, endian)
        @assert is_continuation(b1) && is_continuation(b2) && is_continuation(b3), "invalid UTF-8 continuation byte"
        @assert b0 != 0xF0 || b1 >= 0x90, "overlong UTF-8 sequence"
        @assert b0 != 0xF4 || b1 <= 0x8F, "UTF-8 code point exceeds U+10FFFF"
        @return 1
    }

    @assert 0, "invalid UTF-8 leading byte"
}

# Whether continuation byte `index` belongs to the sequence started by the
# nearest non-continuation byte before it, i.e. that lead announced a sequence
# long enough to reach it.
macro utf8_continuation_covered(
    value: int,
    len: int,
    index: int,
    endian: Endian
) -> int {
    @for back in 1..4 {
        @if back <= index {
            const b = byte_at(value, len, index - back, endian)
            @if !is_continuation(b) {
                @return utf8_lead_len(b) > back
            }
        }
    }
    @return 0
}

# Byte by byte rather than sequence by sequence, so no step depends on the
# last: every lead must be followed by its continuations (checked from the
# lead), and every continuation must be claimed by a preceding lead.
pub macro validate_utf8(
    value: int,
    len: int,
    endian: Endian
) -> int {
    @assert validate_string(value, len)
    @for i in 0..len {
        @if is_continuation(byte_at(value, len, i, endian)) {
            @assert utf8_continuation_covered(value, len, i, endian), "invalid UTF-8 leading byte"
        } @else {
            @assert validate_utf8_lead(value, len, i, endian)
        }
    }
    @return 1
}

macro string_to_ascii(
    s: String,
    len: int,
    endian: Endian
) -> AsciiString {
    @assert s.len == len, "conversion target length must match the source"
    @return AsciiString(value = s.value, len = len, endian = endian)
}

macro string_to_utf8(
    s: String,
    len: int,
    endian: Endian
) -> Utf8String {
    @assert s.len == len, "conversion target length must match the source"
    @return Utf8String(value = s.value, len = len, endian = endian)
}

macro ascii_to_utf8(
    s: AsciiString,
    len: int,
    endian: Endian
) -> Utf8String {
    @assert s.len == len, "conversion target length must match the source"
    @assert s.endian == endian, "conversion cannot silently change byte order"
    @return Utf8String(value = s.value, len = len, endian = endian)
}

pub macro ascii_byte_at(
    s: AsciiString,
    index: int
) -> int {
    @return byte_at(s.value, s.len, index, s.endian)
}

pub macro utf8_byte_at(
    s: Utf8String,
    index: int
) -> int {
    @return byte_at(s.value, s.len, index, s.endian)
}

macro ascii_case_byte(
    byte: int,
    upper: int
) -> int {
    @if upper && byte >= 'a' && byte <= 'z' {
        @return byte - ('a' - 'A')
    }
    @if !upper && byte >= 'A' && byte <= 'Z' {
        @return byte + ('a' - 'A')
    }
    @return byte
}

macro byte_shift(
    index: int,
    len: int,
    endian: Endian
) -> int {
    @if endian == Endian.Little {
        @return index * BITS_PER_BYTE
    }
    @return (len - index - 1) * BITS_PER_BYTE
}

# Bytes `lo..hi` of `value`, case-mapped, each still at its own position.
macro ascii_case_value(
    value: int,
    len: int,
    lo: int,
    hi: int,
    endian: Endian,
    upper: int
) -> int {
    @if hi - lo == 0 {
        @return 0
    }
    @if hi - lo == 1 {
        const byte = ascii_case_byte(byte_at(value, len, lo, endian), upper)
        @return byte << byte_shift(lo, len, endian)
    }
    const mid = (lo + hi) / 2
    @return ascii_case_value(value, len, lo, mid, endian, upper) | ascii_case_value(value, len, mid, hi, endian, upper)
}

pub macro ascii_upper(s: AsciiString) -> AsciiString {
    @return AsciiString<s.len, s.endian> {
        value: ascii_case_value(s.value, s.len, 0, s.len, s.endian, 1),
        len: s.len,
        endian: s.endian,
    }
}

pub macro ascii_lower(s: AsciiString) -> AsciiString {
    @return AsciiString<s.len, s.endian> {
        value: ascii_case_value(s.value, s.len, 0, s.len, s.endian, 0),
        len: s.len,
        endian: s.endian,
    }
}

pub macro ascii_title(s: AsciiString) -> AsciiString {
    @if s.len == 0 {
        @return s
    }
    const first = byte_at(s.value, s.len, 0, s.endian)
    const cased = ascii_case_byte(first, 1)
    const shift = byte_shift(0, s.len, s.endian)
    const mask = 0xFF << shift
    @return AsciiString<s.len, s.endian> {
        value: (s.value & ~mask) | (cased << shift),
        len: s.len,
        endian: s.endian,
    }
}

# Leading (non-continuation) bytes among bytes `lo..hi`: one per code point.
macro utf8_lead_count(
    value: int,
    len: int,
    lo: int,
    hi: int,
    endian: Endian
) -> int {
    @if hi - lo == 0 {
        @return 0
    }
    @if hi - lo == 1 {
        @return !is_continuation(byte_at(value, len, lo, endian))
    }
    const mid = (lo + hi) / 2
    @return utf8_lead_count(value, len, lo, mid, endian) + utf8_lead_count(value, len, mid, hi, endian)
}

pub macro utf8_codepoint_count(s: Utf8String) -> int {
    @return utf8_lead_count(s.value, s.len, 0, s.len, s.endian)
}

pub macro utf8_is_ascii(s: Utf8String) -> int {
    @return (s.value & high_bits_mask(s.len)) == 0
}
