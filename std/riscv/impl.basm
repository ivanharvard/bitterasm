from std.binary import *

# =================
# registers
# =================
# 32 general-purpose registers, 5 bits each. x0 is wired to zero by the ISA
# spec, not by anything here — nothing stops constructing Reg(0) again.

pub type Reg = bits<5>

@for i in 0..32 {
    pub const x`i` = Reg(i)
}

# Standard ABI names, aliased to the `xN` registers they name.
pub const zero = x0
pub const ra = x1
pub const sp = x2
pub const gp = x3
pub const tp = x4
pub const t0 = x5
pub const t1 = x6
pub const t2 = x7
pub const s0 = x8
pub const fp = x8
pub const s1 = x9
pub const a0 = x10
pub const a1 = x11
pub const a2 = x12
pub const a3 = x13
pub const a4 = x14
pub const a5 = x15
pub const a6 = x16
pub const a7 = x17
pub const s2 = x18
pub const s3 = x19
pub const s4 = x20
pub const s5 = x21
pub const s6 = x22
pub const s7 = x23
pub const s8 = x24
pub const s9 = x25
pub const s10 = x26
pub const s11 = x27
pub const t3 = x28
pub const t4 = x29
pub const t5 = x30
pub const t6 = x31

# =================
# field widths
# =================
# One alias per distinct bit-field width RV32I's six instruction formats
# use. `bitter`'s packer only needs to know a value's width — it's
# expected to walk an instruction struct's fields in declaration order and
# concatenate each one's bits, with no opinion of its own about opcodes or
# formats. Every field below is deliberately its own alias, even where two
# happen to share a width (`Funct7`/`Imm7` are both `bits<7>`), so a
# format struct's field types stay self-documenting.

pub type Opcode = bits<7>
pub type Funct3 = bits<3>
pub type Funct7 = bits<7>

pub type Bit1 = bits<1>
pub type Imm4 = bits<4>
pub type Imm5 = bits<5>
pub type Imm6 = bits<6>
pub type Imm7 = bits<7>
pub type Imm8 = bits<8>
pub type Imm10 = bits<10>
pub type Imm12 = bits<12>
pub type Imm20 = bits<20>

# =================
# instruction formats
# =================
# Field order is bit order, most-significant field first — bit 31 down to
# bit 0 — matching how `bitter`'s packer is meant to concatenate them.

pub struct RType {
    funct7: Funct7,
    rs2: Reg,
    rs1: Reg,
    funct3: Funct3,
    rd: Reg,
    opcode: Opcode,
}

pub struct IType {
    imm: Imm12,
    rs1: Reg,
    funct3: Funct3,
    rd: Reg,
    opcode: Opcode,
}

pub struct SType {
    imm_hi: Imm7,
    rs2: Reg,
    rs1: Reg,
    funct3: Funct3,
    imm_lo: Imm5,
    opcode: Opcode,
}

# The immediate's bits are scrambled across the word by the ISA spec, not
# by anything here — `imm[12]`/`imm[10:5]`/`imm[4:1]`/`imm[11]` are just
# this format's real field names, in the order RV32I actually lays them
# out, so a branch macro's own arithmetic (see `beq` etc. below) is the
# only place that "scrambling" is expressed at all.
pub struct BType {
    imm12: Bit1,
    imm10_5: Imm6,
    rs2: Reg,
    rs1: Reg,
    funct3: Funct3,
    imm4_1: Imm4,
    imm11: Bit1,
    opcode: Opcode,
}

pub struct UType {
    imm: Imm20,
    rd: Reg,
    opcode: Opcode,
}

pub struct JType {
    imm20: Bit1,
    imm10_1: Imm10,
    imm11: Bit1,
    imm19_12: Imm8,
    rd: Reg,
    opcode: Opcode,
}

# =================
# R-type: register-register ops
# =================

pub macro add(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b000), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro sub(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0100000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b000), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro sll(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b001), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro slt(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b010), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro sltu(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b011), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro xor(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b100), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro srl(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b101), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro sra(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0100000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b101), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro or(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b110), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

pub macro and(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> RType {
    @emit RType(
        funct7 = Funct7(0b0000000),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b111), rd = rd,
        opcode = Opcode(0b0110011)
    )
}

# =================
# I-type: register-immediate ops
# =================

pub macro addi(
    rd: Reg,
    rs1: Reg,
    imm: int
) -> IType {
    @emit IType(
        imm = Imm12(imm & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b000),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro slti(
    rd: Reg,
    rs1: Reg,
    imm: int
) -> IType {
    @emit IType(
        imm = Imm12(imm & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b010),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro sltiu(
    rd: Reg,
    rs1: Reg,
    imm: int
) -> IType {
    @emit IType(
        imm = Imm12(imm & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b011),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro xori(
    rd: Reg,
    rs1: Reg,
    imm: int
) -> IType {
    @emit IType(
        imm = Imm12(imm & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b100),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro ori(
    rd: Reg,
    rs1: Reg,
    imm: int
) -> IType {
    @emit IType(
        imm = Imm12(imm & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b110),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro andi(
    rd: Reg,
    rs1: Reg,
    imm: int
) -> IType {
    @emit IType(
        imm = Imm12(imm & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b111),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

# Shift-by-immediate is still I-type, but its 12-bit `imm` field is really
# two sub-fields BitterASM has no separate names for here: a 7-bit constant
# (0000000, or 0100000 for the arithmetic-shift variant) over a 5-bit shift
# amount — computed directly rather than split into their own struct
# fields, since RType/IType/etc. are meant to match RV32I's own format
# names, not a shift-specific seventh shape the ISA spec doesn't have.

pub macro slli(
    rd: Reg,
    rs1: Reg,
    shamt: int
) -> IType {
    @emit IType(
        imm = Imm12(shamt & 0b11111),
        rs1 = rs1,
        funct3 = Funct3(0b001),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro srli(
    rd: Reg,
    rs1: Reg,
    shamt: int
) -> IType {
    @emit IType(
        imm = Imm12(shamt & 0b11111),
        rs1 = rs1,
        funct3 = Funct3(0b101),
        rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro srai(
    rd: Reg,
    rs1: Reg,
    shamt: int
) -> IType {
    @emit IType(
        imm = Imm12((0b0100000 << 5) | (shamt & 0b11111)),
        rs1 = rs1,
        funct3 = Funct3(0b101), rd = rd,
        opcode = Opcode(0b0010011)
    )
}

pub macro jalr(
    rd: Reg,
    rs1: Reg,
    offset: int
) -> IType {
    @emit IType(
        imm = Imm12(offset & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b000),
        rd = rd,
        opcode = Opcode(0b1100111)
    )
}

pub macro ecall() -> IType {
    @emit IType(
        imm = Imm12(0),
        rs1 = x0,
        funct3 = Funct3(0b000),
        rd = x0,
        opcode = Opcode(0b1110011)
    )
}

pub macro ebreak() -> IType {
    @emit IType(
        imm = Imm12(1),
        rs1 = x0,
        funct3 = Funct3(0b000),
        rd = x0,
        opcode = Opcode(0b1110011)
    )
}

# =================
# I-type: loads
# =================
# Real assembly syntax reads the conventional `lw rd, offset(rs1)` way
# rather than default positional `lw rd, offset, rs1` — assigned separately
# in native.basm, not here, so an alternate dialect could assign its own
# spelling to these same macros without touching, or duplicating, this file.

pub macro lb(rd: Reg, offset: int, rs1: Reg) -> IType
{
    @emit IType(
        imm = Imm12(offset & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b000),
        rd = rd,
        opcode = Opcode(0b0000011)
    )
}

pub macro lh(rd: Reg, offset: int, rs1: Reg) -> IType
{
    @emit IType(
        imm = Imm12(offset & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b001),
        rd = rd,
        opcode = Opcode(0b0000011)
    )
}

pub macro lw(rd: Reg, offset: int, rs1: Reg) -> IType
{
    @emit IType(
        imm = Imm12(offset & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b010),
        rd = rd,
        opcode = Opcode(0b0000011)
    )
}

pub macro lbu(rd: Reg, offset: int, rs1: Reg) -> IType
{
    @emit IType(
        imm = Imm12(offset & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b100),
        rd = rd,
        opcode = Opcode(0b0000011)
    )
}

pub macro lhu(rd: Reg, offset: int, rs1: Reg) -> IType
{
    @emit IType(
        imm = Imm12(offset & 0xFFF),
        rs1 = rs1,
        funct3 = Funct3(0b101),
        rd = rd,
        opcode = Opcode(0b0000011)
    )
}

# =================
# S-type: stores
# =================

pub macro sb(rs2: Reg, offset: int, rs1: Reg) -> SType
{
    @emit SType(
        imm_hi = Imm7((offset >> 5) & 0b1111111),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b000), imm_lo = Imm5(offset & 0b11111),
        opcode = Opcode(0b0100011)
    )
}

pub macro sh(rs2: Reg, offset: int, rs1: Reg) -> SType
{
    @emit SType(
        imm_hi = Imm7((offset >> 5) & 0b1111111),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b001), imm_lo = Imm5(offset & 0b11111),
        opcode = Opcode(0b0100011)
    )
}

pub macro sw(rs2: Reg, offset: int, rs1: Reg) -> SType
{
    @emit SType(
        imm_hi = Imm7((offset >> 5) & 0b1111111),
        rs2 = rs2,
        rs1 = rs1,
        funct3 = Funct3(0b010), imm_lo = Imm5(offset & 0b11111),
        opcode = Opcode(0b0100011)
    )
}

# =================
# B-type: branches
# =================
# `target` is the instruction `@here` would return at the branch target —
# not a byte address, not a delta a caller computes by hand; see
# std/riscv/native.basm's own design discussion. Every RV32I instruction is
# exactly 4 bytes, so `(target - @here) * 4` is the real byte distance the
# BType format actually encodes (bit 0 is always 0 and isn't stored). The
# scrambled field order below is RV32I's, not a choice made here — see the
# BType declaration's own doc comment.

pub macro beq(rs1: Reg, rs2: Reg, target: int) -> BType
{
    const offset = (target - @here) * 4
    @emit BType(
        imm12 = Bit1((offset >> 12) & 1),
        imm10_5 = Imm6((offset >> 5) & 0b111111), rs2 = rs2, rs1 = rs1,
        funct3 = Funct3(0b000), imm4_1 = Imm4((offset >> 1) & 0b1111),
        imm11 = Bit1((offset >> 11) & 1),
        opcode = Opcode(0b1100011)
    )
}

pub macro bne(rs1: Reg, rs2: Reg, target: int) -> BType
{
    const offset = (target - @here) * 4
    @emit BType(
        imm12 = Bit1((offset >> 12) & 1),
        imm10_5 = Imm6((offset >> 5) & 0b111111), rs2 = rs2, rs1 = rs1,
        funct3 = Funct3(0b001), imm4_1 = Imm4((offset >> 1) & 0b1111),
        imm11 = Bit1((offset >> 11) & 1),
        opcode = Opcode(0b1100011)
    )
}

pub macro blt(rs1: Reg, rs2: Reg, target: int) -> BType
{
    const offset = (target - @here) * 4
    @emit BType(
        imm12 = Bit1((offset >> 12) & 1),
        imm10_5 = Imm6((offset >> 5) & 0b111111), rs2 = rs2, rs1 = rs1,
        funct3 = Funct3(0b100), imm4_1 = Imm4((offset >> 1) & 0b1111),
        imm11 = Bit1((offset >> 11) & 1),
        opcode = Opcode(0b1100011)
    )
}

pub macro bge(rs1: Reg, rs2: Reg, target: int) -> BType
{
    const offset = (target - @here) * 4
    @emit BType(
        imm12 = Bit1((offset >> 12) & 1),
        imm10_5 = Imm6((offset >> 5) & 0b111111), rs2 = rs2, rs1 = rs1,
        funct3 = Funct3(0b101), imm4_1 = Imm4((offset >> 1) & 0b1111),
        imm11 = Bit1((offset >> 11) & 1),
        opcode = Opcode(0b1100011)
    )
}

pub macro bltu(rs1: Reg, rs2: Reg, target: int) -> BType
{
    const offset = (target - @here) * 4
    @emit BType(
        imm12 = Bit1((offset >> 12) & 1),
        imm10_5 = Imm6((offset >> 5) & 0b111111), rs2 = rs2, rs1 = rs1,
        funct3 = Funct3(0b110), imm4_1 = Imm4((offset >> 1) & 0b1111),
        imm11 = Bit1((offset >> 11) & 1),
        opcode = Opcode(0b1100011)
    )
}

pub macro bgeu(rs1: Reg, rs2: Reg, target: int) -> BType
{
    const offset = (target - @here) * 4
    @emit BType(
        imm12 = Bit1((offset >> 12) & 1),
        imm10_5 = Imm6((offset >> 5) & 0b111111), rs2 = rs2, rs1 = rs1,
        funct3 = Funct3(0b111), imm4_1 = Imm4((offset >> 1) & 0b1111),
        imm11 = Bit1((offset >> 11) & 1),
        opcode = Opcode(0b1100011)
    )
}

# =================
# U-type: upper immediate
# =================

pub macro lui(
    rd: Reg,
    imm: int
) -> UType {
    @emit UType(imm = Imm20(imm & 0xFFFFF), rd = rd, opcode = Opcode(0b0110111))
}

pub macro auipc(
    rd: Reg,
    imm: int
) -> UType {
    @emit UType(imm = Imm20(imm & 0xFFFFF), rd = rd, opcode = Opcode(0b0010111))
}

# =================
# J-type: jump
# =================
# Same `target`/`@here` story as BType above, and same scrambling story as
# BType — see JType's own doc comment.

pub macro jal(rd: Reg, target: int) -> JType
{
    const offset = (target - @here) * 4
    @emit JType(
        imm20 = Bit1((offset >> 20) & 1),
        imm10_1 = Imm10((offset >> 1) & 0b1111111111),
        imm11 = Bit1((offset >> 11) & 1),
        imm19_12 = Imm8((offset >> 12) & 0b11111111), rd = rd,
        opcode = Opcode(0b1101111)
    )
}
