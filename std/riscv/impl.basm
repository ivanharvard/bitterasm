#! RISC-V RV32I: its registers, instruction formats, and every base
#! instruction, each emitted as a little-endian 32-bit word.
#!
#! Import a dialect rather than this module: `std.riscv.native` for the
#! standard assembly syntax, or `std.riscv.c_like`. Here every instruction
#! takes its operands in order, `lw rd, offset, rs1` rather than
#! `lw rd, offset(rs1)`.
#!
#! ```
#! from std.riscv.impl import *
#!
#! loop:
#!     addi a0, a0, -1
#!     bne a0, zero, loop
#! ```
#!
#! ```bytes
#! 13 05 f5 ff
#! e3 1e 05 fe
#! ```
#!
#! Immediates are plain `int`s, truncated to their field, so a negative one
#! becomes its two's-complement encoding. Branch and jump targets are labels;
#! `bitter` works out the offset once the program is laid out.

from std.binary import *
from std.bitfield import *
from std.bitter.deferred import *
from std.bitter.byte_order import *
from std.string import string_from_struct

# =================
# registers
# =================

## A register number, 0 to 31.
pub type Reg = bits<5>

@for i in 0..32 {
    ## A general-purpose register. `x0` always reads as zero.
    pub const x`i` = Reg(i)
}

# Standard ABI names, aliased to the `xN` registers they name.
## `x0`, which always reads as zero.
pub const zero = x0
## `x1`: the return address.
pub const ra = x1
## `x2`: the stack pointer.
pub const sp = x2
## `x3`: the global pointer.
pub const gp = x3
## `x4`: the thread pointer.
pub const tp = x4
## `x5`: a temporary.
pub const t0 = x5
## `x6`: a temporary.
pub const t1 = x6
## `x7`: a temporary.
pub const t2 = x7
## `x8`: saved across calls.
pub const s0 = x8
## `x8`: the frame pointer, the same register as `s0`.
pub const fp = x8
## `x9`: saved across calls.
pub const s1 = x9
## `x10`: a function argument and return value.
pub const a0 = x10
## `x11`: a function argument and return value.
pub const a1 = x11
## `x12`: a function argument.
pub const a2 = x12
## `x13`: a function argument.
pub const a3 = x13
## `x14`: a function argument.
pub const a4 = x14
## `x15`: a function argument.
pub const a5 = x15
## `x16`: a function argument.
pub const a6 = x16
## `x17`: a function argument.
pub const a7 = x17
## `x18`: saved across calls.
pub const s2 = x18
## `x19`: saved across calls.
pub const s3 = x19
## `x20`: saved across calls.
pub const s4 = x20
## `x21`: saved across calls.
pub const s5 = x21
## `x22`: saved across calls.
pub const s6 = x22
## `x23`: saved across calls.
pub const s7 = x23
## `x24`: saved across calls.
pub const s8 = x24
## `x25`: saved across calls.
pub const s9 = x25
## `x26`: saved across calls.
pub const s10 = x26
## `x27`: saved across calls.
pub const s11 = x27
## `x28`: a temporary.
pub const t3 = x28
## `x29`: a temporary.
pub const t4 = x29
## `x30`: a temporary.
pub const t5 = x30
## `x31`: a temporary.
pub const t6 = x31

# =================
# field widths
# =================
# One alias per distinct bit-field width RV32I's six instruction formats
# use. `bitter`'s packer only needs to know a value's width — it's
# expected to walk an instruction struct's fields in declaration order and
# concatenate each one's bits, with no opinion of its own about opcodes or
# formats. Every field below is deliberately its own alias, even where two
# happen to share a width (`Funct7`/`Imm7` are both `bits<7>`), so a
# format struct's field types stay self-documenting.

## The 7-bit major opcode, which picks the format and family.
pub type Opcode = bits<7>
## The 3-bit `funct3` field, which picks the instruction within a family.
pub type Funct3 = bits<3>
## The 7-bit `funct7` field of an R-type instruction.
pub type Funct7 = bits<7>

## A one-bit field.
pub type Bit1 = bits<1>
## A 4-bit immediate field.
pub type Imm4 = bits<4>
## A 5-bit immediate field.
pub type Imm5 = bits<5>
## A 6-bit immediate field.
pub type Imm6 = bits<6>
## A 7-bit immediate field.
pub type Imm7 = bits<7>
## An 8-bit immediate field.
pub type Imm8 = bits<8>
## A 10-bit immediate field.
pub type Imm10 = bits<10>
## A 12-bit immediate field.
pub type Imm12 = bits<12>
## A 20-bit immediate field.
pub type Imm20 = bits<20>

# =================
# instruction formats
# =================
# Field order is bit order, most-significant field first — bit 31 down to
# bit 0 — matching how `bitter`'s packer is meant to concatenate them.

## The R-type format: register-register operations.
pub struct RType {
    funct7: Funct7,
    rs2: Reg,
    rs1: Reg,
    funct3: Funct3,
    rd: Reg,
    opcode: Opcode,
}

## The I-type format: register-immediate operations, loads, `jalr` and
## system calls.
pub struct IType {
    imm: Imm12,
    rs1: Reg,
    funct3: Funct3,
    rd: Reg,
    opcode: Opcode,
}

## The S-type format: stores. The 12-bit offset is split around the
## registers.
pub struct SType {
    imm_hi: Imm7,
    rs2: Reg,
    rs1: Reg,
    funct3: Funct3,
    imm_lo: Imm5,
    opcode: Opcode,
}

# The immediate's bits are scrambled across the word by the ISA spec, not
# by anything here — `imm[12]`/`imm[10:5]`/`imm[4:1]`/`imm[11]` are just
# this format's real field names, in the order RV32I actually lays them
# out, so `b_type`'s own `field` calls below are the only place that
# "scrambling" is expressed at all.
#
# These four fields are `Positioned<N>`, not a bare `bits<N>` alias: every
# branch target is offset from `here()` (see `std.bitter.deferred`), which
# never resolves to a concrete Int at compile time — only `bitter` can
# finish that arithmetic once it knows where this instruction actually
# lands. `Positioned<N>` carries the field's intended width alongside the
# still-unresolved value so `bitter` knows how many bits to pack it into.
## The B-type format: conditional branches. The offset's bits are spread
## across the word the way the spec lays them out, and resolved by
## `bitter`.
pub struct BType {
    imm12: Positioned<1>,
    imm10_5: Positioned<6>,
    rs2: Reg,
    rs1: Reg,
    funct3: Funct3,
    imm4_1: Positioned<4>,
    imm11: Positioned<1>,
    opcode: Opcode,
}

## The U-type format: a 20-bit upper immediate.
pub struct UType {
    imm: Imm20,
    rd: Reg,
    opcode: Opcode,
}

## The J-type format: `jal`. Like B-type, its offset's bits are spread across
## the word, and resolved by `bitter`.
pub struct JType {
    imm20: Positioned<1>,
    imm10_1: Positioned<10>,
    imm11: Positioned<1>,
    imm19_12: Positioned<8>,
    rd: Reg,
    opcode: Opcode,
}

# =================
# major opcodes
# =================
# The 7-bit `opcode` field picks an instruction's format and family; the
# names are the RISC-V spec's own (its "RV32I Base Instruction Set" opcode
# map), so each instruction below reads the way the spec's encoding table
# lists it: family, then `funct3`/`funct7`.

const OP = 0b0110011
const OP_IMM = 0b0010011
const LOAD = 0b0000011
const STORE = 0b0100011
const BRANCH = 0b1100011
const JALR = 0b1100111
const JAL = 0b1101111
const LUI = 0b0110111
const AUIPC = 0b0010111
const SYSTEM = 0b1110011

# =================
# format constructors
# =================
# One per format, taking the fixed encoding constants first and the
# operands after in assembly order, so every instruction macro below is a
# single call. Immediates are plain `int`s truncated to their field here —
# a negative immediate becomes its two's-complement encoding, the same as
# the spec's own sign-extended reading of it.

macro r_type(
    opcode: int,
    funct3: int,
    funct7: int,
    rd: Reg,
    rs1: Reg,
    rs2: Reg
) -> LittleEndian<RType, 32> {
    @return LittleEndian<RType, 32> { value: RType(
            funct7 = Funct7(funct7),
            rs2 = rs2,
            rs1 = rs1,
            funct3 = Funct3(funct3),
            rd = rd,
            opcode = Opcode(opcode)
    ) }
}

macro i_type(
    opcode: int,
    funct3: int,
    rd: Reg,
    rs1: Reg,
    imm: int
) -> LittleEndian<IType, 32> {
    @return LittleEndian<IType, 32> { value: IType(
            imm = truncate(imm, 12),
            rs1 = rs1,
            funct3 = Funct3(funct3),
            rd = rd,
            opcode = Opcode(opcode)
    ) }
}

macro s_type(
    opcode: int,
    funct3: int,
    rs1: Reg,
    rs2: Reg,
    offset: int
) -> LittleEndian<SType, 32> {
    @return LittleEndian<SType, 32> { value: SType(
            imm_hi = field(offset, 11, 5),
            rs2 = rs2,
            rs1 = rs1,
            funct3 = Funct3(funct3),
            imm_lo = field(offset, 4, 0),
            opcode = Opcode(opcode)
    ) }
}

# `here()` is sound inside this helper: it resolves to whichever entry ends
# up holding the value, and that's the one instruction the caller emits.
macro b_type(
    opcode: int,
    funct3: int,
    rs1: Reg,
    rs2: Reg,
    target: int
) -> LittleEndian<BType, 32> {
    const offset = span(here(), target)
    @return LittleEndian<BType, 32> { value: BType(
            imm12 = field(offset, 12, 12),
            imm10_5 = field(offset, 10, 5),
            rs2 = rs2,
            rs1 = rs1,
            funct3 = Funct3(funct3),
            imm4_1 = field(offset, 4, 1),
            imm11 = field(offset, 11, 11),
            opcode = Opcode(opcode)
    ) }
}

macro u_type(
    opcode: int,
    rd: Reg,
    imm: int
) -> LittleEndian<UType, 32> {
    @return LittleEndian<UType, 32> { value: UType(
            imm = truncate(imm, 20),
            rd = rd,
            opcode = Opcode(opcode)
    ) }
}

macro j_type(
    opcode: int,
    rd: Reg,
    target: int
) -> LittleEndian<JType, 32> {
    const offset = span(here(), target)
    @return LittleEndian<JType, 32> { value: JType(
            imm20 = field(offset, 20, 20),
            imm10_1 = field(offset, 10, 1),
            imm11 = field(offset, 11, 11),
            imm19_12 = field(offset, 19, 12),
            rd = rd,
            opcode = Opcode(opcode)
    ) }
}

# =================
# R-type: register-register ops
# =================

## `rd = rs1 + rs2`.
pub macro add(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b000, 0b0000000, rd, rs1, rs2)
}

## `rd = rs1 - rs2`.
pub macro sub(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b000, 0b0100000, rd, rs1, rs2)
}

## `rd = rs1 << rs2`, shifting by the low 5 bits of `rs2`.
pub macro sll(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b001, 0b0000000, rd, rs1, rs2)
}

## `rd = 1` if `rs1 < rs2` as signed numbers, else 0.
pub macro slt(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b010, 0b0000000, rd, rs1, rs2)
}

## `rd = 1` if `rs1 < rs2` as unsigned numbers, else 0.
pub macro sltu(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b011, 0b0000000, rd, rs1, rs2)
}

## `rd = rs1 ^ rs2`.
pub macro xor(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b100, 0b0000000, rd, rs1, rs2)
}

## `rd = rs1 >> rs2`, shifting in zeros, by the low 5 bits of `rs2`.
pub macro srl(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b101, 0b0000000, rd, rs1, rs2)
}

## `rd = rs1 >> rs2`, shifting in copies of the sign bit, by the low 5 bits of
## `rs2`.
pub macro sra(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b101, 0b0100000, rd, rs1, rs2)
}

## `rd = rs1 | rs2`.
pub macro or(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b110, 0b0000000, rd, rs1, rs2)
}

## `rd = rs1 & rs2`.
pub macro and(
    rd: Reg,
    rs1: Reg,
    rs2: Reg
)
    | emits LittleEndian<RType, 32>
{
    @emit r_type(OP, 0b111, 0b0000000, rd, rs1, rs2)
}

# =================
# I-type: register-immediate ops
# =================

## `rd = rs1 + imm`, with a 12-bit signed `imm`.
pub macro addi(
    rd: Reg,
    rs1: Reg,
    imm: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b000, rd, rs1, imm)
}

## `rd = 1` if `rs1 < imm` as signed numbers, else 0.
pub macro slti(
    rd: Reg,
    rs1: Reg,
    imm: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b010, rd, rs1, imm)
}

## `rd = 1` if `rs1 < imm` as unsigned numbers, else 0. `imm` is
## sign-extended first, so `sltiu rd, rs1, 1` tests for zero.
pub macro sltiu(
    rd: Reg,
    rs1: Reg,
    imm: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b011, rd, rs1, imm)
}

## `rd = rs1 ^ imm`. `xori rd, rs1, -1` is bitwise NOT.
pub macro xori(
    rd: Reg,
    rs1: Reg,
    imm: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b100, rd, rs1, imm)
}

## `rd = rs1 | imm`.
pub macro ori(
    rd: Reg,
    rs1: Reg,
    imm: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b110, rd, rs1, imm)
}

## `rd = rs1 & imm`.
pub macro andi(
    rd: Reg,
    rs1: Reg,
    imm: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b111, rd, rs1, imm)
}

# Shift-by-immediate is still I-type, but its 12-bit `imm` field is really
# two sub-fields BitterASM has no separate names for here: a 7-bit constant
# (0000000, or 0100000 for the arithmetic-shift variant) over a 5-bit shift
# amount — computed directly rather than split into their own struct
# fields, since RType/IType/etc. are meant to match RV32I's own format
# names, not a shift-specific seventh shape the ISA spec doesn't have.

## `rd = rs1 << shamt`, for `shamt` from 0 to 31.
pub macro slli(
    rd: Reg,
    rs1: Reg,
    shamt: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b001, rd, rs1, slice(shamt, 4, 0))
}

## `rd = rs1 >> shamt`, shifting in zeros, for `shamt` from 0 to 31.
pub macro srli(
    rd: Reg,
    rs1: Reg,
    shamt: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b101, rd, rs1, slice(shamt, 4, 0))
}

## `rd = rs1 >> shamt`, shifting in copies of the sign bit, for `shamt` from 0
## to 31.
pub macro srai(
    rd: Reg,
    rs1: Reg,
    shamt: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(OP_IMM, 0b101, rd, rs1, place(0b0100000, 11, 5) | slice(shamt, 4, 0))
}

## Jumps to `rs1 + offset` (with bit 0 cleared) and puts the address of the
## next instruction in `rd`. `jalr zero, ra, 0` returns from a function.
pub macro jalr(
    rd: Reg,
    rs1: Reg,
    offset: int
)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(JALR, 0b000, rd, rs1, offset)
}

## Calls the execution environment, e.g. a Linux system call.
pub macro ecall()
    | emits LittleEndian<IType, 32>
{
    @emit i_type(SYSTEM, 0b000, x0, x0, 0)
}

## Stops in a debugger.
pub macro ebreak()
    | emits LittleEndian<IType, 32>
{
    @emit i_type(SYSTEM, 0b000, x0, x0, 1)
}

# =================
# I-type: loads
# =================
# Real assembly syntax reads the conventional `lw rd, offset(rs1)` way
# rather than default positional `lw rd, offset, rs1` — assigned separately
# in native.basm, not here, so an alternate dialect could assign its own
# spelling to these same macros without touching, or duplicating, this file.

## Loads the byte at `rs1 + offset` into `rd`, sign-extended.
pub macro lb(rd: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(LOAD, 0b000, rd, rs1, offset)
}

## Loads the 16-bit halfword at `rs1 + offset` into `rd`, sign-extended.
pub macro lh(rd: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(LOAD, 0b001, rd, rs1, offset)
}

## Loads the 32-bit word at `rs1 + offset` into `rd`.
pub macro lw(rd: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(LOAD, 0b010, rd, rs1, offset)
}

## Loads the byte at `rs1 + offset` into `rd`, zero-extended.
pub macro lbu(rd: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(LOAD, 0b100, rd, rs1, offset)
}

## Loads the 16-bit halfword at `rs1 + offset` into `rd`, zero-extended.
pub macro lhu(rd: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<IType, 32>
{
    @emit i_type(LOAD, 0b101, rd, rs1, offset)
}

# =================
# S-type: stores
# =================

## Stores the low byte of `rs2` at `rs1 + offset`.
pub macro sb(rs2: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<SType, 32>
{
    @emit s_type(STORE, 0b000, rs1, rs2, offset)
}

## Stores the low 16 bits of `rs2` at `rs1 + offset`.
pub macro sh(rs2: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<SType, 32>
{
    @emit s_type(STORE, 0b001, rs1, rs2, offset)
}

## Stores `rs2` at `rs1 + offset`.
pub macro sw(rs2: Reg, offset: int, rs1: Reg)
    | emits LittleEndian<SType, 32>
{
    @emit s_type(STORE, 0b010, rs1, rs2, offset)
}

# =================
# B-type: branches
# =================
# `target` is the instruction `here()` would return at the branch target —
# not a byte address, not a delta a caller computes by hand. `here()`
# (`std.bitter.deferred`) never resolves to a concrete Int at compile
# time — it's `bitter`, once it knows where this instruction actually
# lands, that finishes `span(here(), target)`, the real byte distance the
# BType format actually encodes (bit 0 is always 0 and isn't stored).
# `span` rather than `(target - here()) * 4`: the two agree while every
# entry is a 4-byte instruction, but `span` measures real bytes (so data
# between branch and target doesn't throw it off) and marks `target` as a
# position a linker has to translate when it reorders entries (see
# `Deferred.Pos`). The scrambled field order `b_type` builds is RV32I's, not
# a choice made here — see the BType declaration's own doc comment.

## Branches to the label `target` if `rs1 == rs2`.
pub macro beq(rs1: Reg, rs2: Reg, target: int)
    | emits LittleEndian<BType, 32>
{
    @emit b_type(BRANCH, 0b000, rs1, rs2, target)
}

## Branches to the label `target` if `rs1 != rs2`.
pub macro bne(rs1: Reg, rs2: Reg, target: int)
    | emits LittleEndian<BType, 32>
{
    @emit b_type(BRANCH, 0b001, rs1, rs2, target)
}

## Branches to the label `target` if `rs1 < rs2` as signed numbers.
pub macro blt(rs1: Reg, rs2: Reg, target: int)
    | emits LittleEndian<BType, 32>
{
    @emit b_type(BRANCH, 0b100, rs1, rs2, target)
}

## Branches to the label `target` if `rs1 >= rs2` as signed numbers.
pub macro bge(rs1: Reg, rs2: Reg, target: int)
    | emits LittleEndian<BType, 32>
{
    @emit b_type(BRANCH, 0b101, rs1, rs2, target)
}

## Branches to the label `target` if `rs1 < rs2` as unsigned numbers.
pub macro bltu(rs1: Reg, rs2: Reg, target: int)
    | emits LittleEndian<BType, 32>
{
    @emit b_type(BRANCH, 0b110, rs1, rs2, target)
}

## Branches to the label `target` if `rs1 >= rs2` as unsigned numbers.
pub macro bgeu(rs1: Reg, rs2: Reg, target: int)
    | emits LittleEndian<BType, 32>
{
    @emit b_type(BRANCH, 0b111, rs1, rs2, target)
}

# =================
# U-type: upper immediate
# =================

## `rd = imm << 12`: loads a 20-bit upper immediate.
pub macro lui(
    rd: Reg,
    imm: int
)
    | emits LittleEndian<UType, 32>
{
    @emit u_type(LUI, rd, imm)
}

## `rd = pc + (imm << 12)`: an address relative to this instruction.
pub macro auipc(
    rd: Reg,
    imm: int
)
    | emits LittleEndian<UType, 32>
{
    @emit u_type(AUIPC, rd, imm)
}

# =================
# J-type: jump
# =================
# Same `target`/`here()` story as BType above, and same scrambling story as
# BType — see JType's own doc comment.

## Jumps to the label `target` and puts the address of the next instruction
## in `rd`. `jal ra, f` calls `f`; `jal zero, l` just jumps.
pub macro jal(rd: Reg, target: int)
    | emits LittleEndian<JType, 32>
{
    @emit j_type(JAL, rd, target)
}

# =================
# pseudo-instructions
# =================
# The two every program needs, expanded the way GNU `as` expands them.

# `la`'s two halves: I-type and U-type with an immediate `bitter` works out
# later, since the distance to the label isn't known until layout.
struct ITypeLate {
    imm: Positioned<12>,
    rs1: Reg,
    funct3: Funct3,
    rd: Reg,
    opcode: Opcode,
}

struct UTypeLate {
    imm: Positioned<20>,
    rd: Reg,
    opcode: Opcode,
}

## Loads the constant `imm` into `rd`: `addi rd, zero, imm` when it fits in
## 12 signed bits, else `lui` for the upper 20 bits then, unless they're
## zero, `addi` for the rest.
pub macro li(rd: Reg, imm: int) {
    @if imm >= -2048 && imm < 2048 {
        @emit i_type(OP_IMM, 0b000, rd, x0, imm)
    } @else {
        # `addi` sign-extends its 12 bits, so round the upper part up
        # whenever bit 11 is set.
        const upper = (imm + 0x800) >> 12
        const lower = imm - (upper << 12)
        @emit u_type(LUI, rd, upper)
        @if lower != 0 {
            @emit i_type(OP_IMM, 0b000, rd, rd, lower)
        }
    }
}

## Loads the address of the label `symbol` into `rd`: `auipc` for the upper
## 20 bits of the distance, then `addi` for the rest.
pub macro la(rd: Reg, symbol: int) {
    # Both halves measure from the `auipc`, and the `addi` sits 4 bytes
    # after it. The upper part rounds up for the same reason as `li`'s.
    @emit LittleEndian<UTypeLate, 32> { value: UTypeLate(
            imm = field(add(span(here(), symbol), 0x800), 31, 12),
            rd = rd,
            opcode = Opcode(AUIPC)
    ) }
    @emit LittleEndian<ITypeLate, 32> { value: ITypeLate(
            imm = field(add(span(here(), symbol), 4), 11, 0),
            rs1 = rd,
            funct3 = Funct3(0b000),
            rd = rd,
            opcode = Opcode(OP_IMM)
    ) }
}

# =================
# data
# =================

## A byte.
pub type Byte = bits<8>

# Its own copy rather than `std.x86_64.impl`'s or `std.wasm.leb128`'s, for
# the same reason they don't share theirs.
## `N` bytes, packed by `bitter` in order.
pub struct Bytes<const N: int>
    | invariant N >= 0
{
    @for i in 0..N {
        pub __el`i`: Byte,
    }
}

# A string's `String<N>` packs its first byte most significant.
macro string_bytes<S>(source: S) -> Bytes<...> {
    const packed = string_from_struct(source)
    const n = packed.len
    @return Bytes<n> {
        @for i in 0..n {
            __el`i`: field(packed.value, 8 * (n - i) - 1, 8 * (n - 1 - i)),
        }
    }
}

## A string literal's UTF-8 bytes, with no terminator: GNU's `.ascii`.
pub macro ascii<S>(source: S) {
    @emit string_bytes(source)
}
