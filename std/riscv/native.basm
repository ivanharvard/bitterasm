#! RISC-V RV32I in its standard assembly syntax: `add a0, a1, a2`,
#! `lw a0, 8(sp)`, `beq a0, zero, done`.
#!
#! ```
#! from std.riscv.native import *
#!
#! add a0, a1, a2
#! lw a0, 8(sp)
#! ```
#!
#! ```bytes
#! 33 85 c5 00
#! 03 25 81 00
#! ```
#!
#! The instructions themselves, and their registers, come from
#! `std.riscv.impl`.

pub from .impl import *

# Every `impl.basm` macro gets its syntax assigned here explicitly, even
# where the default positional `name arg, arg, ...` already reads right, so
# this file is a complete spec of the native syntax on its own. Another
# dialect can import the same `.impl` without touching this one.

# =================
# R-type: register-register ops
# =================

syntax add(rd, rs1, rs2) = { add $rd$, $rs1$, $rs2$ }
syntax sub(rd, rs1, rs2) = { sub $rd$, $rs1$, $rs2$ }
syntax sll(rd, rs1, rs2) = { sll $rd$, $rs1$, $rs2$ }
syntax slt(rd, rs1, rs2) = { slt $rd$, $rs1$, $rs2$ }
syntax sltu(rd, rs1, rs2) = { sltu $rd$, $rs1$, $rs2$ }
syntax xor(rd, rs1, rs2) = { xor $rd$, $rs1$, $rs2$ }
syntax srl(rd, rs1, rs2) = { srl $rd$, $rs1$, $rs2$ }
syntax sra(rd, rs1, rs2) = { sra $rd$, $rs1$, $rs2$ }
syntax or(rd, rs1, rs2) = { or $rd$, $rs1$, $rs2$ }
syntax and(rd, rs1, rs2) = { and $rd$, $rs1$, $rs2$ }

# =================
# I-type: register-immediate ops
# =================

syntax addi(rd, rs1, imm) = { addi $rd$, $rs1$, $imm$ }
syntax slti(rd, rs1, imm) = { slti $rd$, $rs1$, $imm$ }
syntax sltiu(rd, rs1, imm) = { sltiu $rd$, $rs1$, $imm$ }
syntax xori(rd, rs1, imm) = { xori $rd$, $rs1$, $imm$ }
syntax ori(rd, rs1, imm) = { ori $rd$, $rs1$, $imm$ }
syntax andi(rd, rs1, imm) = { andi $rd$, $rs1$, $imm$ }

syntax slli(rd, rs1, shamt) = { slli $rd$, $rs1$, $shamt$ }
syntax srli(rd, rs1, shamt) = { srli $rd$, $rs1$, $shamt$ }
syntax srai(rd, rs1, shamt) = { srai $rd$, $rs1$, $shamt$ }

syntax jalr(rd, rs1, offset) = { jalr $rd$, $rs1$, $offset$ }

syntax ecall() = { ecall }
syntax ebreak() = { ebreak }

# =================
# I-type: loads
# =================
# `offset(rs1)` addressing genuinely isn't expressible as default
# positional syntax — the one shape here that isn't just a restatement of
# it.

syntax lb(rd, offset, rs1) = { lb $rd$, $offset$($rs1$) }
syntax lh(rd, offset, rs1) = { lh $rd$, $offset$($rs1$) }
syntax lw(rd, offset, rs1) = { lw $rd$, $offset$($rs1$) }
syntax lbu(rd, offset, rs1) = { lbu $rd$, $offset$($rs1$) }
syntax lhu(rd, offset, rs1) = { lhu $rd$, $offset$($rs1$) }

# =================
# S-type: stores
# =================

syntax sb(rs2, offset, rs1) = { sb $rs2$, $offset$($rs1$) }
syntax sh(rs2, offset, rs1) = { sh $rs2$, $offset$($rs1$) }
syntax sw(rs2, offset, rs1) = { sw $rs2$, $offset$($rs1$) }

# =================
# B-type: branches
# =================

syntax beq(rs1, rs2, target) = { beq $rs1$, $rs2$, $target$ }
syntax bne(rs1, rs2, target) = { bne $rs1$, $rs2$, $target$ }
syntax blt(rs1, rs2, target) = { blt $rs1$, $rs2$, $target$ }
syntax bge(rs1, rs2, target) = { bge $rs1$, $rs2$, $target$ }
syntax bltu(rs1, rs2, target) = { bltu $rs1$, $rs2$, $target$ }
syntax bgeu(rs1, rs2, target) = { bgeu $rs1$, $rs2$, $target$ }

# =================
# U-type: upper immediate
# =================

syntax lui(rd, imm) = { lui $rd$, $imm$ }
syntax auipc(rd, imm) = { auipc $rd$, $imm$ }

# =================
# J-type: jump
# =================

syntax jal(rd, target) = { jal $rd$, $target$ }

# =================
# pseudo-instructions and data
# =================
# GNU's `.ascii` loses its dot: a statement can't start with one.

syntax li(rd, imm) = { li $rd$, $imm$ }
syntax la(rd, symbol) = { la $rd$, $symbol$ }
syntax ascii(source) = { ascii $source$ }
