#! `Array<T, N>`: `N` values of type `T`, and ways to build new arrays from
#! old ones. Every value is immutable, so each operation returns a new array.
#!
#! ```
#! from std.array import *
#!
#! macro show_all<const N: int>(values: Array<int, N>) {
#!     @for v in values {
#!         @emit v
#!     }
#! }
#!
#! macro double(x: int) -> int {
#!     @return x * 2
#! }
#!
#! const values = Array<int, 3>(10, 20, 30)
#!
#! show_all reversed(values)
#! show_all mapped(appended(values, 40), double)
#! ```
#!
#! ```emits
#! 30 20 10
#! 20 40 60 80
#! ```
#!
#! An array is built from its elements in order, as above, or by an `@for`
#! inside a brace construction, which names them `__el0`, `__el1`, ....
#! `@for v in values` visits the elements in order.

from std.enumerated import Enumerated

## `N` values of type `T`, in order.
pub struct Array<T, const N: int>
    | invariant N >= 0
{
    @for i in 0..N {
        pub __el`i`: T,
    }

    ## The number of elements, `N`. `skip`, so `@for` doesn't visit it.
    pub skip len: int = N,
}

macro oob_check<T>(
    arr: Array<T, ...>,
    index: int
) {
    @assert index >= 0, "Arrays do not support negative indices"
    @assert index < arr.len, "Index is greater than Array length"
}

## The element at `index`, counting from 0. An index outside the array is
## a compile error.
pub macro get<T>(arr: Array<T, ...>, index: int) -> T
    | before oob_check(arr, index)
{
    @return arr.__el`index`
}

## A copy of `arr` with the element at `index` replaced by `value`.
pub macro updated<T>(
    arr: Array<T, ...>,
    index: int,
    value: T
) -> Array<T, ...>
    | before oob_check(arr, index)
{
    @return Array<T, arr.len> {
        @for i in 0..arr.len {
            @if i == index {
                __el`i`: value,
            } @else {
                __el`i`: arr.__el`i`,
            }
        }
    }
}

## A copy of `arr` in reverse order.
pub macro reversed<T>(arr: Array<T, ...>) -> Array<T, ...>
{
    @return Array<T, arr.len> {
        @for i in 0..arr.len {
            __el`i`: arr.__el`arr.len - 1 - i`,
        }
    }
}

## A copy of `arr` without its last element. `arr` can't be empty.
pub macro popped<T, const N: int>(arr: Array<T, N>) -> Array<T, N-1>
{
    @assert N > 0
    const new_len = N - 1
    @return Array<T, new_len>{
        @for i in 0..new_len {
            __el`i`: arr.__el`i`,
        }
    }
}

## The first element. `arr` can't be empty.
pub macro first<T>(arr: Array<T, ...>) -> T
{
    @assert arr.len > 0
    @return get(arr, 0)
}

## The last element. `arr` can't be empty.
pub macro last<T>(arr: Array<T, ...>) -> T
{
    @assert arr.len > 0
    @return get(arr, arr.len - 1)
}

## A new array holding `f` of each element, in order. `f` is any macro
## that takes a `T` and returns a `U`.
pub macro mapped<T, U>(arr: Array<T, ...>, f: macro(T) -> U) -> Array<U, ...>
{
    @return Array<U, arr.len> {
        @for i in 0..arr.len {
            __el`i`: f(arr.__el`i`),
        }
    }
}

## An `Array<int, N>` of a struct's `__el0`..`__el{len - 1}` fields, such
## as a `String`'s characters or a `Range`'s values.
pub macro array_from_struct<S>(source: S)
{
    const len = source.len
    @return Array<int, len> {
        @for i in 0..len {
            __el`i`: source.__el`i`,
        }
    }
}

## Each element paired with its index, as an `Enumerated<T>`.
pub macro enumerate<T>(arr: Array<T, ...>) -> Array<Enumerated<T>, ...>
{
    @return Array<Enumerated<T>, arr.len> {
        @for i in 0..arr.len {
            __el`i`: Enumerated<T> { index: i, value: arr.__el`i` },
        }
    }
}

## A copy of `arr` with `value` added at the end.
pub macro appended<T, const N: int>(
    arr: Array<T, N>,
    value: T
) -> Array<T, N + 1>
{
    @return Array<T, N + 1> {
        @for i in 0..N {
            __el`i`: arr.__el`i`,
        }
        __el`N`: value,
    }
}

## Iterates over `arr`'s elements in order until it finds the first instance of
## `value`, then returns its index. If `value` isn't found, returns `-1`. If
## `arr` is empty, errors at compile time.
pub macro find<T>(arr: Array<T, ...>, value: T) -> int
{
    @assert arr.len > 0, "find() can't be called on an empty array"
    @for i in 0..arr.len {
        @if arr.__el`i` == value {
            @return i
        }
    }
    @return -1
}

## Returns `1` if `value` is in `arr`, otherwise returns `0` or errors at
## compile time if `arr` is empty.
pub macro contains<T>(arr: Array<T, ...>, value: T) -> int {
    @return find(arr, value) != -1
}

## A copy of `arr` with the first instance of `value` removed. If `value`
## isn't found, returns a copy of `arr`.
pub macro remove<T, const N: int>(
    arr: Array<T, N>,
    value: T
) -> Array<T, ...> {
    @if N == 0 {
        @return arr
    }

    const idx = find(arr, value)
    @if idx == -1 {
        @return arr
    }
    @return Array<T, N - 1> {
        @for i in 0..N {
            @if i < idx {
                __el`i`: arr.__el`i`,
            }
            @if i > idx {
                __el`i - 1`: arr.__el`i`,
            }
        }
    }
}

## `N` copies of `value`. Name both types: `filled<int, 4>(0)`.
pub macro filled<T, const N: int>(value: T) -> Array<T, N> {
    @return Array<T, N> {
        @for i in 0..N {
            __el`i`: value,
        }
    }
}

## `a`'s elements, then `b`'s.
pub macro concatenated<T, const M: int, const N: int>(
    a: Array<T, M>,
    b: Array<T, N>
) -> Array<T, M + N> {
    @return Array<T, M + N> {
        @for i in 0..M {
            __el`i`: a.__el`i`,
        }
        @for i in 0..N {
            __el`M + i`: b.__el`i`,
        }
    }
}

## The sum of `arr`'s elements, 0 for an empty array.
pub macro sum(arr: Array<int, ...>) -> int {
    @return @fold total = 0 @for value in arr {
        @next total + value
    }
}

## `1` if `f` of any element is nonzero, otherwise `0`.
pub macro any<T>(arr: Array<T, ...>, f: macro(T) -> int) -> int {
    @for value in arr {
        @if f(value) {
            @return 1
        }
    }
    @return 0
}

## `1` if `f` of every element is nonzero, otherwise `0`. An empty array
## gives `1`.
pub macro all<T>(arr: Array<T, ...>, f: macro(T) -> int) -> int {
    @for value in arr {
        @if !f(value) {
            @return 0
        }
    }
    @return 1
}

## A copy of `arr` with its elements in increasing order. Equal elements
## keep their order.
pub macro sorted(arr: Array<int, ...>) -> Array<int, ...> {
    @return Array<int, arr.len> {
        @for i in 0..arr.len {
            __el`rank(arr, i)`: arr.__el`i`,
        }
    }
}

# Where element `i` goes in `sorted(arr)`: how many elements come before
# it, either smaller or equal and earlier.
macro rank(arr: Array<int, ...>, i: int) -> int {
    const value = arr.__el`i`
    @return @fold before = 0 @for j in 0..arr.len {
        const other = arr.__el`j`
        @if other < value || (other == value && j < i) {
            @next before + 1
        }
        @next before
    }
}
