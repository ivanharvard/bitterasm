pub struct Array<T, const N: int>
    | invariant N >= 0
{
    @for i in 0..N {
        pub __el`i`: T,
    }

    pub skip len: int = N,
}

macro oob_check<T>(
    arr: Array<T, ...>,
    index: int
) -> int {
    @assert index >= 0, "Arrays do not support negative indices"
    @assert index < arr.len, "Index is greater than Array length"
}

pub macro get<T>(arr: Array<T, ...>, index: int) -> T
    | syntax { $arr$[$index$] }
    | before oob_check(arr, index)
{
    @return arr.__el`index`
}

# Since all basm objects are immutable, we need to return a new array with the
# updated value
pub macro updated<T>(
    arr: Array<T, ...>,
    index: int,
    value: T
) -> Array<T, ...>
    | before oob_check(arr, index)
{
    @return Array<T, arr.len> {
        @for i in 0..arr.len {
            @if i == index {
                __el`i`: value,
            } @else {
                __el`i`: arr.__el`i`,
            }
        }
    }
}

pub macro reversed<T>(arr: Array<T, ...>) -> Array<T, ...>
{
    @return Array<T, arr.len> {
        @for i in 0..arr.len {
            __el`i`: arr.__el`arr.len - 1 - i`,
        }
    }
}

pub macro popped(arr: Array<T, N>) -> Array<T, N-1>
{
    @assert N > 0
    const new_len = N - 1
    @return Array<T, new_len>{
        @for i in 0..new_len {
            __el`i`: arr.__el`i`,
        }
    }
}

pub macro first(arr: Array<T, N>) -> T
{
    @assert N > 0
    @return get(arr, 0)
}

pub macro last(arr: Array<T, N>) -> T
{
    @assert N > 0
    @return get(arr, N-1)
}

pub macro mapped<T, U, F: Fn(T) -> U>(arr: Array<T, ...>, f: F) -> Array<U, ...>
{
    @return Array<U, arr.len> {
        @for i in 0..arr.len {
            __el`i`: f(arr.__el`i`),
        }
    }
}
