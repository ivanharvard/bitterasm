# =========================
# Binary-based transformations
# =========================



pub macro title(s: U8String) -> U8String {
    @return U8String {
        chars: Array<u8, len(s.chars)> {
            @for i in 0..len(s.chars) {
                @if i == 0 {
                    @if s.chars[i] >= 'A' && s.chars[i] <= 'Z' {
                        __el`i`: s.chars[i] - 'a',
                    } @else {
                        __el`i`: s.chars[i],
                    }
                } @else {
                    __el`i`: s.chars[i],
                }
            }
        }
    }
}
