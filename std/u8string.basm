# =========================
# Binary-based transformations
# =========================

# Uppercases the first byte if it's a lowercase ASCII letter, leaving
# everything else unchanged -- operates on `String`'s packed
# `value`/`len` representation (there's no `.chars` array; see `byte_at`
# above), the same way `to_array` does.
macro titlecase_byte(
    byte: uint8_t,
    index: int
) -> uint8_t {
    @if index == 0 && byte >= 'a' && byte <= 'z' {
        @return byte - ('a' - 'A')
    }

    @return byte
}

macro shift_for_byte(
    index: int,
    len: int,
    endian: Endian
) -> int {
    @if endian == Endian.Little {
        @return index * 8
    }

    @return (len - index - 1) * 8
}

macro titlecase_value(
    value: int,
    len: int,
    index: int,
    endian: Endian
) -> int {
    @if index == len {
        @return 0
    }

    const byte = byte_at(value, len, index, endian)
    const cased = titlecase_byte(byte, index)
    const shift = shift_for_byte(index, len, endian)

    @return (cased << shift) | titlecase_value(value, len, index + 1, endian)
}

pub macro title(
    s: String,
    endian: Endian
) -> String {
    @return String(
        value = titlecase_value(s.value, s.len, 0, endian),
        len = s.len
    )
}
