from std.array import *
from std.ctypes import uint8_t
from std.binary import Endian

pub struct String<const len: int>
    | invariant len >= 0
{
    value: int,
    len: int
}

# ========================
# Binary-based Interpretations
# ========================

macro byte_at(
    value: int,
    len: int,
    index: int,
    endian: Endian
) -> uint8_t {
    @if endian == Endian.Little {
        @return (value >> (index * 8)) & 0xFF
    } @else {
        @return (value >> ((len - index - 1) * 8)) & 0xFF
    }
}

macro validate_asciistring(
    value: int,
    len: int,
    endian: Endian
) -> int {
    @assert len >= 0
    @assert value >= 0
    @assert value < (1 << (BITS_PER_BYTE * len))

    @for i in 0..len {
        @assert byte_at(value, len, i, endian) < 0x80
    }

    @return 1
}

pub struct AsciiString<const len: int, const endian: Endian>
    | invariant validate_asciistring(value, len, endian)
{
    value: int,
    len: int,
    endian: Endian
}

pub macro to_array(s: AsciiString) -> Array {
    @return Array<uint8_t, s.len> {
        @for i in 0..(s.len) {
            __el`i`: byte_at(s.value, s.len, i, s.endian)
        }
    }
}

