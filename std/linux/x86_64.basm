# =================
# standard streams
# =================

## Standard input.
pub const STDIN_FILENO = 0
## Standard output.
pub const STDOUT_FILENO = 1
## Standard error.
pub const STDERR_FILENO = 2

# =================
# errno values
# =================
# A failed system call returns minus one of these.

## Operation not permitted.
pub const EPERM = 1
## No such file or directory.
pub const ENOENT = 2
## No such process.
pub const ESRCH = 3
## Interrupted system call.
pub const EINTR = 4
## I/O error.
pub const EIO = 5
## No such device or address.
pub const ENXIO = 6
## Argument list too long.
pub const E2BIG = 7
## Exec format error.
pub const ENOEXEC = 8
## Bad file number.
pub const EBADF = 9
## No child processes.
pub const ECHILD = 10
## Try again.
pub const EAGAIN = 11
## Out of memory.
pub const ENOMEM = 12
## Permission denied.
pub const EACCES = 13
## Bad address.
pub const EFAULT = 14
## Block device required.
pub const ENOTBLK = 15
## Device or resource busy.
pub const EBUSY = 16
## File exists.
pub const EEXIST = 17
## Cross-device link.
pub const EXDEV = 18
## No such device.
pub const ENODEV = 19
## Not a directory.
pub const ENOTDIR = 20
## Is a directory.
pub const EISDIR = 21
## Invalid argument.
pub const EINVAL = 22
## File table overflow.
pub const ENFILE = 23
## Too many open files.
pub const EMFILE = 24
## Not a typewriter.
pub const ENOTTY = 25
## Text file busy.
pub const ETXTBSY = 26
## File too large.
pub const EFBIG = 27
## No space left on device.
pub const ENOSPC = 28
## Illegal seek.
pub const ESPIPE = 29
## Read-only file system.
pub const EROFS = 30
## Too many links.
pub const EMLINK = 31
## Broken pipe.
pub const EPIPE = 32
## Math argument out of domain of func.
pub const EDOM = 33
## Math result not representable.
pub const ERANGE = 34
## Resource deadlock would occur.
pub const EDEADLK = 35
## File name too long.
pub const ENAMETOOLONG = 36
## No record locks available.
pub const ENOLCK = 37
## Invalid system call number.
pub const ENOSYS = 38
## Directory not empty.
pub const ENOTEMPTY = 39
## Too many symbolic links encountered.
pub const ELOOP = 40
## Another name for `EAGAIN`.
pub const EWOULDBLOCK = 11
## No message of desired type.
pub const ENOMSG = 42
## Identifier removed.
pub const EIDRM = 43
## Channel number out of range.
pub const ECHRNG = 44
## Level 2 not synchronized.
pub const EL2NSYNC = 45
## Level 3 halted.
pub const EL3HLT = 46
## Level 3 reset.
pub const EL3RST = 47
## Link number out of range.
pub const ELNRNG = 48
## Protocol driver not attached.
pub const EUNATCH = 49
## No CSI structure available.
pub const ENOCSI = 50
## Level 2 halted.
pub const EL2HLT = 51
## Invalid exchange.
pub const EBADE = 52
## Invalid request descriptor.
pub const EBADR = 53
## Exchange full.
pub const EXFULL = 54
## No anode.
pub const ENOANO = 55
## Invalid request code.
pub const EBADRQC = 56
## Invalid slot.
pub const EBADSLT = 57
## Another name for `EDEADLK`.
pub const EDEADLOCK = 35
## Bad font file format.
pub const EBFONT = 59
## Device not a stream.
pub const ENOSTR = 60
## No data available.
pub const ENODATA = 61
## Timer expired.
pub const ETIME = 62
## Out of streams resources.
pub const ENOSR = 63
## Machine is not on the network.
pub const ENONET = 64
## Package not installed.
pub const ENOPKG = 65
## Object is remote.
pub const EREMOTE = 66
## Link has been severed.
pub const ENOLINK = 67
## Advertise error.
pub const EADV = 68
## Srmount error.
pub const ESRMNT = 69
## Communication error on send.
pub const ECOMM = 70
## Protocol error.
pub const EPROTO = 71
## Multihop attempted.
pub const EMULTIHOP = 72
## RFS specific error.
pub const EDOTDOT = 73
## Not a data message.
pub const EBADMSG = 74
## Value too large for defined data type.
pub const EOVERFLOW = 75
## Name not unique on network.
pub const ENOTUNIQ = 76
## File descriptor in bad state.
pub const EBADFD = 77
## Remote address changed.
pub const EREMCHG = 78
## Can not access a needed shared library.
pub const ELIBACC = 79
## Accessing a corrupted shared library.
pub const ELIBBAD = 80
## .lib section in a.out corrupted.
pub const ELIBSCN = 81
## Attempting to link in too many shared libraries.
pub const ELIBMAX = 82
## Cannot exec a shared library directly.
pub const ELIBEXEC = 83
## Illegal byte sequence.
pub const EILSEQ = 84
## Interrupted system call should be restarted.
pub const ERESTART = 85
## Streams pipe error.
pub const ESTRPIPE = 86
## Too many users.
pub const EUSERS = 87
## Socket operation on non-socket.
pub const ENOTSOCK = 88
## Destination address required.
pub const EDESTADDRREQ = 89
## Message too long.
pub const EMSGSIZE = 90
## Protocol wrong type for socket.
pub const EPROTOTYPE = 91
## Protocol not available.
pub const ENOPROTOOPT = 92
## Protocol not supported.
pub const EPROTONOSUPPORT = 93
## Socket type not supported.
pub const ESOCKTNOSUPPORT = 94
## Operation not supported on transport endpoint.
pub const EOPNOTSUPP = 95
## Protocol family not supported.
pub const EPFNOSUPPORT = 96
## Address family not supported by protocol.
pub const EAFNOSUPPORT = 97
## Address already in use.
pub const EADDRINUSE = 98
## Cannot assign requested address.
pub const EADDRNOTAVAIL = 99
## Network is down.
pub const ENETDOWN = 100
## Network is unreachable.
pub const ENETUNREACH = 101
## Network dropped connection because of reset.
pub const ENETRESET = 102
## Software caused connection abort.
pub const ECONNABORTED = 103
## Connection reset by peer.
pub const ECONNRESET = 104
## No buffer space available.
pub const ENOBUFS = 105
## Transport endpoint is already connected.
pub const EISCONN = 106
## Transport endpoint is not connected.
pub const ENOTCONN = 107
## Cannot send after transport endpoint shutdown.
pub const ESHUTDOWN = 108
## Too many references: cannot splice.
pub const ETOOMANYREFS = 109
## Connection timed out.
pub const ETIMEDOUT = 110
## Connection refused.
pub const ECONNREFUSED = 111
## Host is down.
pub const EHOSTDOWN = 112
## No route to host.
pub const EHOSTUNREACH = 113
## Operation already in progress.
pub const EALREADY = 114
## Operation now in progress.
pub const EINPROGRESS = 115
## Stale file handle.
pub const ESTALE = 116
## Structure needs cleaning.
pub const EUCLEAN = 117
## Not a XENIX named type file.
pub const ENOTNAM = 118
## No XENIX semaphores available.
pub const ENAVAIL = 119
## Is a named type file.
pub const EISNAM = 120
## Remote I/O error.
pub const EREMOTEIO = 121
## Quota exceeded.
pub const EDQUOT = 122
## No medium found.
pub const ENOMEDIUM = 123
## Wrong medium type.
pub const EMEDIUMTYPE = 124
## Operation Canceled.
pub const ECANCELED = 125
## Required key not available.
pub const ENOKEY = 126
## Key has expired.
pub const EKEYEXPIRED = 127
## Key has been revoked.
pub const EKEYREVOKED = 128
## Key was rejected by service.
pub const EKEYREJECTED = 129
## Owner died.
pub const EOWNERDEAD = 130
## State not recoverable.
pub const ENOTRECOVERABLE = 131
## Operation not possible due to RF-kill.
pub const ERFKILL = 132
## Memory page has hardware error.
pub const EHWPOISON = 133

# =================
# open flags
# =================
# For `open` and `openat`. Exactly one of the first three is set.

## The bits that say how a file is opened: `O_RDONLY`, `O_WRONLY` or
## `O_RDWR`.
pub const O_ACCMODE = 3
## Open for reading only.
pub const O_RDONLY = 0
## Open for writing only.
pub const O_WRONLY = 1
## Open for reading and writing.
pub const O_RDWR = 2
## Create the file if it doesn't exist, with the mode in the next argument.
pub const O_CREAT = 64
## With `O_CREAT`, fail with `EEXIST` if the file exists.
pub const O_EXCL = 128
## Don't make a terminal this opens the controlling terminal.
pub const O_NOCTTY = 256
## Truncate an existing file to length 0.
pub const O_TRUNC = 512
## Write at the end of the file every time.
pub const O_APPEND = 0x400
## Don't block: an operation that would fails with `EAGAIN`.
pub const O_NONBLOCK = 0x800
## Each write waits until its data reaches the disk.
pub const O_DSYNC = 0x1000
## Bypass the page cache where possible.
pub const O_DIRECT = 0x4000
## Allow files larger than 2 GiB; always on for 64-bit programs.
pub const O_LARGEFILE = 0x8000
## Fail with `ENOTDIR` unless the path is a directory.
pub const O_DIRECTORY = 0x10000
## Fail with `ELOOP` if the path's last part is a symbolic link.
pub const O_NOFOLLOW = 0x20000
## Don't update the file's access time.
pub const O_NOATIME = 0x40000
## Close the descriptor when the program calls `execve`.
pub const O_CLOEXEC = 0x80000
## Each write waits until its data and metadata reach the disk.
pub const O_SYNC = 0x101000
## Open only a reference to the path, for `*at` calls and `fstat`.
pub const O_PATH = 0x200000
## Create an unnamed file in the directory given.
pub const O_TMPFILE = 0x410000
## Another name for `O_NONBLOCK`.
pub const O_NDELAY = 0x800

# =================
# *at flags
# =================
# For `openat`, `fstatat`, `unlinkat` and the other `*at` calls.

## As a directory descriptor: the current working directory.
pub const AT_FDCWD = -100
## Don't follow a symbolic link at the end of the path.
pub const AT_SYMLINK_NOFOLLOW = 256
## For `faccessat`: check with the effective user and group IDs.
pub const AT_EACCESS = 512
## For `unlinkat`: remove a directory, like `rmdir`.
pub const AT_REMOVEDIR = 512
## For `linkat`: follow a symbolic link at the end of the path.
pub const AT_SYMLINK_FOLLOW = 0x400
## Don't trigger an automount at the end of the path.
pub const AT_NO_AUTOMOUNT = 0x800
## With an empty path, act on the directory descriptor itself.
pub const AT_EMPTY_PATH = 0x1000
## For `statx`: the bits that say how to sync with a remote filesystem.
pub const AT_STATX_SYNC_TYPE = 0x6000
## For `statx`: sync the way `stat` does.
pub const AT_STATX_SYNC_AS_STAT = 0
## For `statx`: sync the attributes with the server.
pub const AT_STATX_FORCE_SYNC = 0x2000
## For `statx`: don't sync the attributes with the server.
pub const AT_STATX_DONT_SYNC = 0x4000
## Apply to the whole subtree.
pub const AT_RECURSIVE = 0x8000

# =================
# lseek
# =================
# Where `lseek`'s offset counts from.

## From the start of the file.
pub const SEEK_SET = 0
## From the current position.
pub const SEEK_CUR = 1
## From the end of the file.
pub const SEEK_END = 2

# =================
# memory mapping
# =================
# For `mmap`, `mprotect` and `munmap`.

## Page can be read.
pub const PROT_READ = 1
## Page can be written.
pub const PROT_WRITE = 2
## Page can be executed.
pub const PROT_EXEC = 4
## The pages may be used for atomic operations.
pub const PROT_SEM = 8
## The pages can't be accessed.
pub const PROT_NONE = 0
## For `mprotect`: extend the change down a stack that grows down.
pub const PROT_GROWSDOWN = 0x1000000
## For `mprotect`: extend the change up a mapping that grows up.
pub const PROT_GROWSUP = 0x2000000
## The bits that say how a mapping is shared.
pub const MAP_TYPE = 15
## Map at exactly the address given, replacing what's there.
pub const MAP_FIXED = 16
## Map zeroed memory, not a file; the descriptor is ignored.
pub const MAP_ANONYMOUS = 32
## Fault the pages in now.
pub const MAP_POPULATE = 0x8000
## With `MAP_POPULATE`, don't block on reading the file.
pub const MAP_NONBLOCK = 0x10000
## The mapping is for a stack.
pub const MAP_STACK = 0x20000
## Map with huge pages.
pub const MAP_HUGETLB = 0x40000
## Writes to a mapped persistent-memory file reach it synchronously.
pub const MAP_SYNC = 0x80000
## Map at exactly the address given, failing with `EEXIST` if something is
## there.
pub const MAP_FIXED_NOREPLACE = 0x100000
## Don't zero anonymous pages, where the kernel allows it.
pub const MAP_UNINITIALIZED = 0x4000000
## No effect: mapping a file is the default.
pub const MAP_FILE = 0
## Share changes with other mappings of the same file.
pub const MAP_SHARED = 1
## Keep changes private, copied on write.
pub const MAP_PRIVATE = 2
## `MAP_SHARED`, failing on flags the kernel doesn't know.
pub const MAP_SHARED_VALIDATE = 3
## Map in the first 2 GiB of the address space.
pub const MAP_32BIT = 64

# =================
# signals
# =================
# For `kill`, `rt_sigaction` and the other signal calls.

## Hangup: the terminal closed, or reload configuration.
pub const SIGHUP = 1
## Interrupt from the keyboard, Ctrl-C.
pub const SIGINT = 2
## Quit from the keyboard, Ctrl-\.
pub const SIGQUIT = 3
## Illegal instruction.
pub const SIGILL = 4
## Breakpoint or trace trap.
pub const SIGTRAP = 5
## Abort, as from `abort()`.
pub const SIGABRT = 6
## Another name for `SIGABRT`.
pub const SIGIOT = 6
## Bus error: a bad memory access, like past the end of a mapped file.
pub const SIGBUS = 7
## Arithmetic error, like division by zero.
pub const SIGFPE = 8
## Kill; can't be caught or ignored.
pub const SIGKILL = 9
## User-defined signal 1.
pub const SIGUSR1 = 10
## Invalid memory reference.
pub const SIGSEGV = 11
## User-defined signal 2.
pub const SIGUSR2 = 12
## Write to a pipe with no reader.
pub const SIGPIPE = 13
## Timer from `alarm`.
pub const SIGALRM = 14
## Termination request.
pub const SIGTERM = 15
## Coprocessor stack fault; unused.
pub const SIGSTKFLT = 16
## A child process stopped or exited.
pub const SIGCHLD = 17
## Continue if stopped.
pub const SIGCONT = 18
## Stop; can't be caught or ignored.
pub const SIGSTOP = 19
## Stop from the terminal, Ctrl-Z.
pub const SIGTSTP = 20
## Terminal input for a background process.
pub const SIGTTIN = 21
## Terminal output from a background process.
pub const SIGTTOU = 22
## Urgent data on a socket.
pub const SIGURG = 23
## CPU time limit exceeded.
pub const SIGXCPU = 24
## File size limit exceeded.
pub const SIGXFSZ = 25
## Virtual timer from `setitimer`.
pub const SIGVTALRM = 26
## Profiling timer.
pub const SIGPROF = 27
## The terminal window changed size.
pub const SIGWINCH = 28
## I/O is possible on a descriptor.
pub const SIGIO = 29
## Another name for `SIGIO`.
pub const SIGPOLL = 29
## Power failure.
pub const SIGPWR = 30
## Bad system call.
pub const SIGSYS = 31

# =================
# clocks
# =================
# For `clock_gettime` and `clock_nanosleep`.

## Wall-clock time, which can jump when it's set.
pub const CLOCK_REALTIME = 0
## Time since some fixed point, never set, not counting suspend.
pub const CLOCK_MONOTONIC = 1
## CPU time used by the process.
pub const CLOCK_PROCESS_CPUTIME_ID = 2
## CPU time used by the thread.
pub const CLOCK_THREAD_CPUTIME_ID = 3
## `CLOCK_MONOTONIC`, without NTP's adjustments.
pub const CLOCK_MONOTONIC_RAW = 4
## `CLOCK_REALTIME`, faster to read and less precise.
pub const CLOCK_REALTIME_COARSE = 5
## `CLOCK_MONOTONIC`, faster to read and less precise.
pub const CLOCK_MONOTONIC_COARSE = 6
## `CLOCK_MONOTONIC`, counting time suspended.
pub const CLOCK_BOOTTIME = 7
## `CLOCK_REALTIME`, waking the system from suspend.
pub const CLOCK_REALTIME_ALARM = 8
## `CLOCK_BOOTTIME`, waking the system from suspend.
pub const CLOCK_BOOTTIME_ALARM = 9
## International Atomic Time.
pub const CLOCK_TAI = 11
