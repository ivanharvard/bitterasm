#! WebAssembly instructions: a representative subset of control, variable
#! and `i32` instructions, each emitted as its binary encoding.
#!
#! ```
#! from std.wasm.impl import *
#!
#! local_get(0)
#! i32_const(-1)
#! i32_add
#! end
#! ```
#!
#! ```bytes
#! 20 00 41 7f 6a 0b
#! ```
#!
#! WebAssembly's dotted names aren't identifiers here, so `i32.const` is
#! `i32_const` and `local.get` is `local_get`. Names that are keywords in
#! other languages end in `_`: `if_`, `else_`, `return_`. `std.wasm.module`
#! builds the module around them.

from std.wasm.leb128 import *

# A syntax layer offering the dotted spelling (the way `std/riscv/native.basm`
# sits over `std/riscv/impl.basm`) is future work.

# =================
# value types
# =================

## The `i32` value type.
pub const I32: Byte = Byte(0x7F)
## The `i64` value type.
pub const I64: Byte = Byte(0x7E)
## The `f32` value type.
pub const F32: Byte = Byte(0x7D)
## The `f64` value type.
pub const F64: Byte = Byte(0x7C)

## The block type of a `block`, `loop` or `if_` that produces no value. A
## value type such as `I32` means it produces one value of that type.
# Type-index block types (the multi-value proposal) aren't covered.
pub const EMPTY_BLOCKTYPE: Byte = Byte(0x40)

# =================
# opcode/immediate framing
# =================
# Every WASM instruction is a one-byte opcode, optionally followed by a
# handful of immediate bytes (LEB128-encoded indices/counts/constants, or a
# single blocktype byte for `block`/`loop`/`if`). A bare opcode with no
# immediate is just a `Byte`, `@emit`'d directly — `bitter` already knows
# how to pack a bare `bits<N>` leaf. An opcode *with* an immediate is this
# one small struct; `bitter`'s generic "walk any other struct's fields in
# declaration order" fallback concatenates `opcode` then `imm` with no help
# needed, exactly the way it concatenates `std/riscv`'s multi-field format
# structs.
## An opcode followed by `N` bytes of immediates.
pub struct OpWithImm<const N: int> {
    opcode: Byte,
    imm: Bytes<N>,
}

macro op_with_uleb128(
    opcode: int,
    value: int
) -> OpWithImm<...> {
    const n = uleb128_length(value)
    @return OpWithImm<n> { opcode: Byte(opcode), imm: uleb128(value) }
}

macro op_with_sleb128(
    opcode: int,
    value: int
) -> OpWithImm<...> {
    const n = sleb128_length(value)
    @return OpWithImm<n> { opcode: Byte(opcode), imm: sleb128(value) }
}

macro op_with_byte(
    opcode: int,
    immediate: Byte
) -> OpWithImm<1> {
    @return OpWithImm<1> {
        opcode: Byte(opcode),
        imm: Bytes<1> { __el0: immediate }
    }
}

# =================
# control instructions
# =================
# `br`/`br_if` take a plain relative nesting-depth `int` from the caller —
# real WASM binary semantics exactly (`br 0` targets the innermost
# enclosing `block`/`loop`), computed by the caller rather than resolved
# automatically from a named block. `std.bitter.deferred`'s `here()`/
# `Positioned<N>` machinery (what `std/riscv`'s branch instructions use)
# has no role here: that machinery computes address deltas from a flat
# emission-position count, which has no meaning for a depth-based branch —
# so this file, like `std/pdp10/impl.basm`'s `jrst`/`jumpa`, never imports
# `std.bitter.deferred`.

## Traps immediately.
pub macro unreachable()
    | emits Byte
{
    @emit Byte(0x00)
}

## Does nothing.
pub macro nop()
    | emits Byte
{
    @emit Byte(0x01)
}

## Starts a block. `br` to it jumps to its `end`. `blocktype` is
## `EMPTY_BLOCKTYPE` or the type of the value it produces.
pub macro block(blocktype: Byte)
    | emits OpWithImm<1>
{
    @emit op_with_byte(0x02, blocktype)
}

## Starts a loop. `br` to it jumps back to its start.
pub macro loop(blocktype: Byte)
    | emits OpWithImm<1>
{
    @emit op_with_byte(0x03, blocktype)
}

## Starts an `if`: runs what follows if the `i32` it pops isn't zero, and
## the `else_` part (if any) otherwise.
pub macro if_(blocktype: Byte)
    | emits OpWithImm<1>
{
    @emit op_with_byte(0x04, blocktype)
}

## Starts the `else` part of an `if_`.
pub macro else_()
    | emits Byte
{
    @emit Byte(0x05)
}

## Ends a `block`, `loop`, `if_` or function body.
pub macro end()
    | emits Byte
{
    @emit Byte(0x0B)
}

## Branches to the enclosing block `depth` levels out: `br(0)` is the
## innermost.
pub macro br(depth: int)
    | emits OpWithImm<...>
{
    @emit op_with_uleb128(0x0C, depth)
}

## Pops an `i32`, and does `br(depth)` if it isn't zero.
pub macro br_if(depth: int)
    | emits OpWithImm<...>
{
    @emit op_with_uleb128(0x0D, depth)
}

## Returns from the current function.
pub macro return_()
    | emits Byte
{
    @emit Byte(0x0F)
}

## Calls function number `func_index`.
pub macro call(func_index: int)
    | emits OpWithImm<...>
{
    @emit op_with_uleb128(0x10, func_index)
}

# =================
# parametric instructions
# =================

## Pops a value and discards it.
pub macro drop()
    | emits Byte
{
    @emit Byte(0x1A)
}

# =================
# variable instructions
# =================

## Pushes local variable number `index`.
pub macro local_get(index: int)
    | emits OpWithImm<...>
{
    @emit op_with_uleb128(0x20, index)
}

## Pops a value into local variable number `index`.
pub macro local_set(index: int)
    | emits OpWithImm<...>
{
    @emit op_with_uleb128(0x21, index)
}

## Stores the top of the stack in local variable number `index`, without
## popping it.
pub macro local_tee(index: int)
    | emits OpWithImm<...>
{
    @emit op_with_uleb128(0x22, index)
}

# =================
# memory instructions
# =================

## A load or store: its opcode, then its memory operand, the alignment as a
## power of two and the offset added to the address.
pub struct MemOp<const N: int> {
    opcode: Byte,
    align: Byte,
    offset: Bytes<N>,
}

# `align` is a LEB128 number too, but one byte holds any alignment a load or
# store can have.
macro mem_op(
    opcode: int,
    offset: int,
    align: int
) -> MemOp<...> {
    @assert align >= 0 && align < 0x80, "align is a power of two, 0 to 127"
    const n = uleb128_length(offset)
    @return MemOp<n> {
        opcode: Byte(opcode),
        align: Byte(align),
        offset: uleb128(offset),
    }
}

## Pops an address and pushes the `i32` at `address + offset`. `align` is
## the alignment the address is promised to have, as a power of two:
## 2, a 4-byte boundary, by default.
pub macro i32_load(offset: int = 0, align: int = 2)
    | emits MemOp<...>
{
    @emit mem_op(0x28, offset, align)
}

## Pops an `i32` value, then an address, and stores the value at
## `address + offset`. `align` means what it does for `i32_load`.
pub macro i32_store(offset: int = 0, align: int = 2)
    | emits MemOp<...>
{
    @emit mem_op(0x36, offset, align)
}

# =================
# numeric instructions
# =================
# A representative subset (constants, comparison, arithmetic on `i32`), not
# full ISA coverage — `std/` is meant to grow, per the README's own
# "Status" section, the same way `std/pdp10` shipped with a representative
# subset rather than every DEC PRM opcode.

## Pushes `value` as an `i32`.
pub macro i32_const(value: int)
    | emits OpWithImm<...>
{
    @emit op_with_sleb128(0x41, value)
}

## Pops an `i32` and pushes 1 if it's zero, else 0.
pub macro i32_eqz()
    | emits Byte
{
    @emit Byte(0x45)
}

## Pops two `i32`s and pushes 1 if the first is less than the second as
## signed numbers, else 0.
pub macro i32_lt_s()
    | emits Byte
{
    @emit Byte(0x48)
}

## Pops two `i32`s and pushes their sum.
pub macro i32_add()
    | emits Byte
{
    @emit Byte(0x6A)
}

## Pops two `i32`s and pushes the first minus the second.
pub macro i32_sub()
    | emits Byte
{
    @emit Byte(0x6B)
}

## Pops two `i32`s and pushes their product.
pub macro i32_mul()
    | emits Byte
{
    @emit Byte(0x6C)
}
