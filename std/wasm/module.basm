#! The WebAssembly module container: the header, sections, and their
#! length prefixes. A section starts with its id byte and its length in
#! bytes, which `deferred_uleb128` fills in once `bitter` knows it.
#!
#! ```
#! from std.wasm.module import *
#! from std.wasm.impl import *
#! from std.bitter.deferred import *
#!
#! header
#!
#! # The type section: one function type, () -> i32.
#! byte(0x01)
#! deferred_uleb128 span(types_start, types_end), 1
#! types_start:
#! byte(0x01)
#! func_type_0_to_1(I32)
#! types_end:
#! ```
#!
#! ```bytes
#! 00 61 73 6d 01 00 00 00
#! 01 05 01 60 00 01 7f
#! ```
#!
#! `section_header` writes a section's id and size, and the helpers below
#! write the entries of the type, import, function, memory, export, code
#! and data sections: enough for a WASI program like
#! `examples/wasm/hello.basm`. The table, global, start and element sections
#! have no helpers yet.

from std.binary import *
from std.bitter.deferred import *
from std.bitfield import *
from std.wasm.leb128 import *
from std.wasm.impl import i32_const, end
from std.string import string_from_struct

# =================
# encoding a not-yet-known length
# =================
# A WASM section (and, inside the Code section, each function body) is
# prefixed with the ULEB128-encoded byte length of whatever follows it —
# not knowable until everything after it has been emitted. `span(start,
# end)` (`std.bitter.deferred`) gives a `Deferred` value for exactly that,
# resolved by `bitter` once it knows both labels' positions and every
# entry's own packed width. This section builds that `Deferred` into
# actual LEB128 bytes, the same way `std/riscv`'s `beq` builds its
# PC-relative offset into `BType`'s scattered immediate fields: by
# splitting a `Deferred` value with `shr`/`band` rather than plain `int`
# arithmetic, and wrapping each resulting piece in `Positioned<N>` so
# `bitter` resolves it once the real value is known.
#
# Unlike `uleb128`/`sleb128` in `std/wasm/leb128.basm`, the byte count
# can't be computed from the value here — the value isn't known until
# `bitter` resolves it, only the *caller* knows how many bytes to budget
# for. So every group here always carries its continuation bit as a plain,
# immediately-known `bool` (fixed by `index`/`n` alone), never folded into
# the deferred payload itself — there's no `Deferred`-valued bitwise OR in
# `std.bitter.deferred` (nor any need for one), so continuation and payload
# are two separate fields of one byte rather than one OR'd-together value.
# WASM's binary format explicitly allows this non-minimal, fixed-width
# LEB128 form (padded with zero groups up to a value's max byte count for
# its bit width), which is exactly what a fixed `n` produces whenever the
# real length turns out smaller than `n` bytes can hold.
## One byte of a LEB128 value `bitter` works out later.
pub struct Leb128Group {
    ## Set on every byte but the last.
    pub continuation: bool,
    ## Seven bits of the value.
    pub payload: Positioned<7>,
}

macro deferred_leb128_group(
    value: Deferred,
    index: int,
    length: int
) -> Leb128Group {
    const payload = slice(value, 7 * index + 6, 7 * index)
    @if index < length - 1 {
        @return Leb128Group(
            continuation = true,
            payload = Positioned<7> { value: payload }
        )
    } @else {
        @return Leb128Group(
            continuation = false,
            payload = Positioned<7> { value: payload }
        )
    }
}

## `N` bytes of a LEB128 value `bitter` works out later.
pub struct DeferredLeb128<const N: int>
    | invariant N >= 0
{
    @for i in 0..N {
        pub __el`i`: Leb128Group,
    }
}

## `value`, usually `span(start, end)`, as unsigned LEB128 in exactly `n`
## bytes, padded if it turns out to need fewer. `n` has to be enough for
## the final value: one byte holds up to 127.
pub macro deferred_uleb128(
    value: Deferred,
    n: int
)
    | emits DeferredLeb128<...>
{
    @emit DeferredLeb128<n> {
        @for i in 0..n {
            __el`i`: deferred_leb128_group(value, i, n),
        }
    }
}

# =================
# module structure
# =================
# A representative MVP subset of the module container format — enough to
# build one exported, zero-argument function — not full coverage of every
# section kind (Table/Memory/Global/Start/Element/Data aren't covered
# here). `std/` is meant to grow, per the README's own "Status" section.

## One byte, such as a section id.
pub macro byte(value: int)
    | emits Byte
{
    @emit Byte(value)
}

## The 8 bytes every module starts with: `\0asm`, then version 1.
pub macro header()
    | emits Bytes<8>
{
    @emit Bytes<8> {
        __el0: Byte(0x00),
        __el1: Byte(0x61),
        __el2: Byte(0x73),
        __el3: Byte(0x6D),
        __el4: Byte(0x01),
        __el5: Byte(0x00),
        __el6: Byte(0x00),
        __el7: Byte(0x00),
    }
}

## A function type with no parameters and one result of type `result`,
## such as `I32`.
pub macro func_type_0_to_1(result: Byte)
    | emits Bytes<4>
{
    @emit Bytes<4> {
        __el0: Byte(0x60),
        __el1: Byte(0x00),
        __el2: Byte(0x01),
        __el3: result,
    }
}

# =================
# sections
# =================

## The id of the custom section.
pub const CUSTOM_SECTION = 0
## The id of the type section: function signatures.
pub const TYPE_SECTION = 1
## The id of the import section.
pub const IMPORT_SECTION = 2
## The id of the function section: each defined function's type.
pub const FUNCTION_SECTION = 3
## The id of the table section.
pub const TABLE_SECTION = 4
## The id of the memory section.
pub const MEMORY_SECTION = 5
## The id of the global section.
pub const GLOBAL_SECTION = 6
## The id of the export section.
pub const EXPORT_SECTION = 7
## The id of the start section.
pub const START_SECTION = 8
## The id of the element section.
pub const ELEMENT_SECTION = 9
## The id of the code section: each defined function's body.
pub const CODE_SECTION = 10
## The id of the data section.
pub const DATA_SECTION = 11

## `value`, which can't be negative, as unsigned LEB128: the spec's `u32`,
## which every count and index is.
pub macro u32(value: int)
    | emits Bytes<...>
{
    @emit uleb128(value)
}

## The number of bytes from label `start` to label `end`, as unsigned
## LEB128: the size before a section or a function body. It always takes 5
## bytes, since it isn't known until layout, and 5 hold any size.
pub macro size(start: int, end: int)
    | emits DeferredLeb128<5>
{
    deferred_uleb128 span(start, end), 5
}

## A section's id, such as `TYPE_SECTION`, and its size. Put the label
## `start` right after it and `end` after the section's contents.
pub macro section_header(
    id: int,
    start: int,
    end: int
) {
    byte id
    size start, end
}

# =================
# types
# =================

# A result type: a count, then that many value types.
macro value_types(a: Byte) -> Bytes<2> {
    @return Bytes<2> { __el0: Byte(1), __el1: a }
}

## A function's parameter types: `params(I32, I32)`. Up to four.
pub macro params() -> Bytes<1> {
    @return Bytes<1> { __el0: Byte(0) }
}

pub macro params(a: Byte) -> Bytes<2> {
    @return value_types(a)
}

pub macro params(
    a: Byte,
    b: Byte
) -> Bytes<3> {
    @return Bytes<3> { __el0: Byte(2), __el1: a, __el2: b }
}

pub macro params(
    a: Byte,
    b: Byte,
    c: Byte
) -> Bytes<4> {
    @return Bytes<4> { __el0: Byte(3), __el1: a, __el2: b, __el3: c }
}

pub macro params(
    a: Byte,
    b: Byte,
    c: Byte,
    d: Byte
) -> Bytes<5> {
    @return Bytes<5> { __el0: Byte(4), __el1: a, __el2: b, __el3: c, __el4: d }
}

## A function's result types: `results(I32)`, or `results()` for none.
pub macro results() -> Bytes<1> {
    @return Bytes<1> { __el0: Byte(0) }
}

pub macro results(a: Byte) -> Bytes<2> {
    @return value_types(a)
}

## A function type: `func_type params(I32), results(I32)`.
pub macro func_type(
    parameters: Bytes<...>,
    returned: Bytes<...>
) {
    byte 0x60
    @emit parameters
    @emit returned
}

# =================
# imports, memories and exports
# =================

# A string's `String<N>` packs its first byte most significant.
macro string_bytes<S>(source: S) -> Bytes<...> {
    const packed = string_from_struct(source)
    const n = packed.len
    @return Bytes<n> {
        @for i in 0..n {
            __el`i`: field(packed.value, 8 * (n - i) - 1, 8 * (n - 1 - i)),
        }
    }
}

## A name: its length in bytes, then its UTF-8 bytes.
pub macro name<S>(source: S) {
    const bytes = string_bytes(source)
    u32 string_from_struct(source).len
    @emit bytes
}

## Imports the function `item_name` from the module `module_name`, with the
## type numbered `type_index` in the type section. Imported functions are
## numbered before the module's own.
pub macro import_func<S, T>(
    module_name: S,
    item_name: T,
    type_index: int
) {
    name module_name
    name item_name
    byte 0x00
    u32 type_index
}

## A memory of `pages` 64 KiB pages, with no maximum.
pub macro memory(pages: int) {
    byte 0x00
    u32 pages
}

## Exports function number `index` as `export_name`.
pub macro export_func<S>(
    export_name: S,
    index: int
) {
    name export_name
    byte 0x00
    u32 index
}

## Exports memory number `index` as `export_name`.
pub macro export_memory<S>(
    export_name: S,
    index: int
) {
    name export_name
    byte 0x02
    u32 index
}

# =================
# data
# =================

## A data segment that copies the string `source`'s UTF-8 bytes into
## memory 0 at address `offset` when the module starts.
pub macro data_segment<S>(
    offset: int,
    source: S
) {
    byte 0x00
    i32_const offset
    end
    name source
}
