# Layout directives `bitter` gives meaning to when it packs an image.
#
# `align n` emits an `Align<n>` entry: as many zero bytes as it takes for
# the next entry to start at a multiple of `n` bytes from the start of the
# image. How many that is depends on everything before it, so `bitter` works
# it out while laying the image out; `span` across one counts the padding.
#
# Only meaningful as a whole emitted entry, not as a field inside another
# struct.

pub struct Align<const n: int>
    | invariant n > 0
{
}

pub macro align(n: int) {
    @emit Align<n> {}
}

# `pad_image n` pads the finished image with zeros to a multiple of `n`
# bytes, wherever it's written — for a file format whose size must be
# rounded up (PE rounds its sections to 512 bytes), since a header written
# at the start of the program can't emit anything at the end of it. It
# takes no space where it appears, so `span` and `std.bitter.link`'s
# `image_end` measure the image without this padding.
pub struct PadImage<const n: int>
    | invariant n > 0
{
}

pub macro pad_image(n: int) {
    @emit PadImage<n> {}
}
