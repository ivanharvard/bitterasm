#! Byte order for `bitter`. Its default is most significant byte first;
#! `LittleEndian` asks for the reverse.
#!
#! ```
#! from std.binary import bits
#! from std.bitter.byte_order import LittleEndian
#!
#! macro dw_le(value: int) {
#!     @emit LittleEndian<bits<16>, 16> { value: value as bits<16> }
#! }
#!
#! dw_le 0x1234
#! ```
#!
#! ```bytes
#! 34 12
#! ```

# `bitter` recognizes `LittleEndian` by name, the way it recognizes `bits`
# and `Positioned`, and reverses the bytes once every field inside, including
# any still-`Deferred` ones, has been resolved and concatenated.
#
# There's no such wrapper for "big-endian," and no evaluator-level flag that
# picks a byte order for a whole compile: `bitter`'s default, with nothing
# wrapping a value, is to concatenate bits most-significant-first and never
# reorder them — the only byte order a target that isn't byte-addressable at
# all (a word machine, say) can be said to have. `LittleEndian<T, width>` is
# how a byte-addressable architecture package opts itself into the other
# one; an architecture that never reaches for it never states an opinion
# `bitter` has to know about.
## `value`, packed with its least significant byte first. `width` is
## `value`'s width in bits, and must be a multiple of 8.
pub struct LittleEndian<T, const width: int> {
    ## The value to reverse, such as a whole instruction.
    pub value: T,
}
