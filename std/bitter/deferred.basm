pub enum Op { Sub, Mul, Shr, Band, Span }

pub struct BinOp {
    pub op: Op,
    pub left: Deferred,
    pub right: Deferred,
}

pub enum Deferred {
    Leaf: int,
    Here,
    Node: BinOp,
}

pub macro here() -> Deferred {
    @return Deferred.Here
}

# ---------------------------------------------------------------
# sub
# ---------------------------------------------------------------

pub macro sub(a: int, b: int) -> int {
    @return a - b
}

pub macro sub(a: Deferred, b: int) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Sub, left = a, right = Deferred.Leaf(b)))
}

pub macro sub(a: int, b: Deferred) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Sub, left = Deferred.Leaf(a), right = b))
}

pub macro sub(a: Deferred, b: Deferred) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Sub, left = a, right = b))
}

# ---------------------------------------------------------------
# mul
# ---------------------------------------------------------------

pub macro mul(a: int, b: int) -> int {
    @return a * b
}

pub macro mul(a: Deferred, b: int) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Mul, left = a, right = Deferred.Leaf(b)))
}

pub macro mul(a: int, b: Deferred) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Mul, left = Deferred.Leaf(a), right = b))
}

pub macro mul(a: Deferred, b: Deferred) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Mul, left = a, right = b))
}

# ---------------------------------------------------------------
# shr — only (int,int) and (Deferred,int): nothing in std/riscv ever shifts
# by a not-yet-resolved amount. (int,Deferred)/(Deferred,Deferred) are a
# trivial, symmetric addition later if something needs them.
# ---------------------------------------------------------------

pub macro shr(a: int, b: int) -> int {
    @return a >> b
}

pub macro shr(a: Deferred, b: int) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Shr, left = a, right = Deferred.Leaf(b)))
}

# ---------------------------------------------------------------
# band — same reduced shape as shr, same reasoning.
# ---------------------------------------------------------------

pub macro band(a: int, b: int) -> int {
    @return a & b
}

pub macro band(a: Deferred, b: int) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Band, left = a, right = Deferred.Leaf(b)))
}

# ---------------------------------------------------------------
# span — unlike `sub`/`mul`/`shr`/`band`, this isn't arithmetic on two
# already-resolved integers: it asks whatever evaluator resolves it "how
# much lies between these two points in the emitted-value stream," in
# whatever unit that evaluator measures such things (bytes, for `bitter`).
# It's this file's vocabulary for that relationship, the same way `here()`
# is its vocabulary for "which position am I" — neither says anything
# about bytes or addresses itself, only the evaluator that resolves them
# does.
#
# Both endpoints are plain `int`s, not `Deferred`, and in particular not
# `here()`: a bare `Deferred.Here` carries no identity of its own — it
# always resolves to "whichever entry ends up containing me," regardless
# of where in the source the `here()` call that produced it was written.
# Two separate `here()` calls later combined into one *other* entry (e.g.
# a length-prefix emitted before the span it measures) would therefore
# both resolve to that other entry's own position, not to the positions
# where each was captured — useless for marking two distinct points.
# Labels don't have this problem: `name:` already resolves to a fixed,
# nameable position via bitterasm's own two-pass resolver, independent of
# where its value later gets used, exactly what two distinct endpoints
# here need. So `span`'s callers are expected to pass two label names
# (already plain `int`s by the time a macro body sees them, exactly like
# `std/riscv`'s branch instructions take a label as their `target: int`),
# not `here()`.
pub macro span(start: int, end: int) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Span, left = Deferred.Leaf(start), right = Deferred.Leaf(end)))
}

# Pairs a `Deferred` value with the bit width it's meant to occupy once
# resolved — the one piece of information `bits<N>` normally carries that a
# bare `Deferred` value can't (a `Deferred.Leaf(5)` alone doesn't say how
# many bits "5" should occupy; the field it's constructed into does).
# `bitter` recognizes this struct by name exactly the way it already
# recognizes `bits`.
pub struct Positioned<const width: int> {
    pub value: Deferred,
}
