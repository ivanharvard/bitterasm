pub enum Op { Sub, Mul, Shr, Band, Span }

pub struct BinOp {
    pub op: Op,
    pub left: Deferred,
    pub right: Deferred,
}

pub enum Deferred {
    Leaf: int,
    Here,
    Node: BinOp,
}

pub macro here() -> Deferred {
    @return Deferred.Here
}

# ---------------------------------------------------------------
# sub
# ---------------------------------------------------------------

pub macro sub(
    a: int,
    b: int
) -> int {
    @return a - b
}

pub macro sub(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Sub,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

pub macro sub(
    a: int,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Sub,
            left = Deferred.Leaf(a),
            right = b
        ))
}

pub macro sub(
    a: Deferred,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Sub, left = a, right = b))
}

# ---------------------------------------------------------------
# mul
# ---------------------------------------------------------------

pub macro mul(
    a: int,
    b: int
) -> int {
    @return a * b
}

pub macro mul(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Mul,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

pub macro mul(
    a: int,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Mul,
            left = Deferred.Leaf(a),
            right = b
        ))
}

pub macro mul(
    a: Deferred,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Mul, left = a, right = b))
}

# ---------------------------------------------------------------
# shr — only (int,int) and (Deferred,int): nothing in std/riscv ever shifts
# by a not-yet-resolved amount. (int,Deferred)/(Deferred,Deferred) are a
# trivial, symmetric addition later if something needs them.
# ---------------------------------------------------------------

pub macro shr(
    a: int,
    b: int
) -> int {
    @return a >> b
}

pub macro shr(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Shr,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

# ---------------------------------------------------------------
# band — same reduced shape as shr, same reasoning.
# ---------------------------------------------------------------

pub macro band(
    a: int,
    b: int
) -> int {
    @return a & b
}

pub macro band(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Band,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

# ---------------------------------------------------------------
# span — unlike `sub`/`mul`/`shr`/`band`, this isn't arithmetic on two
# already-resolved integers: it asks whatever evaluator resolves it "how
# much lies between these two points in the emitted-value stream," in
# whatever unit that evaluator measures such things (bytes, for `bitter`).
# It's this file's vocabulary for that relationship, the same way `here()`
# is its vocabulary for "which position am I" — neither says anything
# about bytes or addresses itself, only the evaluator that resolves them
# does. Signed and bidirectional: `end` may come before `start` in the
# emitted-value stream (a negative result), not just after or at it —
# unlike a plain byte count, this can express a relative branch's target
# lying in either direction, over instructions whose packed width isn't
# known until `bitter` resolves it (see `std/x86_64/impl.basm`'s
# `jmp`/`jcc`/`call`, which lean on exactly this for `rel32`).
#
# Either endpoint may be `here()`: `(int, int)`, `(Deferred, int)`, and
# `(int, Deferred)` are all provided below. Not `(Deferred, Deferred)` —
# nothing needs it yet, a trivial symmetric addition later if something
# does, the same reduced-overload-set precedent `shr`/`band` below already
# set.
#
# `here()` is only a *sound* endpoint here when it's read back from *this
# same* entry's own fields — a bare `Deferred.Here` carries no identity of
# its own, it always resolves to "whichever entry ends up containing the
# value being resolved," not "the entry where `here()` was textually
# called." `span(here(), target)` inside one instruction's own
# `Positioned<N>` field is sound because that field and the `here()` call
# are always the same entry. Capturing a `here()` in one entry's fields and
# reading it back from a *different* entry (e.g. a length-prefix emitted
# before the body whose `here()` it tried to capture) would silently
# resolve to the wrong entry's position instead of erroring — always pass
# `here()` straight into the same instruction's own `span` call, never
# store it and reuse it from elsewhere. Labels don't have this problem:
# `name:` already resolves to a fixed, nameable position via bitterasm's
# own two-pass resolver, independent of where its value later gets used —
# exactly what `span`'s non-`here()` endpoints ordinarily are (a label
# name, already a plain `int` by the time a macro body sees it, exactly
# like `std/riscv`'s branch instructions take one as their `target: int`).
pub macro span(
    start: int,
    end: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Span,
            left = Deferred.Leaf(start),
            right = Deferred.Leaf(end)
        ))
}

pub macro span(
    start: Deferred,
    end: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Span,
            left = start,
            right = Deferred.Leaf(end)
        ))
}

pub macro span(
    start: int,
    end: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Span,
            left = Deferred.Leaf(start),
            right = end
        ))
}

# Pairs a `Deferred` value with the bit width it's meant to occupy once
# resolved — the one piece of information `bits<N>` normally carries that a
# bare `Deferred` value can't (a `Deferred.Leaf(5)` alone doesn't say how
# many bits "5" should occupy; the field it's constructed into does).
# `bitter` recognizes this struct by name exactly the way it already
# recognizes `bits`.
pub struct Positioned<const width: int> {
    pub value: Deferred,
}
