#! Values that depend on where things end up, such as the distance to a
#! branch target. They're built as `Deferred` expressions that `bitter`
#! resolves once the image is laid out, and given a width by
#! `Positioned<N>`.
#!
#! ```
#! from std.binary import bits
#! from std.bitter.deferred import *
#!
#! macro db(value: int) {
#!     @emit value as bits<8>
#! }
#!
#! macro offset_to(target: int) {
#!     @emit Positioned<8> { value: span(here(), target) }
#! }
#!
#! offset_to end
#! db 0xAA
#! db 0xBB
#! end:
#! ```
#!
#! ```bytes
#! 03 aa bb
#! ```
#!
#! `add`, `sub`, `mul`, `shr` and `band` work on `int`s, giving an `int`,
#! and on `Deferred`s, giving a `Deferred`, so an encoder is written the
#! same way whether its operand is known yet or not.

## The operation of a `BinOp`.
pub enum Op {
    ## `left + right`.
    Add,
    ## `left - right`.
    Sub,
    ## `left * right`.
    Mul,
    ## `left >> right`.
    Shr,
    ## `left & right`.
    Band,
    ## Bytes from position `left` to position `right`, as in `span`.
    Span,
}

## An operation on two `Deferred` values.
pub struct BinOp {
    ## What to do.
    pub op: Op,
    ## The first operand.
    pub left: Deferred,
    ## The second operand.
    pub right: Deferred,
}

# `Pos` is an entry position (a label's value) rather than a plain number:
# the same integer as a `Leaf`, but marked so a linker that reorders entries
# (`bitter build` grouping same-named sections, or placing a second input
# after the first) knows to translate it from the emitting file's own entry
# numbering into the merged one. `span`'s `int` endpoints are always
# positions, so it wraps them in `Pos`, never `Leaf`.
## A value `bitter` works out after laying out the image. Build one with
## `here`, `span` and the arithmetic macros rather than by hand.
pub enum Deferred {
    ## A plain number.
    Leaf: int,
    ## A position, such as a label, as a number of entries.
    Pos: int,
    ## The position of the value being packed.
    Here,
    ## An operation on two `Deferred` values.
    Node: BinOp,
}

## The position of the value being packed. Use it only inside the `span`
## of the value being emitted: stored and used by a different value, it
## refers to that value's position instead.
pub macro here() -> Deferred {
    @return Deferred.Here
}

## `a + b`: an `int` when both are `int`s, else a `Deferred`.
pub macro add(
    a: int,
    b: int
) -> int {
    @return a + b
}

pub macro add(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Add,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

pub macro add(
    a: int,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Add,
            left = Deferred.Leaf(a),
            right = b
        ))
}

pub macro add(
    a: Deferred,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Add, left = a, right = b))
}

## `a - b`: an `int` when both are `int`s, else a `Deferred`.
pub macro sub(
    a: int,
    b: int
) -> int {
    @return a - b
}

pub macro sub(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Sub,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

pub macro sub(
    a: int,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Sub,
            left = Deferred.Leaf(a),
            right = b
        ))
}

pub macro sub(
    a: Deferred,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Sub, left = a, right = b))
}

## `a * b`: an `int` when both are `int`s, else a `Deferred`.
pub macro mul(
    a: int,
    b: int
) -> int {
    @return a * b
}

pub macro mul(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Mul,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

pub macro mul(
    a: int,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Mul,
            left = Deferred.Leaf(a),
            right = b
        ))
}

pub macro mul(
    a: Deferred,
    b: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(op = Op.Mul, left = a, right = b))
}

# Only (int, int) and (Deferred, int): nothing in std shifts by a
# not-yet-resolved amount. The other two are a trivial addition if needed.
## `a >> b`: an `int` when `a` is an `int`, else a `Deferred`.
pub macro shr(
    a: int,
    b: int
) -> int {
    @return a >> b
}

pub macro shr(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Shr,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

# The same reduced set of overloads as `shr`, for the same reason.
## `a & b`: an `int` when `a` is an `int`, else a `Deferred`.
pub macro band(
    a: int,
    b: int
) -> int {
    @return a & b
}

pub macro band(
    a: Deferred,
    b: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Band,
            left = a,
            right = Deferred.Leaf(b)
        ))
}

# ---------------------------------------------------------------
# span — unlike `sub`/`mul`/`shr`/`band`, this isn't arithmetic on two
# already-resolved integers: it asks whatever evaluator resolves it "how
# much lies between these two points in the emitted-value stream," in
# whatever unit that evaluator measures such things (bytes, for `bitter`).
# It's this file's vocabulary for that relationship, the same way `here()`
# is its vocabulary for "which position am I" — neither says anything
# about bytes or addresses itself, only the evaluator that resolves them
# does. Signed and bidirectional: `end` may come before `start` in the
# emitted-value stream (a negative result), not just after or at it —
# unlike a plain byte count, this can express a relative branch's target
# lying in either direction, over instructions whose packed width isn't
# known until `bitter` resolves it (see `std/x86_64/impl.basm`'s
# `jmp`/`jcc`/`call`, which lean on exactly this for `rel32`).
#
# Either endpoint may be `here()`: `(int, int)`, `(Deferred, int)`, and
# `(int, Deferred)` are all provided below. Not `(Deferred, Deferred)` —
# nothing needs it yet, a trivial symmetric addition later if something
# does, the same reduced-overload-set precedent `shr`/`band` below already
# set.
#
# `here()` is only a *sound* endpoint here when it's read back from *this
# same* entry's own fields — a bare `Deferred.Here` carries no identity of
# its own, it always resolves to "whichever entry ends up containing the
# value being resolved," not "the entry where `here()` was textually
# called." `span(here(), target)` inside one instruction's own
# `Positioned<N>` field is sound because that field and the `here()` call
# are always the same entry. Capturing a `here()` in one entry's fields and
# reading it back from a *different* entry (e.g. a length-prefix emitted
# before the body whose `here()` it tried to capture) would silently
# resolve to the wrong entry's position instead of erroring — always pass
# `here()` straight into the same instruction's own `span` call, never
# store it and reuse it from elsewhere. Labels don't have this problem:
# `name:` already resolves to a fixed, nameable position via bitterasm's
# own two-pass resolver, independent of where its value later gets used —
# exactly what `span`'s non-`here()` endpoints ordinarily are (a label
# name, already a plain `int` by the time a macro body sees it, exactly
# like `std/riscv`'s branch instructions take one as their `target: int`).
## The number of bytes from position `start` to position `end`, negative
## if `end` comes first. Either may be `here()`. Labels are positions, so
## `span(here(), target)` is a relative branch offset.
pub macro span(
    start: int,
    end: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Span,
            left = Deferred.Pos(start),
            right = Deferred.Pos(end)
        ))
}

pub macro span(
    start: Deferred,
    end: int
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Span,
            left = start,
            right = Deferred.Pos(end)
        ))
}

pub macro span(
    start: int,
    end: Deferred
) -> Deferred {
    @return Deferred.Node(BinOp(
            op = Op.Span,
            left = Deferred.Pos(start),
            right = end
        ))
}

## A `Deferred` value, packed into `width` bits once `bitter` resolves it:
## what `bits<N>` is to an `int`. A negative value is packed in two's
## complement.
# `bitter` recognizes this struct by name, the way it recognizes `bits`.
pub struct Positioned<const width: int> {
    ## The value to resolve.
    pub value: Deferred,
}
