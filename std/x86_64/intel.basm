# Real, conventional Intel-syntax x86-64 assembly for `impl.basm`'s instructions
# —
# assigned here, explicitly, rather than left to whichever ones happen to
# already
# read right under default positional `name arg, arg, ...` syntax, mirroring
# `std/riscv/native.basm`'s own stated convention (see its header comment) for
# the
# same reason: this file is then a complete, standalone spec of "native" syntax
# on
# its own.
#
# =================
# operand size: picked by register spelling
# =================
# Every mnemonic below drops `impl.basm`'s explicit trailing `w: int` parameter
# and reads it off the register family instead: `rax`/`r8`/... (`Reg`) mean
# `w = 1` (64-bit), `eax`/`r8d`/... (`Reg32`) mean `w = 0` (32-bit) — see the
# "32-bit operand size" section near the end. The explicit `w` form stays
# reachable too — this file only *adds* syntax sugar, it never removes
# `impl.basm`'s own default positional syntax — e.g. `mov rax, rbx, 0`; every
# mnemonic below also gets an explicit "restatement" pattern for its own real,
# full-arity signature (see the next section) for exactly this reason.
#
# =================
# why almost every mnemonic needs *two* patterns, not one
# =================
# Once a name has *any* registered syntax, default positional syntax for that
# name
# is gone entirely — not just for the shape the new syntax covers, but for every
# other arity too (confirmed empirically: an early draft that dropped `w` via a
# reduced-arity wrapper, with no restatement alongside it, made every one of
# this
# file's *own* delegating calls to the real 3-argument `impl.basm` macro a parse
# error, since `mov`, once claimed, no longer accepts a bare `mov $a$, $b$, $c$`
# unless something says it still can). So for every mnemonic that gets a
# reduced,
# `w`-dropping pattern below, this file also registers a second pattern that
# just
# restates the real underlying macro's own full argument list verbatim
# (`syntax mov(a, b, c) = { mov $a$, $b$, $c$ }`) — not because it changes
# anything (it's byte-for-byte what default syntax already produced), but
# because
# it has to be there for *any* 3-argument `mov`/`add`/etc. call to keep parsing
# at
# all, including this file's own internal ones. A standalone restatement has to
# be
# declared *before* the reduced-arity macro it accompanies in this file — also
# confirmed empirically (declaring it after produced a spurious parse error on
# the
# very call it was meant to keep working) — so every section below follows that
# order.
#
# =================
# memory operands: real `[...]` syntax, and why it needs a compiler fix first
# =================
# `[base]`, `[base+disp]`, `[base+index*scale+disp]`, and `[rip+disp]` all
# *look*
# like they should be four independent patterns, but a `syntax` capture is an
# unbounded, generic expression parse, stopped only by the next literal token in
# its *own* pattern — so `[$base$+$disp$]`'s `disp` capture, bounded only by
# `]`,
# happily swallows an indexed form's entire `$index$*$scale$+$disp$` right-hand
# side as one ordinary, well-typed arithmetic expression (`rcx*4+0x10`
# type-checks
# fine as a plain `int`, so there's no type error for a later type-check to
# catch —
# both readings are equally well-typed, they just disagree on what the source
# text
# even *means*). The same trap catches `[base]` vs. `[base+disp]` (the
# empty-disp
# capture swallows `+disp` too) and `[base+disp]` vs. `[rip+disp]` (a bare
# identifier is itself a valid captured expression, so a generic `base` capture
# also matches literal `rip`). Confirmed empirically before this file was
# written:
# registering all four patterns made every one of them a hard "ambiguous syntax"
# parse error, including the flagship
# `mov rax, [rbx+rcx*4+0x10]` example this dialect is built around.
#
# Fixed at the compiler level, not worked around here: `src/parser/
# invocation_syntax.rs`'s `parse_invocation_via_syntax_candidates` now prefers
# whichever successful match used the *most* literal (non-capture) tokens, when
# more than one candidate parses the same text — `[base+index*scale+disp]`'s 5
# literal tokens (`[`,`+`,`*`,`+`,`]`) beat `[base+disp]`'s 3 (`[`,`+`,`]`),
# which
# beat `[base]`'s 2 (`[`,`]`); `[rip+disp]`'s literal `rip` token gives it 4,
# beating `[base+disp]`'s 3. Two patterns that are *genuinely* equally specific
# (like `$a$ + $b$` vs. `$b$ + $a$`) are untouched by this and still hit the
# original ambiguity error. See that file's own comment, and the commit that
# added
# it, for the full reasoning and the new tests covering it.
#
# =================
# reg,reg vs. reg,imm: overloads
# =================
# `Reg` is a distinct `bits<4>` type, so the resolver can distinguish register
# and immediate operands. Expose both forms under the real Intel mnemonic.
# (Memory-operand forms don't have this problem — see the section above: a
# bracketed operand is lexically distinct from a bare one, so `mov`'s many
# memory
# shapes safely share its name without ever reaching this ambiguity.)

from .impl import *

# `Reg`'s `bits<4>` invariant already guarantees this range. Keep the explicit
# assertion at the dialect boundary for a direct diagnostic if that invariant
# changes or another register representation is introduced later.
# `pub`, empirically required: called only from this same file's own
# `| syntax {...}`-faceted macro bodies below, but a non-`pub` declaration's
# within-file references didn't resolve correctly once imported from elsewhere
# (`unknown macro` from a file that only ever imports this one) — not
# investigated further, `pub` costs nothing here.
pub macro assert_valid_reg(r: Reg) {
    @assert r.value >= 0 && r.value <= 15, "not a valid register (0-15)"
}

# =================
# mov
# =================

syntax mov(a, b, c) = { mov $a$, $b$, $c$ }

pub macro mov(rd: Reg, rs: Reg)
    | syntax { mov $rd$, $rs$ } {
        assert_valid_reg rs
        mov rd, rs, 1
    }

# --- load direction: reg <- [mem] ---

pub macro mov_load_base(rd: Reg, base: Reg)
    | syntax { mov $rd$, [$base$] } {
        mov rd, Mem(base, 0), 1
    }

pub macro mov_load_base_disp(rd: Reg, base: Reg, disp: int)
    | syntax { mov $rd$, [$base$+$disp$] } {
        mov rd, Mem(base, disp), 1
    }

pub macro mov_load_indexed(
    rd: Reg,
    base: Reg,
    index: Reg,
    scale: int,
    disp: int
)
    | syntax { mov $rd$, [$base$+$index$*$scale$+$disp$] }
{
    mov rd, MemIndexed(base, index, scale, disp), 1
}

pub macro mov_load_rip(rd: Reg, disp: int)
    | syntax { mov $rd$, [rip+$disp$] } {
        mov rd, MemRipRelative(disp), 1
    }

# --- store direction: [mem] <- reg ---

pub macro mov_store_base(base: Reg, rs: Reg)
    | syntax { mov [$base$], $rs$ } {
        mov Mem(base, 0), rs, 1
    }

pub macro mov_store_base_disp(base: Reg, disp: int, rs: Reg)
    | syntax { mov [$base$+$disp$], $rs$ } {
        mov Mem(base, disp), rs, 1
    }

pub macro mov_store_indexed(
    base: Reg,
    index: Reg,
    scale: int,
    disp: int,
    rs: Reg
)
    | syntax { mov [$base$+$index$*$scale$+$disp$], $rs$ }
{
    mov MemIndexed(base, index, scale, disp), rs, 1
}

pub macro mov_store_rip(disp: int, rs: Reg)
    | syntax { mov [rip+$disp$], $rs$ } {
        mov MemRipRelative(disp), rs, 1
    }

# =================
# ALU ops: add, or, and, sub, xor, cmp
# =================
# Register-only sugar (drop `w`, hardcode 64-bit) — memory-destination forms
# (`add [rbx+4], rax, 1`'s style bracket sugar) aren't built here: the exact
# same
# mechanical pattern `mov`'s store direction above demonstrates would apply
# unchanged, just not worth six more near-identical copies of it for this file's
# own sake. `impl.basm`'s own `Mem(...)`/`MemIndexed(...)`/`MemRipRelative(...)`
# constructor calls remain directly usable as an ALU op's second operand either
# way (already ordinary expressions, not needing any dialect support at all) —
# `add Mem(rax, 4), rbx, 1` still works verbatim with this file imported.

syntax add(a, b, c) = { add $a$, $b$, $c$ }
pub macro add(rd: Reg, rs: Reg)
    | syntax { add $rd$, $rs$ } {
        assert_valid_reg rs
        add rd, rs, 1
    }

syntax or(a, b, c) = { or $a$, $b$, $c$ }
pub macro or(rd: Reg, rs: Reg)
    | syntax { or $rd$, $rs$ } {
        assert_valid_reg rs
        or rd, rs, 1
    }

syntax and(a, b, c) = { and $a$, $b$, $c$ }
pub macro and(rd: Reg, rs: Reg)
    | syntax { and $rd$, $rs$ } {
        assert_valid_reg rs
        and rd, rs, 1
    }

syntax sub(a, b, c) = { sub $a$, $b$, $c$ }

pub macro sub(rd: Reg, rs: Reg)
    | syntax { sub $rd$, $rs$ } {
        assert_valid_reg rs
        sub rd, rs, 1
    }

syntax xor(a, b, c) = { xor $a$, $b$, $c$ }
pub macro xor(rd: Reg, rs: Reg)
    | syntax { xor $rd$, $rs$ } {
        assert_valid_reg rs
        xor rd, rs, 1
    }

syntax cmp(a, b, c) = { cmp $a$, $b$, $c$ }
pub macro cmp(rd: Reg, rs: Reg)
    | syntax { cmp $rd$, $rs$ } {
        assert_valid_reg rs
        cmp rd, rs, 1
    }

syntax test(a, b, c) = { test $a$, $b$, $c$ }
pub macro test(rd: Reg, rs: Reg)
    | syntax { test $rd$, $rs$ } {
        assert_valid_reg rs
        test rd, rs, 1
    }

# reg,imm forms — same surface mnemonic as reg,reg, selected by operand type.

pub macro mov(rd: Reg, imm: int)
    | syntax { mov $rd$, $imm$ } { mov rd, imm, 1 }

pub macro add(rd: Reg, imm: int)
    | syntax { add $rd$, $imm$ } { add rd, imm, 1 }

pub macro or(rd: Reg, imm: int)
    | syntax { or $rd$, $imm$ } { or rd, imm, 1 }

pub macro and(rd: Reg, imm: int)
    | syntax { and $rd$, $imm$ } { and rd, imm, 1 }

pub macro sub(rd: Reg, imm: int)
    | syntax { sub $rd$, $imm$ } { sub rd, imm, 1 }

pub macro xor(rd: Reg, imm: int)
    | syntax { xor $rd$, $imm$ } { xor rd, imm, 1 }

pub macro cmp(rd: Reg, imm: int)
    | syntax { cmp $rd$, $imm$ } { cmp rd, imm, 1 }

pub macro test(rd: Reg, imm: int)
    | syntax { test $rd$, $imm$ } { test rd, imm, 1 }

# =================
# lea
# =================
# Address-only — reuses the exact same four addressing-mode patterns `mov`'s
# load
# direction above establishes, since `lea`'s own encoding shape (Phase 5) is
# identical to a memory *load*'s (reg field is the destination, `MemOperand` the
# address), just a different opcode.

pub macro lea_base(rd: Reg, base: Reg)
    | syntax { lea $rd$, [$base$] } {
        lea rd, Mem(base, 0), 1
    }

pub macro lea_base_disp(rd: Reg, base: Reg, disp: int)
    | syntax { lea $rd$, [$base$+$disp$] } {
        lea rd, Mem(base, disp), 1
    }

pub macro lea_indexed(rd: Reg, base: Reg, index: Reg, scale: int, disp: int)
    | syntax { lea $rd$, [$base$+$index$*$scale$+$disp$] }
{
    lea rd, MemIndexed(base, index, scale, disp), 1
}

pub macro lea_rip(rd: Reg, disp: int)
    | syntax { lea $rd$, [rip+$disp$] } {
        lea rd, MemRipRelative(disp), 1
    }

# =================
# shl/shr/sar
# =================
# reg,imm8 gets the same drop-`w` treatment as the ALU ops. The reg,CL form gets
# genuine `$rd$, cl` syntax this time (Phase 5's own notes explain why it didn't
# get this originally: a literal `cl` token and a generic `$imm$` capture both
# successfully parse `shl rax, cl`, which used to be an unconditional "ambiguous
# syntax" error before this file's own literal-specificity compiler fix — the
# literal `cl` pattern's extra literal token now correctly wins). Registered as
# an
# *unanchored* pattern on `shl_cl`/`shr_cl`/`sar_cl` themselves (their own real
# names, never spelled by a caller) rather than adding a third overload of
# `shl`/`shr`/`sar` — since the pattern's own leading token is the real mnemonic
# (`shl`, not `shl_cl`), `shl_cl` itself is never "claimed" and needs no
# restatement of its own.

syntax shl(a, b, c) = { shl $a$, $b$, $c$ }
pub macro shl(rd: Reg, imm: int)
    | syntax { shl $rd$, $imm$ } { shl rd, imm, 1 }
pub macro shl_cl(rd: Reg)
    | syntax { shl $rd$, cl } { shl_cl rd, 1 }

syntax shr(a, b, c) = { shr $a$, $b$, $c$ }

# These wrapper names distinguish the immediate and literal-`cl` bodies
# internally; both still expose the ordinary `shr` mnemonic at the call site.
pub macro shr_imm(rd: Reg, imm: int)
    | syntax { shr $rd$, $imm$ } { shr rd, imm, 1 }
pub macro shr_cl(rd: Reg)
    | syntax { shr $rd$, cl } { shr_cl rd, 1 }

syntax sar(a, b, c) = { sar $a$, $b$, $c$ }
pub macro sar(rd: Reg, imm: int)
    | syntax { sar $rd$, $imm$ } { sar rd, imm, 1 }
pub macro sar_cl(rd: Reg)
    | syntax { sar $rd$, cl } { sar_cl rd, 1 }

# =================
# 32-bit operand size: eax, ecx, ..., r15d
# =================
# The same sugar as every section above, overloaded on `Reg32` instead of
# `Reg` and hardcoding `w = 0` instead of `w = 1` — each one reuses its
# 64-bit counterpart's exact name and pattern, so the resolver alone picks
# the operand size from the register spelling (`mov eax, 1` vs.
# `mov rax, 1`), the same way it already picks reg,reg vs. reg,imm. Mixing
# sizes (`add rax, ecx`) matches no overload and is an error, as in real
# assembly. Memory operands' base/index registers stay `Reg`: in 64-bit
# mode an address is always formed from 64-bit registers, whatever the
# size of the data moved. `mov r32, imm` takes an imm32 (`impl.basm`'s
# `imm_len = 4 + 4 * w`), and like every 32-bit write it zero-extends into
# the full 64-bit register.

pub macro mov(rd: Reg32, rs: Reg32)
    | syntax { mov $rd$, $rs$ } { mov rd.reg, rs.reg, 0 }

pub macro mov(rd: Reg32, imm: int)
    | syntax { mov $rd$, $imm$ } { mov rd.reg, imm, 0 }

pub macro mov_load_base(rd: Reg32, base: Reg)
    | syntax { mov $rd$, [$base$] } {
        mov rd.reg, Mem(base, 0), 0
    }

pub macro mov_load_base_disp(rd: Reg32, base: Reg, disp: int)
    | syntax { mov $rd$, [$base$+$disp$] } {
        mov rd.reg, Mem(base, disp), 0
    }

pub macro mov_load_indexed(
    rd: Reg32,
    base: Reg,
    index: Reg,
    scale: int,
    disp: int
)
    | syntax { mov $rd$, [$base$+$index$*$scale$+$disp$] }
{
    mov rd.reg, MemIndexed(base, index, scale, disp), 0
}

pub macro mov_load_rip(rd: Reg32, disp: int)
    | syntax { mov $rd$, [rip+$disp$] } {
        mov rd.reg, MemRipRelative(disp), 0
    }

pub macro mov_store_base(base: Reg, rs: Reg32)
    | syntax { mov [$base$], $rs$ } {
        mov Mem(base, 0), rs.reg, 0
    }

pub macro mov_store_base_disp(base: Reg, disp: int, rs: Reg32)
    | syntax { mov [$base$+$disp$], $rs$ } {
        mov Mem(base, disp), rs.reg, 0
    }

pub macro mov_store_indexed(
    base: Reg,
    index: Reg,
    scale: int,
    disp: int,
    rs: Reg32
)
    | syntax { mov [$base$+$index$*$scale$+$disp$], $rs$ }
{
    mov MemIndexed(base, index, scale, disp), rs.reg, 0
}

pub macro mov_store_rip(disp: int, rs: Reg32)
    | syntax { mov [rip+$disp$], $rs$ } {
        mov MemRipRelative(disp), rs.reg, 0
    }

pub macro add(rd: Reg32, rs: Reg32)
    | syntax { add $rd$, $rs$ } { add rd.reg, rs.reg, 0 }
pub macro or(rd: Reg32, rs: Reg32)
    | syntax { or $rd$, $rs$ } { or rd.reg, rs.reg, 0 }
pub macro and(rd: Reg32, rs: Reg32)
    | syntax { and $rd$, $rs$ } { and rd.reg, rs.reg, 0 }
pub macro sub(rd: Reg32, rs: Reg32)
    | syntax { sub $rd$, $rs$ } { sub rd.reg, rs.reg, 0 }
pub macro xor(rd: Reg32, rs: Reg32)
    | syntax { xor $rd$, $rs$ } { xor rd.reg, rs.reg, 0 }
pub macro cmp(rd: Reg32, rs: Reg32)
    | syntax { cmp $rd$, $rs$ } { cmp rd.reg, rs.reg, 0 }
pub macro test(rd: Reg32, rs: Reg32)
    | syntax { test $rd$, $rs$ } { test rd.reg, rs.reg, 0 }

pub macro add(rd: Reg32, imm: int)
    | syntax { add $rd$, $imm$ } { add rd.reg, imm, 0 }
pub macro or(rd: Reg32, imm: int)
    | syntax { or $rd$, $imm$ } { or rd.reg, imm, 0 }
pub macro and(rd: Reg32, imm: int)
    | syntax { and $rd$, $imm$ } { and rd.reg, imm, 0 }
pub macro sub(rd: Reg32, imm: int)
    | syntax { sub $rd$, $imm$ } { sub rd.reg, imm, 0 }
pub macro xor(rd: Reg32, imm: int)
    | syntax { xor $rd$, $imm$ } { xor rd.reg, imm, 0 }
pub macro cmp(rd: Reg32, imm: int)
    | syntax { cmp $rd$, $imm$ } { cmp rd.reg, imm, 0 }
pub macro test(rd: Reg32, imm: int)
    | syntax { test $rd$, $imm$ } { test rd.reg, imm, 0 }

pub macro lea_base(rd: Reg32, base: Reg)
    | syntax { lea $rd$, [$base$] } {
        lea rd.reg, Mem(base, 0), 0
    }

pub macro lea_base_disp(rd: Reg32, base: Reg, disp: int)
    | syntax { lea $rd$, [$base$+$disp$] } {
        lea rd.reg, Mem(base, disp), 0
    }

pub macro lea_indexed(rd: Reg32, base: Reg, index: Reg, scale: int, disp: int)
    | syntax { lea $rd$, [$base$+$index$*$scale$+$disp$] }
{
    lea rd.reg, MemIndexed(base, index, scale, disp), 0
}

pub macro lea_rip(rd: Reg32, disp: int)
    | syntax { lea $rd$, [rip+$disp$] } {
        lea rd.reg, MemRipRelative(disp), 0
    }

pub macro shl(rd: Reg32, imm: int)
    | syntax { shl $rd$, $imm$ } { shl rd.reg, imm, 0 }
pub macro shl_cl(rd: Reg32)
    | syntax { shl $rd$, cl } { shl_cl rd.reg, 0 }
pub macro shr_imm(rd: Reg32, imm: int)
    | syntax { shr $rd$, $imm$ } { shr rd.reg, imm, 0 }
pub macro shr_cl(rd: Reg32)
    | syntax { shr $rd$, cl } { shr_cl rd.reg, 0 }
pub macro sar(rd: Reg32, imm: int)
    | syntax { sar $rd$, $imm$ } { sar rd.reg, imm, 0 }
pub macro sar_cl(rd: Reg32)
    | syntax { sar $rd$, cl } { sar_cl rd.reg, 0 }

# =================
# memory operands as values
# =================
# Operand patterns (they start with `[`, so the parser tries them wherever an
# operand starts, like `nasm.basm`'s `[rel x]`): each bracketed address becomes
# a plain `MemOperand` value. The sections above predate these and keep their
# own per-mnemonic bracket patterns, which still win wherever both match
# (more literal tokens); everything below takes a `$src$`/`$dst$` capture
# instead and lets the type pick the overload.

pub macro mem_base(base: Reg) -> MemOperand
    | syntax { [$base$] } { @return Mem(base, 0) }
pub macro mem_base_disp(base: Reg, disp: int) -> MemOperand
    | syntax { [$base$+$disp$] } { @return Mem(base, disp) }
pub macro mem_indexed(base: Reg, index: Reg, scale: int, disp: int) -> MemOperand
    | syntax { [$base$+$index$*$scale$+$disp$] } { @return MemIndexed(base, index, scale, disp) }
pub macro mem_rip(disp: int) -> MemOperand
    | syntax { [rip+$disp$] } { @return MemRipRelative(disp) }

# =================
# byte registers: al, cl, ..., r15b
# =================
# `mov rd, rs`/`mov rd, imm` need nothing here: the existing two-operand `mov`
# patterns already reach `impl.basm`'s `Reg8` overloads. The bracket patterns
# above name the load/store macros, so the byte forms overload those names. A byte store of an immediate has no
# register to size it, hence `mov byte [...], imm`.

pub macro mov_load_base(rd: Reg8, base: Reg)
    | syntax { mov $rd$, [$base$] } { mov rd, Mem(base, 0) }
pub macro mov_load_base_disp(rd: Reg8, base: Reg, disp: int)
    | syntax { mov $rd$, [$base$+$disp$] } { mov rd, Mem(base, disp) }
pub macro mov_load_indexed(rd: Reg8, base: Reg, index: Reg, scale: int, disp: int)
    | syntax { mov $rd$, [$base$+$index$*$scale$+$disp$] }
{
    mov rd, MemIndexed(base, index, scale, disp)
}
pub macro mov_load_rip(rd: Reg8, disp: int)
    | syntax { mov $rd$, [rip+$disp$] } { mov rd, MemRipRelative(disp) }

pub macro mov_store_base(base: Reg, rs: Reg8)
    | syntax { mov [$base$], $rs$ } { mov Mem(base, 0), rs }
pub macro mov_store_base_disp(base: Reg, disp: int, rs: Reg8)
    | syntax { mov [$base$+$disp$], $rs$ } { mov Mem(base, disp), rs }
pub macro mov_store_indexed(base: Reg, index: Reg, scale: int, disp: int, rs: Reg8)
    | syntax { mov [$base$+$index$*$scale$+$disp$], $rs$ }
{
    mov MemIndexed(base, index, scale, disp), rs
}
pub macro mov_store_rip(disp: int, rs: Reg8)
    | syntax { mov [rip+$disp$], $rs$ } { mov MemRipRelative(disp), rs }

syntax mov_byte(a, b) = { mov_byte $a$, $b$ }
pub macro mov_byte_mem(dst: MemOperand, imm: int)
    | syntax { mov byte $dst$, $imm$ } { mov_byte dst, imm }

# =================
# movzx
# =================

syntax movzx(a, b, c) = { movzx $a$, $b$, $c$ }
syntax movzx_word(a, b, c) = { movzx_word $a$, $b$, $c$ }
pub macro movzx(rd: Reg, src: Reg8)
    | syntax { movzx $rd$, $src$ } { movzx rd, src, 1 }
pub macro movzx_byte(rd: Reg, src: MemOperand)
    | syntax { movzx $rd$, byte $src$ } { movzx rd, src, 1 }
pub macro movzx_word_mem(rd: Reg, src: MemOperand)
    | syntax { movzx $rd$, word $src$ } { movzx_word rd, src, 1 }
pub macro movzx(rd: Reg32, src: Reg8)
    | syntax { movzx $rd$, $src$ } { movzx rd.reg, src, 0 }
pub macro movzx_byte(rd: Reg32, src: MemOperand)
    | syntax { movzx $rd$, byte $src$ } { movzx rd.reg, src, 0 }
pub macro movzx_word_mem(rd: Reg32, src: MemOperand)
    | syntax { movzx $rd$, word $src$ } { movzx_word rd.reg, src, 0 }

# =================
# inc/dec, mul/imul/div/idiv, cqo/cdq
# =================
# A register operand sizes itself; a memory one needs `qword`/`dword`, each
# its own `_qword`/`_dword` macro (the two would otherwise be identical
# `MemOperand` overloads).
syntax inc(a, b) = { inc $a$, $b$ }
pub macro inc(rd: Reg)
    | syntax { inc $rd$ } { inc rd, 1 }
pub macro inc(rd: Reg32)
    | syntax { inc $rd$ } { inc rd.reg, 0 }
pub macro inc_qword(dst: MemOperand)
    | syntax { inc qword $dst$ } { inc dst, 1 }
pub macro inc_dword(dst: MemOperand)
    | syntax { inc dword $dst$ } { inc dst, 0 }

syntax dec(a, b) = { dec $a$, $b$ }
pub macro dec(rd: Reg)
    | syntax { dec $rd$ } { dec rd, 1 }
pub macro dec(rd: Reg32)
    | syntax { dec $rd$ } { dec rd.reg, 0 }
pub macro dec_qword(dst: MemOperand)
    | syntax { dec qword $dst$ } { dec dst, 1 }
pub macro dec_dword(dst: MemOperand)
    | syntax { dec dword $dst$ } { dec dst, 0 }

syntax mul(a, b) = { mul $a$, $b$ }
pub macro mul(rd: Reg)
    | syntax { mul $rd$ } { mul rd, 1 }
pub macro mul(rd: Reg32)
    | syntax { mul $rd$ } { mul rd.reg, 0 }
pub macro mul_qword(dst: MemOperand)
    | syntax { mul qword $dst$ } { mul dst, 1 }
pub macro mul_dword(dst: MemOperand)
    | syntax { mul dword $dst$ } { mul dst, 0 }

syntax div(a, b) = { div $a$, $b$ }
pub macro div(rd: Reg)
    | syntax { div $rd$ } { div rd, 1 }
pub macro div(rd: Reg32)
    | syntax { div $rd$ } { div rd.reg, 0 }
pub macro div_qword(dst: MemOperand)
    | syntax { div qword $dst$ } { div dst, 1 }
pub macro div_dword(dst: MemOperand)
    | syntax { div dword $dst$ } { div dst, 0 }

syntax idiv(a, b) = { idiv $a$, $b$ }
pub macro idiv(rd: Reg)
    | syntax { idiv $rd$ } { idiv rd, 1 }
pub macro idiv(rd: Reg32)
    | syntax { idiv $rd$ } { idiv rd.reg, 0 }
pub macro idiv_qword(dst: MemOperand)
    | syntax { idiv qword $dst$ } { idiv dst, 1 }
pub macro idiv_dword(dst: MemOperand)
    | syntax { idiv dword $dst$ } { idiv dst, 0 }

# `imul` has one-, two- and three-operand forms: `impl.basm`'s `imul1`
# (`rdx:rax = rax * src`), `imul2` (`rd *= src`) and `imul3` (`rd = rs * imm`).
# NASM's `imul rd, imm` shorthand for `imul rd, rd, imm` is left out, since its
# `$rd$, $imm$` pattern would match exactly as much text as `imul rd, rs`.
pub macro imul(rs: Reg)
    | syntax { imul $rs$ } { imul1 rs, 1 }
pub macro imul(rs: Reg32)
    | syntax { imul $rs$ } { imul1 rs.reg, 0 }
pub macro imul_qword(src: MemOperand)
    | syntax { imul qword $src$ } { imul1 src, 1 }
pub macro imul_dword(src: MemOperand)
    | syntax { imul dword $src$ } { imul1 src, 0 }
pub macro imul(rd: Reg, rs: Reg)
    | syntax { imul $rd$, $rs$ } { imul2 rd, rs, 1 }
pub macro imul(rd: Reg, src: MemOperand)
    | syntax { imul $rd$, $src$ } { imul2 rd, src, 1 }
pub macro imul(rd: Reg, rs: Reg, imm: int)
    | syntax { imul $rd$, $rs$, $imm$ } { imul3 rd, rs, imm, 1 }
pub macro imul(rd: Reg32, rs: Reg32)
    | syntax { imul $rd$, $rs$ } { imul2 rd.reg, rs.reg, 0 }
pub macro imul(rd: Reg32, src: MemOperand)
    | syntax { imul $rd$, $src$ } { imul2 rd.reg, src, 0 }
pub macro imul(rd: Reg32, rs: Reg32, imm: int)
    | syntax { imul $rd$, $rs$, $imm$ } { imul3 rd.reg, rs.reg, imm, 0 }

syntax cqo() = { cqo }
syntax cdq() = { cdq }

# =================
# push/pop, control flow, ret
# =================
# None of these have a `w` parameter in `impl.basm` at all (Phase 4/5's own
# notes explain why — `push`/`pop` have no 32-bit form in 64-bit mode, and
# `jmp`/`jcc`/`call`/`ret` have no operand-size concept whatsoever), so nothing
# here is "claimed" by anything else and none of these strictly *need* a
# restatement for some other shape to keep working. Restated explicitly anyway,
# matching `std/riscv/native.basm`'s own stated convention of giving every
# mnemonic its own explicit entry regardless of whether default syntax would
# already suffice.

syntax push(rd) = { push $rd$ }
syntax pop(rd) = { pop $rd$ }

syntax jmp(target) = { jmp $target$ }
syntax call(target) = { call $target$ }
syntax ret() = { ret }
syntax syscall() = { syscall }

syntax je(target) = { je $target$ }
syntax jne(target) = { jne $target$ }
syntax jb(target) = { jb $target$ }
syntax jae(target) = { jae $target$ }
syntax ja(target) = { ja $target$ }
syntax jbe(target) = { jbe $target$ }
syntax jl(target) = { jl $target$ }
syntax jge(target) = { jge $target$ }
syntax jle(target) = { jle $target$ }
syntax jg(target) = { jg $target$ }
syntax js(target) = { js $target$ }
syntax jns(target) = { jns $target$ }
syntax jo(target) = { jo $target$ }
syntax jno(target) = { jno $target$ }
syntax jp(target) = { jp $target$ }
syntax jnp(target) = { jnp $target$ }
syntax jz(target) = { jz $target$ }
syntax jnz(target) = { jnz $target$ }
syntax jc(target) = { jc $target$ }
syntax jnae(target) = { jnae $target$ }
syntax jnc(target) = { jnc $target$ }
syntax jnb(target) = { jnb $target$ }
syntax jnbe(target) = { jnbe $target$ }
syntax jna(target) = { jna $target$ }
syntax jnge(target) = { jnge $target$ }
syntax jnl(target) = { jnl $target$ }
syntax jng(target) = { jng $target$ }
syntax jnle(target) = { jnle $target$ }
syntax jpe(target) = { jpe $target$ }
syntax jpo(target) = { jpo $target$ }
