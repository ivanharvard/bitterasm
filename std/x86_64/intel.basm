# A register, then a sized memory operand: `movzx eax, byte [rsi]`,
# `mov fs, word [rbx]`.
## `movzx rd, size [src]`, as in `movzx eax, byte [rsi]`.
pub macro movzx_from_sized<T>(rd: T, size: OperandSize, src: MemOperand)
    | syntax { movzx $rd$, $size$ $src$ } { movzx rd, src, size }
## `movsx rd, size [src]`, as in `movsx rax, word [rsi]`.
pub macro movsx_from_sized<T>(rd: T, size: OperandSize, src: MemOperand)
    | syntax { movsx $rd$, $size$ $src$ } { movsx rd, src, size }
## `movsxd rd, size [src]`, as in `movsxd rax, dword [rsi]`.
pub macro movsxd_from_sized<T>(rd: T, size: OperandSize, src: MemOperand)
    | syntax { movsxd $rd$, $size$ $src$ } { movsxd rd, src, size }
## `mov rd, size [src]`, as in `mov fs, word [rbx]`.
pub macro mov_from_sized<T>(rd: T, size: OperandSize, src: MemOperand)
    | syntax { mov $rd$, $size$ $src$ } { mov rd, src, size }

# =================
# reserved names and keywords
# =================

syntax interrupt(n) = { int $n$ }
syntax jmp_far(src) = { jmp far $src$ }
syntax call_far(src) = { call far $src$ }
