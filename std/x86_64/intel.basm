#! Intel-syntax x86-64 assembly: destination first, registers by name,
#! and memory operands in brackets.
#!
#! ```
#! from std.x86_64.intel import *
#!
#! mov rax, [rsp+8]
#! add eax, 1
#! mov r8, [rbx+rcx*4+0x10]
#! add qword [rbx], 1
#! movzx eax, byte [rsi]
#! ```
#!
#! ```bytes
#! 48 8b 44 24 08
#! 83 c0 01
#! 4c 8b 44 8b 10
#! 48 83 03 01
#! 0f b6 06
#! ```
#!
#! The operand size comes from the register's name: `rax` and `r8` are 64
#! bits, `eax` and `r8d` 32, `ax` and `r8w` 16, `al`, `ah` and `r8b` 8. A
#! memory operand with no register to size it takes a size keyword: `byte`,
#! `word`, `dword`, `qword`, or `oword` for `cmpxchg16b`. Memory operands
#! are `[base]`, `[base+disp]`, `[base-disp]`, `[base+index]`,
#! `[base+index*scale]`, `[base+index*scale+disp]` (or `-disp`) and
#! `[rip+disp]`.
#!
#! Every instruction of `std.x86_64.impl` keeps its own form too, and the
#! older ones their final `w`: `mov rax, rbx, 0` is a 32-bit move.
#!
#! For NASM's `[rel label]` and data directives, use `std.x86_64.nasm`.

# The instructions themselves need no syntax here: `impl.basm` writes each
# one generic over its registers' type, so the default `name a, b` call
# already reads as Intel syntax. This file adds what default syntax can't
# spell: bracketed memory operands, size keywords, and a few mnemonics
# whose names the language reserves (`int`) or that take a keyword (`jmp
# far`).
#
# None of the patterns below starts with its own macro's name, so none
# claims a mnemonic: `add rax, rbx` still parses as the default call, and
# reaches the right `add` overload by type.

pub from .impl import *

## Fails to compile unless `r` is a register number, 0 to 15.
pub macro assert_valid_reg(r: Reg) {
    @assert r.value >= 0 && r.value <= 15, "not a valid register (0-15)"
}

# =================
# memory operands
# =================
# Operand patterns: each starts with `[`, so it's tried wherever an operand
# starts, and becomes a `MemOperand`. When more than one matches, the one
# with the most literal tokens wins: `[rbx+rcx*4+8]` is the indexed form,
# not `[base+disp]` with `disp = rcx*4+8`, and `[rip+8]` isn't
# `[base+disp]` either.

## `[base]`.
pub macro mem_base(base: Reg) -> MemOperand
    | syntax { [$base$] } { @return Mem(base, 0) }

## `[base+disp]`.
pub macro mem_plus(base: Reg, disp: int) -> MemOperand
    | syntax { [$base$+$disp$] } { @return Mem(base, disp) }
## `[base+index]`, an index with scale 1.
pub macro mem_plus(base: Reg, index: Reg) -> MemOperand
    | syntax { [$base$+$index$] } { @return MemIndexed(base, index, 1, 0) }

## `[base-disp]`.
pub macro mem_minus(base: Reg, disp: int) -> MemOperand
    | syntax { [$base$-$disp$] } { @return Mem(base, -disp) }

## `[base+index*scale]`.
pub macro mem_scaled(base: Reg, index: Reg, scale: int) -> MemOperand
    | syntax { [$base$+$index$*$scale$] }
{
    @return MemIndexed(base, index, scale, 0)
}

## `[base+index*scale+disp]`.
pub macro mem_indexed(
    base: Reg,
    index: Reg,
    scale: int,
    disp: int
) -> MemOperand
    | syntax { [$base$+$index$*$scale$+$disp$] }
{
    @return MemIndexed(base, index, scale, disp)
}

## `[base+index*scale-disp]`.
pub macro mem_indexed_minus(
    base: Reg,
    index: Reg,
    scale: int,
    disp: int
) -> MemOperand
    | syntax { [$base$+$index$*$scale$-$disp$] }
{
    @return MemIndexed(base, index, scale, -disp)
}

## `[rip+disp]`: `disp` bytes past the end of the instruction.
pub macro mem_rip(disp: int) -> MemOperand
    | syntax { [rip+$disp$] } { @return MemRipRelative(disp) }

## `[rip-disp]`: `disp` bytes before the end of the instruction.
pub macro mem_rip_minus(disp: int) -> MemOperand
    | syntax { [rip-$disp$] } { @return MemRipRelative(-disp) }

# =================
# size keywords
# =================
# `add qword [rbx], 1` is `add [rbx], 1, qword`. `$size$ $dst$` is two
# captures in a row: `size` ends where an expression has to, at the `[`.
# Each mnemonic needs its own pattern, since a pattern can't capture the
# mnemonic; the operand after the memory one, if any, is generic, so one
# macro covers `shl qword [rbx], 1` and `shl qword [rbx], cl`.

## `add size [dst], src`, as in `add qword [rbx], 1`.
pub macro add_sized<T>(size: OperandSize, dst: MemOperand, src: T)
    | syntax { add $size$ $dst$, $src$ } { add dst, src, size }
## `or size [dst], src`, as in `or qword [rbx], 1`.
pub macro or_sized<T>(size: OperandSize, dst: MemOperand, src: T)
    | syntax { or $size$ $dst$, $src$ } { or dst, src, size }
## `adc size [dst], src`, as in `adc qword [rbx], 1`.
pub macro adc_sized<T>(size: OperandSize, dst: MemOperand, src: T)
    | syntax { adc $size$ $dst$, $src$ } { adc dst, src, size }
## `sbb size [dst], src`, as in `sbb qword [rbx], 1`.
pub macro sbb_sized<T>(size: OperandSize, dst: MemOperand, src: T)
    | syntax { sbb $size$ $dst$, $src$ } { sbb dst, src, size }
## `and size [dst], src`, as in `and qword [rbx], 1`.
