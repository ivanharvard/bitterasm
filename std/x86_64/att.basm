## `shl` on a word. `count` must be `%cl`.
pub macro shlw<M>(
    count: Register<Reg8>,
    dst: Memory<M>
) { shl dst.at, count.r, word }
## `shl` on a long.
pub macro shll(count: Imm, dst: Register<Reg32>) { shl dst.r, count.value }
## `shl` on a long. `count` must be `%cl`.
pub macro shll(
    count: Register<Reg8>,
    dst: Register<Reg32>
) { shl dst.r, count.r }
## `shl` on a long.
pub macro shll<M>(count: Imm, dst: Memory<M>) { shl dst.at, count.value, dword }
## `shl` on a long. `count` must be `%cl`.
pub macro shll<M>(
    count: Register<Reg8>,
    dst: Memory<M>
) { shl dst.at, count.r, dword }
## `shl` on a quadword.
pub macro shlq(count: Imm, dst: Register<Reg>) { shl dst.r, count.value }
## `shl` on a quadword. `count` must be `%cl`.
pub macro shlq(count: Register<Reg8>, dst: Register<Reg>) { shl dst.r, count.r }
## `shl` on a quadword.
pub macro shlq<M>(count: Imm, dst: Memory<M>) { shl dst.at, count.value, qword }
## `shl` on a quadword. `count` must be `%cl`.
pub macro shlq<M>(
    count: Register<Reg8>,
    dst: Memory<M>
) { shl dst.at, count.r, qword }

## `dst = dst >> count`, shifting in zeros.
pub macro shr<R>(count: Imm, dst: Register<R>) { shr dst.r, count.value }
## `dst = dst >> count`, shifting in zeros. `count` must be `%cl`.
pub macro shr<R>(count: Register<Reg8>, dst: Register<R>) { shr dst.r, count.r }
