## `inc` on a long.
pub macro incl<M>(dst: Memory<M>) { inc dst.at, dword }
## `inc` on a quadword.
pub macro incq(dst: Register<Reg>) { inc dst.r }
## `inc` on a quadword.
pub macro incq<M>(dst: Memory<M>) { inc dst.at, qword }

