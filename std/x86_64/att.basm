# Two- and three-operand `imul` (`impl.basm`'s `imul2`/`imul3`), sized by
# their registers: `imul %rs, %rd` is `rd *= rs`, `imul $imm, %rs, %rd` is
# `rd = rs * imm`.
pub macro imul(rs: Reg, rd: Reg)
    | syntax { imul %$rs$, %$rd$ } { imul2 rd, rs, 1 }
pub macro imul(imm: int, rs: Reg, rd: Reg)
    | syntax { imul \$$imm$, %$rs$, %$rd$ } { imul3 rd, rs, imm, 1 }
pub macro imul_load_base(rd: Reg, base: Reg)
    | syntax { imul (%$base$), %$rd$ } { imul2 rd, Mem(base, 0), 1 }
pub macro imul_load_base_disp(rd: Reg, disp: int, base: Reg)
    | syntax { imul $disp$(%$base$), %$rd$ } { imul2 rd, Mem(base, disp), 1 }
pub macro imul_load_indexed(rd: Reg, disp: int, base: Reg, index: Reg, scale: int)
    | syntax { imul $disp$(%$base$,%$index$,$scale$), %$rd$ } { imul2 rd, MemIndexed(base, index, scale, disp), 1 }
pub macro imul_load_rip(rd: Reg, disp: int)
    | syntax { imul $disp$(%rip), %$rd$ } { imul2 rd, MemRipRelative(disp), 1 }
pub macro imul(rs: Reg32, rd: Reg32)
    | syntax { imul %$rs$, %$rd$ } { imul2 rd.reg, rs.reg, 0 }
pub macro imul(imm: int, rs: Reg32, rd: Reg32)
    | syntax { imul \$$imm$, %$rs$, %$rd$ } { imul3 rd.reg, rs.reg, imm, 0 }
pub macro imul_load_base(rd: Reg32, base: Reg)
    | syntax { imul (%$base$), %$rd$ } { imul2 rd.reg, Mem(base, 0), 0 }
pub macro imul_load_base_disp(rd: Reg32, disp: int, base: Reg)
    | syntax { imul $disp$(%$base$), %$rd$ } { imul2 rd.reg, Mem(base, disp), 0 }
pub macro imul_load_indexed(rd: Reg32, disp: int, base: Reg, index: Reg, scale: int)
    | syntax { imul $disp$(%$base$,%$index$,$scale$), %$rd$ } { imul2 rd.reg, MemIndexed(base, index, scale, disp), 0 }
pub macro imul_load_rip(rd: Reg32, disp: int)
    | syntax { imul $disp$(%rip), %$rd$ } { imul2 rd.reg, MemRipRelative(disp), 0 }

