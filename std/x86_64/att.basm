#! AT&T-syntax x86-64 assembly, as GNU `as` reads it: source first,
#! destination second, `%` before registers and `$` before immediates.
#!
#! ```
#! from std.x86_64.att import *
#!
#! mov %rbx, %rax
#! mov 8(%rsp), %rax
#! add $1, %rax
#! movl $2, %eax
#! movb %dl, 1(%rdi)
#! movb $124, 67(%r9)
#! movzbl (%r8,%rdx), %edx
#! ```
#!
#! ```bytes
#! 48 89 d8
#! 48 8b 44 24 08
#! 48 81 c0 01 00 00 00
#! b8 02 00 00 00
#! 88 57 01
#! 41 c6 41 43 7c
#! 41 0f b6 14 10
#! ```
#!
#! Every operand is a value: `%rax` is a `Register`, `$1` an `Imm`, and each
#! memory form a `Memory`: `(%rbx)`, `8(%rbx)`, `(%rbx,%rcx)`,
#! `8(%rbx,%rcx)`, `(%rbx,%rcx,4)`, `8(%rbx,%rcx,4)` and `8(%rip)`. A
#! displacement can be any expression, like `-4(%rbp)`.
#!
#! `label(%rip)` is the address of `label`, relative to the next
#! instruction, the way GNU `as` reads it; a number before `(%rip)` is a
#! plain displacement. A label is a `label`, not a number, which is how the
#! two are told apart.
#!
#! A size suffix (`b`, `w`, `l` or `q`, as in `movl` or `cmpq`) is optional
#! when a register gives the size, and must match it. With only an
#! immediate and memory, nothing else says the size, so the suffix is
#! required: `movb $1, (%rdi)`. `movzbl`-style mnemonics extend a byte or
#! word into a larger register.
#!
#! A string instruction can take its prefix on the same line: `rep stosb`.
#! `*%rax` and `*8(%rsp)` are indirect `jmp` and `call` targets. Data is
#! `db`, `dw`, `dd` and `dq`, from `std.x86_64.data`; labels, sections and
#! `pub` work as everywhere in BitterASM rather than as GNU directives.
#! Every instruction of `std.x86_64.impl` stays available in its explicit
#! form too: `mov rax, rbx, 0` for a 32-bit move.

pub from .impl import *
pub from .data import *

# =================
# operands
# =================
# Wrapping each operand in its own type is what lets an AT&T overload take
# source-first operands without colliding with `std.x86_64.impl`'s
# destination-first ones of the same name: `mov %eax, %edx` is
# `mov(Register<Reg32>, Register<Reg32>)`, which only the overloads here
# take. Each one unwraps its operands and calls `impl`.

## A register operand, `%rax`.
pub struct Register<R> {
    ## The register.
    pub r: R,
}

## An immediate operand, `$1`.
pub struct Imm {
    ## The value.
    pub value: int,
}

## A memory operand. `at` is a `MemOperand`, or a `RipLabel` for
## `label(%rip)`.
pub struct Memory<M> {
    ## Where it is.
    pub at: M,
}

## The target of an indirect `jmp` or `call`: `*%rax`, or `*8(%rsp)`.
pub struct Indirect<T> {
    ## The register or memory holding the target.
    pub through: T,
}

## `%r`: a register.
pub macro register<R>(r: R) -> Register<R>
    | syntax { %$r$ }
{
    @return Register<R>(r)
}

## `$value`: an immediate.
pub macro immediate(value: int) -> Imm
    | syntax { \$$value$ }
{
    @return Imm(value)
}

## `$label` would be the label's absolute address, which isn't known until
## the program is loaded. Fails; use `lea label(%rip), %reg` instead.
pub macro immediate(_value: label) -> Imm
    | syntax { \$$_value$ }
{
    @assert 0 == 1, "`$label` is an absolute address; use `lea label(%rip), %reg` for it instead"
}

## `(%base)`.
pub macro memory_base(base: Reg) -> Memory<MemOperand>
    | syntax { (%$base$) }
{
    @return Memory<MemOperand>(Mem(base, 0))
}

## `disp(%base)`.
pub macro memory_disp(disp: int, base: Reg) -> Memory<MemOperand>
    | syntax { $disp$(%$base$) }
{
    @return Memory<MemOperand>(Mem(base, disp))
}

## `(%base,%index)`.
pub macro memory_indexed(base: Reg, index: Reg) -> Memory<MemOperand>
    | syntax { (%$base$,%$index$) }
{
    @return Memory<MemOperand>(MemIndexed(base, index, 1, 0))
}

## `disp(%base,%index)`.
pub macro memory_disp_indexed(
    disp: int,
    base: Reg,
    index: Reg
) -> Memory<MemOperand>
    | syntax { $disp$(%$base$,%$index$) }
{
    @return Memory<MemOperand>(MemIndexed(base, index, 1, disp))
}

## `(%base,%index,scale)`.
pub macro memory_scaled(base: Reg, index: Reg, scale: int) -> Memory<MemOperand>
    | syntax { (%$base$,%$index$,$scale$) }
{
    @return Memory<MemOperand>(MemIndexed(base, index, scale, 0))
}

## `disp(%base,%index,scale)`.
pub macro memory_disp_scaled(
    disp: int,
    base: Reg,
    index: Reg,
    scale: int
) -> Memory<MemOperand>
    | syntax { $disp$(%$base$,%$index$,$scale$) }
{
    @return Memory<MemOperand>(MemIndexed(base, index, scale, disp))
}

## `disp(%rip)`: `disp` bytes past the end of the instruction.
pub macro memory_rip(disp: int) -> Memory<MemOperand>
    | syntax { $disp$(%rip) }
{
    @return Memory<MemOperand>(MemRipRelative(disp))
}

## `label(%rip)`: `label`, addressed relative to the next instruction, so
## the code works wherever it's loaded.
pub macro memory_rip(disp: label) -> Memory<RipLabel>
    | syntax { $disp$(%rip) }
{
    @return Memory<RipLabel>(RipLabel(target = disp))
}

## `*target`: an indirect `jmp` or `call` through a register or memory.
pub macro indirect<T>(through: T) -> Indirect<T>
    | syntax { *$through$ }
{
    @return Indirect<T>(through)
}

# A suffixed instruction's operands, checked against its suffix. An
# immediate or a memory operand takes whatever size the suffix says.
macro suffix_fits(_operand: Imm, _bits: int) {}
macro suffix_fits<M>(_operand: Memory<M>, _bits: int) {}
macro suffix_fits(_operand: Register<Reg8>, bits: int) {
    @assert bits == 8, "this register's size doesn't match the instruction's size suffix"
}

macro suffix_fits(_operand: Register<Reg16>, bits: int) {
    @assert bits == 16, "this register's size doesn't match the instruction's size suffix"
}

macro suffix_fits(_operand: Register<Reg32>, bits: int) {
    @assert bits == 32, "this register's size doesn't match the instruction's size suffix"
}

macro suffix_fits(_operand: Register<Reg>, bits: int) {
    @assert bits == 64, "this register's size doesn't match the instruction's size suffix"
}

# =================
# two operands: mov, add, adc, sub, sbb, and, or, xor, cmp, test
# =================

## `dst = src`.
pub macro mov(src: Register<Reg>, dst: Register<Reg>) { mov dst.r, src.r }
pub macro mov(src: Register<Reg32>, dst: Register<Reg32>) { mov dst.r, src.r }
pub macro mov(src: Register<Reg16>, dst: Register<Reg16>) { mov dst.r, src.r }
pub macro mov(src: Register<Reg8>, dst: Register<Reg8>) { mov dst.r, src.r }
## `dst = src`.
pub macro mov<R>(src: Imm, dst: Register<R>) { mov dst.r, src.value }
## `dst = src`.
pub macro mov<M, R>(src: Memory<M>, dst: Register<R>) { mov dst.r, src.at }
## `dst = src`.
pub macro mov<R, M>(src: Register<R>, dst: Memory<M>) { mov dst.at, src.r }
## Fails: an immediate and a memory operand need a size suffix, like `movq $1,
## (%rdi)`.
pub macro mov(_src: Imm, _dst: Memory<MemOperand>) {
    @assert 0 == 1, "an immediate and a memory operand need a size suffix, like `movq $1, (%rdi)`"
}
## Fails: an immediate can't be stored at a `label(%rip)` operand.
pub macro mov(_src: Imm, _dst: Memory<RipLabel>) {
    @assert 0 == 1, "an immediate can't be stored at a `label(%rip)` operand"
}
## `mov` on byte operands.
pub macro movb<S, D>(src: S, dst: D) {
    suffix_fits src, 8
    suffix_fits dst, 8
    mov src, dst
}
## `mov` on byte operands.
pub macro movb(
    src: Imm,
    dst: Memory<MemOperand>
) { mov dst.at, src.value, byte }
## `mov` on word operands.
pub macro movw<S, D>(src: S, dst: D) {
    suffix_fits src, 16
    suffix_fits dst, 16
    mov src, dst
}
## `mov` on word operands.
pub macro movw(
    src: Imm,
    dst: Memory<MemOperand>
) { mov dst.at, src.value, word }
## `mov` on long operands.
pub macro movl<S, D>(src: S, dst: D) {
    suffix_fits src, 32
    suffix_fits dst, 32
    mov src, dst
}
## `mov` on long operands.
pub macro movl(
    src: Imm,
    dst: Memory<MemOperand>
) { mov dst.at, src.value, dword }
## `mov` on quadword operands.
pub macro movq<S, D>(src: S, dst: D) {
    suffix_fits src, 64
    suffix_fits dst, 64
    mov src, dst
}
## `mov` on quadword operands.
pub macro movq(
    src: Imm,
    dst: Memory<MemOperand>
) { mov dst.at, src.value, qword }

