# =================
# one operand: inc, dec, neg, not, mul, div, idiv
# =================

## `dst = dst + 1`, leaving CF alone.
pub macro inc(dst: Register<Reg>) { inc dst.r }
pub macro inc(dst: Register<Reg32>) { inc dst.r }
pub macro inc(dst: Register<Reg16>) { inc dst.r }
pub macro inc(dst: Register<Reg8>) { inc dst.r }
## Fails: a memory operand alone needs a size suffix, like `incq (%rdi)`.
pub macro inc(_dst: Memory<MemOperand>) {
    @assert 0 == 1, "a memory operand alone needs a size suffix, like `incq (%rdi)`"
}
## `inc` on a byte.
