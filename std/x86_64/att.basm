# =================
# zero and sign extension: movzbl, movsbq, movslq, ...
# =================

## `dst = src`, a byte zero-extended into a word.
pub macro movzbw(
    src: Register<Reg8>,
    dst: Register<Reg16>
) { movzx dst.r, src.r }
## `dst = src`, a byte zero-extended into a word.
pub macro movzbw<M>(
    src: Memory<M>,
    dst: Register<Reg16>
) { movzx dst.r, src.at, byte }

## `dst = src`, a byte zero-extended into a long.
pub macro movzbl(
    src: Register<Reg8>,
    dst: Register<Reg32>
) { movzx dst.r, src.r }
## `dst = src`, a byte zero-extended into a long.
pub macro movzbl<M>(
    src: Memory<M>,
    dst: Register<Reg32>
) { movzx dst.r, src.at, byte }

## `dst = src`, a byte zero-extended into a quadword.
pub macro movzbq(src: Register<Reg8>, dst: Register<Reg>) { movzx dst.r, src.r }
## `dst = src`, a byte zero-extended into a quadword.
pub macro movzbq<M>(
    src: Memory<M>,
    dst: Register<Reg>
) { movzx dst.r, src.at, byte }

## `dst = src`, a word zero-extended into a long.
pub macro movzwl(
    src: Register<Reg16>,
    dst: Register<Reg32>
) { movzx dst.r, src.r }
## `dst = src`, a word zero-extended into a long.
pub macro movzwl<M>(
    src: Memory<M>,
    dst: Register<Reg32>
) { movzx dst.r, src.at, word }

## `dst = src`, a word zero-extended into a quadword.
pub macro movzwq(
    src: Register<Reg16>,
    dst: Register<Reg>
) { movzx dst.r, src.r }
## `dst = src`, a word zero-extended into a quadword.
pub macro movzwq<M>(
    src: Memory<M>,
    dst: Register<Reg>
) { movzx dst.r, src.at, word }

## `dst = src`, a byte sign-extended into a word.
pub macro movsbw(
    src: Register<Reg8>,
    dst: Register<Reg16>
) { movsx dst.r, src.r }
## `dst = src`, a byte sign-extended into a word.
pub macro movsbw<M>(
    src: Memory<M>,
    dst: Register<Reg16>
) { movsx dst.r, src.at, byte }

## `dst = src`, a byte sign-extended into a long.
pub macro movsbl(
    src: Register<Reg8>,
    dst: Register<Reg32>
) { movsx dst.r, src.r }
## `dst = src`, a byte sign-extended into a long.
pub macro movsbl<M>(
    src: Memory<M>,
    dst: Register<Reg32>
) { movsx dst.r, src.at, byte }

## `dst = src`, a byte sign-extended into a quadword.
pub macro movsbq(src: Register<Reg8>, dst: Register<Reg>) { movsx dst.r, src.r }
## `dst = src`, a byte sign-extended into a quadword.
pub macro movsbq<M>(
    src: Memory<M>,
    dst: Register<Reg>
) { movsx dst.r, src.at, byte }

## `dst = src`, a word sign-extended into a long.
pub macro movswl(
    src: Register<Reg16>,
    dst: Register<Reg32>
) { movsx dst.r, src.r }
## `dst = src`, a word sign-extended into a long.
pub macro movswl<M>(
    src: Memory<M>,
    dst: Register<Reg32>
) { movsx dst.r, src.at, word }

## `dst = src`, a word sign-extended into a quadword.
pub macro movswq(
    src: Register<Reg16>,
    dst: Register<Reg>
) { movsx dst.r, src.r }
## `dst = src`, a word sign-extended into a quadword.
pub macro movswq<M>(
    src: Memory<M>,
    dst: Register<Reg>
) { movsx dst.r, src.at, word }

## `dst = src`, a long sign-extended into a quadword.
pub macro movslq(
    src: Register<Reg32>,
    dst: Register<Reg>
) { movsxd dst.r, src.r }
## `dst = src`, a long sign-extended into a quadword.
pub macro movslq<M>(src: Memory<M>, dst: Register<Reg>) { movsxd dst.r, src.at }

# =================
# lea
# =================

## `dst = the address of src`, without reading memory.
pub macro lea<M, R>(src: Memory<M>, dst: Register<R>) { lea dst.r, src.at }
## `lea` into a quadword register.
pub macro leaq<M>(src: Memory<M>, dst: Register<Reg>) { lea dst.r, src.at }
## `lea` into a long register.
pub macro leal<M>(src: Memory<M>, dst: Register<Reg32>) { lea dst.r, src.at }

# =================
# push, pop
# =================

## Pushes `src`.
pub macro push(src: Register<Reg>) { push src.r }
## Pushes `src`.
pub macro push(src: Register<Reg16>) { push src.r }
## Pushes `src`, sign-extended to 64 bits.
pub macro push(src: Imm) { push src.value }
## Pushes the quadword at `src`.
pub macro push(src: Memory<MemOperand>) { push src.at }
## Pushes `src`.
pub macro pushq(src: Register<Reg>) { push src.r }
## Pushes `src`, sign-extended to 64 bits.
pub macro pushq(src: Imm) { push src.value }
## Pushes the quadword at `src`.
pub macro pushq(src: Memory<MemOperand>) { push src.at }

## Pops into `dst`.
pub macro pop(dst: Register<Reg>) { pop dst.r }
## Pops into `dst`.
pub macro pop(dst: Register<Reg16>) { pop dst.r }
## Pops a quadword into `dst`.
pub macro pop(dst: Memory<MemOperand>) { pop dst.at }
## Pops into `dst`.
pub macro popq(dst: Register<Reg>) { pop dst.r }
## Pops a quadword into `dst`.
pub macro popq(dst: Memory<MemOperand>) { pop dst.at }

# =================
# indirect jmp and call
# =================
# A direct `jmp label` or `call label` is `std.x86_64.impl`'s own.

## Jumps to the address in a register: `jmp *%rax`.
pub macro jmp(target: Indirect<Register<Reg>>) { jmp target.through.r }
## Jumps to the address stored in memory: `jmp *8(%rsp)`.
pub macro jmp(target: Indirect<Memory<MemOperand>>) { jmp target.through.at }
## Calls the address in a register: `call *%rax`.
pub macro call(target: Indirect<Register<Reg>>) { call target.through.r }
## Calls the address stored in memory: `call *8(%rsp)`.
pub macro call(target: Indirect<Memory<MemOperand>>) { call target.through.at }

# =================
# string instructions and their prefixes
# =================

## `stosd`, under its AT&T name.
pub macro stosl() { stosd }
## `lodsd`, under its AT&T name.
pub macro lodsl() { lodsd }
## `movsd` (the string move), under its AT&T name.
pub macro movsl() { movsd }
## `cmpsd` (the string compare), under its AT&T name.
pub macro cmpsl() { cmpsd }
## `scasd`, under its AT&T name.
pub macro scasl() { scasd }

syntax rep() = { rep }
## Repeats `instruction` `rcx` times: `rep stosb`.
pub macro rep(instruction: macro())
    | syntax { rep $instruction$ }
{
    rep
    instruction
}

syntax repe() = { repe }
## Repeats `instruction` while equal, up to `rcx` times: `repe cmpsb`.
pub macro repe(instruction: macro())
    | syntax { repe $instruction$ }
{
    repe
    instruction
}

syntax repz() = { repz }
## `repe`, under another name.
pub macro repz(instruction: macro())
    | syntax { repz $instruction$ }
{
    repz
    instruction
}

syntax repne() = { repne }
## Repeats `instruction` while not equal, up to `rcx` times: `repne scasb`.
pub macro repne(instruction: macro())
    | syntax { repne $instruction$ }
{
    repne
    instruction
}

syntax repnz() = { repnz }
## `repne`, under another name.
pub macro repnz(instruction: macro())
    | syntax { repnz $instruction$ }
{
    repnz
    instruction
}
