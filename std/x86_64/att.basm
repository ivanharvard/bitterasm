# =================
# imul: one, two and three operands
# =================

## Signed multiply: `rdx:rax = rax * src` (or the smaller registers).
pub macro imul(src: Register<Reg>) { imul src.r }
pub macro imul(src: Register<Reg32>) { imul src.r }
pub macro imul(src: Register<Reg16>) { imul src.r }
pub macro imul(src: Register<Reg8>) { imul src.r }
## `dst = dst * src`, signed.
pub macro imul(src: Register<Reg>, dst: Register<Reg>) { imul dst.r, src.r }
pub macro imul(src: Register<Reg32>, dst: Register<Reg32>) { imul dst.r, src.r }
pub macro imul(src: Register<Reg16>, dst: Register<Reg16>) { imul dst.r, src.r }
## `dst = dst * src`, signed.
pub macro imul<R>(
    src: Memory<MemOperand>,
    dst: Register<R>
) { imul dst.r, src.at }
## `dst = src * imm`, signed.
pub macro imul<R>(
    imm: Imm,
    src: Register<R>,
    dst: Register<R>
) { imul dst.r, src.r, imm.value }
## `dst = [src] * imm`, signed.
pub macro imul<R>(
    imm: Imm,
    src: Memory<MemOperand>,
    dst: Register<R>
) { imul dst.r, src.at, imm.value }

# =================
# shifts and rotates: an immediate or `%cl` count
# =================

## `dst = dst << count`.
pub macro shl<R>(count: Imm, dst: Register<R>) { shl dst.r, count.value }
## `dst = dst << count`. `count` must be `%cl`.
pub macro shl<R>(count: Register<Reg8>, dst: Register<R>) { shl dst.r, count.r }
## Fails: a memory operand alone needs a size suffix, like `incq (%rdi)`.
pub macro shl(_count: Imm, _dst: Memory<MemOperand>) {
    @assert 0 == 1, "a memory operand alone needs a size suffix, like `incq (%rdi)`"
}
## Fails: a memory operand alone needs a size suffix, like `incq (%rdi)`.
pub macro shl(_count: Register<Reg8>, _dst: Memory<MemOperand>) {
    @assert 0 == 1, "a memory operand alone needs a size suffix, like `incq (%rdi)`"
}
## `shl` on a byte.
pub macro shlb(count: Imm, dst: Register<Reg8>) { shl dst.r, count.value }
## `shl` on a byte. `count` must be `%cl`.
pub macro shlb(
    count: Register<Reg8>,
    dst: Register<Reg8>
) { shl dst.r, count.r }
## `shl` on a byte.
pub macro shlb<M>(count: Imm, dst: Memory<M>) { shl dst.at, count.value, byte }
## `shl` on a byte. `count` must be `%cl`.
pub macro shlb<M>(
    count: Register<Reg8>,
    dst: Memory<M>
) { shl dst.at, count.r, byte }
## `shl` on a word.
pub macro shlw(count: Imm, dst: Register<Reg16>) { shl dst.r, count.value }
## `shl` on a word. `count` must be `%cl`.
pub macro shlw(
    count: Register<Reg8>,
    dst: Register<Reg16>
) { shl dst.r, count.r }
