#! AT&T-syntax x86-64 assembly, as GNU `as` reads it: source first,
#! destination second, `%` before registers and `$` before immediates.
#!
#! ```
#! from std.x86_64.att import *
#!
#! mov %rbx, %rax
#! mov 8(%rsp), %rax
#! add $1, %rax
#! ```
#!
#! ```bytes
#! 48 89 d8
#! 48 8b 44 24 08
#! 48 81 c0 01 00 00 00
#! ```
#!
#! Memory operands are `(%base)`, `disp(%base)`,
#! `disp(%base,%index,scale)` and `disp(%rip)`. Only 64-bit operands have
#! AT&T spellings, and mnemonics take no size suffix (`mov`, not `movq`).
#! Every instruction of `std.x86_64.impl` stays available in its explicit
#! form too: `mov rax, rbx, 0` for a 32-bit move.

pub from .impl import *

## Fails to compile unless `r` is a register number, 0 to 15. The
## instructions here use it to check their operands.
pub macro assert_valid_reg(r: Reg) {
    @assert r.value >= 0 && r.value <= 15, "not a valid register (0-15)"
}

# =================
# mov
# =================

syntax mov(a, b, c) = { mov $a$, $b$, $c$ }

## `rd = rs`.
pub macro mov(rs: Reg, rd: Reg)
    | syntax { mov %$rs$, %$rd$ } {
        assert_valid_reg rs
        mov rd, rs, 1
    }

# --- load direction: reg <- mem (source first in AT&T) ---

## Loads the value at `[base]` into `rd`.
pub macro mov_load_base(rd: Reg, base: Reg)
    | syntax { mov (%$base$), %$rd$ } {
        mov rd, Mem(base, 0), 1
    }

## Loads the value at `[base + disp]` into `rd`.
pub macro mov_load_base_disp(rd: Reg, disp: int, base: Reg)
    | syntax { mov $disp$(%$base$), %$rd$ } {
        mov rd, Mem(base, disp), 1
    }

## Loads the value at `[base + index * scale + disp]` into `rd`.
pub macro mov_load_indexed(
    rd: Reg,
    disp: int,
    base: Reg,
    index: Reg,
    scale: int
)
    | syntax { mov $disp$(%$base$,%$index$,$scale$), %$rd$ }
{
    mov rd, MemIndexed(base, index, scale, disp), 1
}

## Loads the value at `[rip + disp]`, `disp` bytes past the end of the
## instruction, into `rd`.
pub macro mov_load_rip(rd: Reg, disp: int)
    | syntax { mov $disp$(%rip), %$rd$ } {
        mov rd, MemRipRelative(disp), 1
    }

# --- store direction: mem <- reg (source first in AT&T) ---

## Stores `rs` at `[base]`.
pub macro mov_store_base(rs: Reg, base: Reg)
    | syntax { mov %$rs$, (%$base$) } {
        mov Mem(base, 0), rs, 1
    }

## Stores `rs` at `[base + disp]`.
pub macro mov_store_base_disp(rs: Reg, disp: int, base: Reg)
    | syntax { mov %$rs$, $disp$(%$base$) } {
        mov Mem(base, disp), rs, 1
    }

## Stores `rs` at `[base + index * scale + disp]`.
pub macro mov_store_indexed(
    rs: Reg,
    disp: int,
    base: Reg,
    index: Reg,
    scale: int
)
    | syntax { mov %$rs$, $disp$(%$base$,%$index$,$scale$) }
{
    mov MemIndexed(base, index, scale, disp), rs, 1
}

## Stores `rs` at `[rip + disp]`, `disp` bytes past the end of the
## instruction.
pub macro mov_store_rip(rs: Reg, disp: int)
    | syntax { mov %$rs$, $disp$(%rip) } {
        mov MemRipRelative(disp), rs, 1
    }

# =================
# ALU ops: add, or, and, sub, xor, cmp, test
# =================

syntax add(a, b, c) = { add $a$, $b$, $c$ }
## `rd = rd + rs`.
pub macro add(rs: Reg, rd: Reg)
    | syntax { add %$rs$, %$rd$ } {
        assert_valid_reg rs
        add rd, rs, 1
    }

syntax or(a, b, c) = { or $a$, $b$, $c$ }
## `rd = rd | rs`.
pub macro or(rs: Reg, rd: Reg)
    | syntax { or %$rs$, %$rd$ } {
        assert_valid_reg rs
        or rd, rs, 1
    }

syntax and(a, b, c) = { and $a$, $b$, $c$ }
## `rd = rd & rs`.
pub macro and(rs: Reg, rd: Reg)
    | syntax { and %$rs$, %$rd$ } {
        assert_valid_reg rs
        and rd, rs, 1
    }

syntax sub(a, b, c) = { sub $a$, $b$, $c$ }
## `rd = rd - rs`.
pub macro sub(rs: Reg, rd: Reg)
    | syntax { sub %$rs$, %$rd$ } {
        assert_valid_reg rs
        sub rd, rs, 1
    }

syntax xor(a, b, c) = { xor $a$, $b$, $c$ }
## `rd = rd ^ rs`.
pub macro xor(rs: Reg, rd: Reg)
    | syntax { xor %$rs$, %$rd$ } {
        assert_valid_reg rs
        xor rd, rs, 1
    }

syntax cmp(a, b, c) = { cmp $a$, $b$, $c$ }
## Sets the flags from `rd - rs`, without storing it.
pub macro cmp(rs: Reg, rd: Reg)
    | syntax { cmp %$rs$, %$rd$ } {
        assert_valid_reg rs
        cmp rd, rs, 1
    }

syntax test(a, b, c) = { test $a$, $b$, $c$ }
## Sets the flags from `rd & rs`, without storing it.
pub macro test(rs: Reg, rd: Reg)
    | syntax { test %$rs$, %$rd$ } {
        assert_valid_reg rs
        test rd, rs, 1
    }

# Immediate forms overload the same macros as register forms; the literal `$`
# in their patterns gives them ordinary AT&T `$imm, %dst` spelling.

## `rd = imm`.
pub macro mov(imm: int, rd: Reg)
    | syntax { mov \$$imm$, %$rd$ } { mov rd, imm, 1 }

## `rd = rd + imm`.
pub macro add(imm: int, rd: Reg)
    | syntax { add \$$imm$, %$rd$ } { add rd, imm, 1 }

## `rd = rd | imm`.
pub macro or(imm: int, rd: Reg)
    | syntax { or \$$imm$, %$rd$ } { or rd, imm, 1 }

## `rd = rd & imm`.
pub macro and(imm: int, rd: Reg)
    | syntax { and \$$imm$, %$rd$ } { and rd, imm, 1 }

## `rd = rd - imm`.
pub macro sub(imm: int, rd: Reg)
    | syntax { sub \$$imm$, %$rd$ } { sub rd, imm, 1 }

## `rd = rd ^ imm`.
pub macro xor(imm: int, rd: Reg)
    | syntax { xor \$$imm$, %$rd$ } { xor rd, imm, 1 }

## Sets the flags from `rd - imm`, without storing it.
pub macro cmp(imm: int, rd: Reg)
    | syntax { cmp \$$imm$, %$rd$ } { cmp rd, imm, 1 }

## Sets the flags from `rd & imm`, without storing it.
pub macro test(imm: int, rd: Reg)
    | syntax { test \$$imm$, %$rd$ } { test rd, imm, 1 }

# =================
# lea
# =================

## Loads the address `[base]` into `rd`, without reading memory.
pub macro lea_base(rd: Reg, base: Reg)
    | syntax { lea (%$base$), %$rd$ } {
        lea rd, Mem(base, 0), 1
    }

## Loads the address `[base + disp]` into `rd`, without reading memory.
pub macro lea_base_disp(rd: Reg, disp: int, base: Reg)
    | syntax { lea $disp$(%$base$), %$rd$ } {
        lea rd, Mem(base, disp), 1
    }

## Loads the address `[base + index * scale + disp]` into `rd`, without reading
## memory.
pub macro lea_indexed(rd: Reg, disp: int, base: Reg, index: Reg, scale: int)
    | syntax { lea $disp$(%$base$,%$index$,$scale$), %$rd$ }
{
    lea rd, MemIndexed(base, index, scale, disp), 1
}

## Loads the address `[rip + disp]`, `disp` bytes past the end of the
## instruction, into `rd`.
pub macro lea_rip(rd: Reg, disp: int)
    | syntax { lea $disp$(%rip), %$rd$ } {
        lea rd, MemRipRelative(disp), 1
    }

# =================
# shl/shr/sar
# =================

syntax shl(a, b, c) = { shl $a$, $b$, $c$ }
## `rd = rd << imm`.
pub macro shl(imm: int, rd: Reg)
    | syntax { shl \$$imm$, %$rd$ } { shl rd, imm, 1 }
## `rd = rd << cl`.
pub macro shl_cl(rd: Reg)
    | syntax { shl %cl, %$rd$ } { shl_cl rd, 1 }

syntax shr(a, b, c) = { shr $a$, $b$, $c$ }
## `rd = rd >> imm`, shifting in zeros.
pub macro shr_imm(imm: int, rd: Reg)
    | syntax { shr \$$imm$, %$rd$ } { shr rd, imm, 1 }
## `rd = rd >> cl`, shifting in zeros.
pub macro shr_cl(rd: Reg)
    | syntax { shr %cl, %$rd$ } { shr_cl rd, 1 }

syntax sar(a, b, c) = { sar $a$, $b$, $c$ }
## `rd = rd >> imm`, shifting in copies of the sign bit.
pub macro sar(imm: int, rd: Reg)
    | syntax { sar \$$imm$, %$rd$ } { sar rd, imm, 1 }
## `rd = rd >> cl`, shifting in copies of the sign bit.
pub macro sar_cl(rd: Reg)
    | syntax { sar %cl, %$rd$ } { sar_cl rd, 1 }

# =================
# push/pop, control flow, ret
# =================

syntax push(rd) = { push %$rd$ }
syntax pop(rd) = { pop %$rd$ }

syntax jmp(target) = { jmp $target$ }
syntax call(target) = { call $target$ }
syntax ret() = { ret }
syntax syscall() = { syscall }

syntax je(target) = { je $target$ }
syntax jne(target) = { jne $target$ }
syntax jb(target) = { jb $target$ }
syntax jae(target) = { jae $target$ }
syntax ja(target) = { ja $target$ }
syntax jbe(target) = { jbe $target$ }
syntax jl(target) = { jl $target$ }
syntax jge(target) = { jge $target$ }
syntax jle(target) = { jle $target$ }
syntax jg(target) = { jg $target$ }
syntax js(target) = { js $target$ }
syntax jns(target) = { jns $target$ }
syntax jo(target) = { jo $target$ }
syntax jno(target) = { jno $target$ }
syntax jp(target) = { jp $target$ }
syntax jnp(target) = { jnp $target$ }
syntax jz(target) = { jz $target$ }
syntax jnz(target) = { jnz $target$ }
syntax jc(target) = { jc $target$ }
syntax jnae(target) = { jnae $target$ }
syntax jnc(target) = { jnc $target$ }
syntax jnb(target) = { jnb $target$ }
syntax jnbe(target) = { jnbe $target$ }
syntax jna(target) = { jna $target$ }
syntax jnge(target) = { jnge $target$ }
syntax jnl(target) = { jnl $target$ }
syntax jng(target) = { jng $target$ }
syntax jnle(target) = { jnle $target$ }
syntax jpe(target) = { jpe $target$ }
syntax jpo(target) = { jpo $target$ }
