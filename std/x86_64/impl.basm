## Sets `rd` to 1 on signed overflow (OF = 1), else 0.
pub macro seto(rd: Reg8)
    | emits Bytes<...> { @emit digit_rm_instr(8, 0x0f90, 0, gpr(rd), 0, 0) }
## Sets the byte at `dst` to 1 on signed overflow (OF = 1), else 0.
pub macro seto(dst: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(8, 0x0f90, 0, dst, 0, 0) }
## `seto dst`; `size` must be `byte`.
pub macro seto(dst: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 8
    @emit digit_mem_instr(8, 0x0f90, 0, dst, 0, 0)
}
