# =================
# stack and control flow
# =================
# Indirect jumps and calls, `push`/`pop` beyond a 64-bit register, `ret`
# with a count, and the 8-bit-offset jumps (`loop`, `jrcxz`). In 64-bit
# mode the stack and jump targets are 64 bits wide by default, so none of
# these needs REX.W.

## Pushes the 16-bit `rd`.
pub macro push(rd: Reg16)
    | emits Bytes<...> { @emit reg_in_opcode_instr(16, 0x50, gpr(rd), 0, 0) }
## Pops 16 bits into `rd`.
pub macro pop(rd: Reg16)
    | emits Bytes<...> { @emit reg_in_opcode_instr(16, 0x58, gpr(rd), 0, 0) }
## Pushes `imm`, a 32-bit immediate sign-extended to 64 bits.
pub macro push(imm: int)
    | emits Bytes<...> { @emit imm_instr(0, 0x68, imm, 4) }
## Pushes the 64 bits at `src`.
pub macro push(src: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(32, 0xFF, 6, src, 0, 0) }
## Pushes the `size`-wide value at `src`: `qword` or `word`.
pub macro push(src: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    @assert size.bits == 64 || size.bits == 16, "push takes a qword or word"
    @emit digit_mem_instr(
        size.bits - 32 * (size.bits == 64),
        0xFF,
        6,
        src,
        0,
        0
    )
}
## Pops 64 bits into the memory at `dst`.
pub macro pop(dst: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(32, 0x8F, 0, dst, 0, 0) }
## Pops a `size`-wide value into the memory at `dst`: `qword` or `word`.
pub macro pop(dst: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    @assert size.bits == 64 || size.bits == 16, "pop takes a qword or word"
    @emit digit_mem_instr(
        size.bits - 32 * (size.bits == 64),
        0x8F,
        0,
        dst,
        0,
        0
    )
}
## Pushes `fs` or `gs`, the only segment registers 64-bit mode can push.
pub macro push(sr: SReg)
    | emits Bytes<...>
{
    @assert sr.num == 4 || sr.num == 5, "64-bit mode can only push fs and gs"
    @emit fixed(0x0FA0 + 8 * (sr.num == 5), 2)
}
## Pops `fs` or `gs`, the only segment registers 64-bit mode can pop.
pub macro pop(sr: SReg)
    | emits Bytes<...>
{
    @assert sr.num == 4 || sr.num == 5, "64-bit mode can only pop fs and gs"
    @emit fixed(0x0FA1 + 8 * (sr.num == 5), 2)
}

## Jumps to the address in `r`.
pub macro jmp(r: Reg)
    | emits Bytes<...> { @emit digit_rm_instr(32, 0xFF, 4, gpr(r), 0, 0) }
## Jumps to the address stored at `src`.
pub macro jmp(src: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(32, 0xFF, 4, src, 0, 0) }
## `jmp src`; `size` must be `qword`.
pub macro jmp(src: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 64
    @emit digit_mem_instr(32, 0xFF, 4, src, 0, 0)
}
## Calls the address in `r`.
pub macro call(r: Reg)
    | emits Bytes<...> { @emit digit_rm_instr(32, 0xFF, 2, gpr(r), 0, 0) }
## Calls the address stored at `src`.
pub macro call(src: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(32, 0xFF, 2, src, 0, 0) }
## `call src`; `size` must be `qword`.
pub macro call(src: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 64
    @emit digit_mem_instr(32, 0xFF, 2, src, 0, 0)
}
## Jumps to the far pointer at `src`: a 64-bit offset, then a 16-bit
## segment selector.
pub macro jmp_far(src: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(64, 0xFF, 5, src, 0, 0) }
## Calls the far pointer at `src`: a 64-bit offset, then a 16-bit segment
## selector.
pub macro call_far(src: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(64, 0xFF, 3, src, 0, 0) }

## Returns, then pops `n` more bytes.
pub macro ret(n: int)
    | emits Bytes<...> { @emit imm_instr(0, 0xC2, n, 2) }
## Returns from a far call.
pub macro retf()
    | emits Bytes<...> { @emit fixed(0xCB, 1) }
## Returns from a far call, then pops `n` more bytes.
pub macro retf(n: int)
    | emits Bytes<...> { @emit imm_instr(0, 0xCA, n, 2) }
## Makes a stack frame of `size` bytes, nested `level` deep.
pub macro enter(size: int, level: int)
    | emits Bytes<...> { @emit imm_instr(0, 0xC8, size | (level << 16), 3) }
## Undoes `enter`: `mov rsp, rbp`, then `pop rbp`.
pub macro leave()
    | emits Bytes<...> { @emit fixed(0xC9, 1) }
## Calls interrupt handler `n`. The dialects spell it `int n`; `int` itself
## names the integer type.
pub macro interrupt(n: int)
    | emits Bytes<...> { @emit imm_instr(0, 0xCD, n, 1) }

# 8-bit offsets. `bitter` packs the offset into 8 bits without checking
# that it fits, the way RISC-V's branch offsets are packed, so the target
# must be within -128 to 127 bytes of the next instruction.
## A short jump: an opcode and an 8-bit offset `bitter` works out.
pub struct Rel8Instr {
    ## The opcode.
    pub opcode: Byte,
    ## The offset from the next instruction to the target.
    pub rel8: Positioned<8>,
}

## A short jump with a prefix byte: `jecxz`.
pub struct Rel8Instr2 {
    ## The prefix.
    pub prefix: Byte,
    ## The opcode.
    pub opcode: Byte,
    ## The offset from the next instruction to the target.
    pub rel8: Positioned<8>,
}

macro rel8_instr(
    opcode: int,
    target: int
) -> Rel8Instr {
    @return Rel8Instr(
        opcode = Byte(opcode),
        rel8 = Positioned<8> { value: rel32_offset(target, 2) }
    )
}

## Decrements `rcx`, then jumps to the label `target` unless it's 0. `target`
## must be within 127 bytes.
pub macro loop(target: int)
    | emits Rel8Instr { @emit rel8_instr(0xe2, target) }
## Decrements `rcx`, then jumps to the label `target` if it isn't 0 and ZF = 1.
## `target` must be within 127 bytes.
pub macro loope(target: int)
    | emits Rel8Instr { @emit rel8_instr(0xe1, target) }
## `loope`, under another name. `target` must be within 127 bytes.
pub macro loopz(target: int)
    | emits Rel8Instr { @emit rel8_instr(0xe1, target) }
## Decrements `rcx`, then jumps to the label `target` if it isn't 0 and ZF = 0.
## `target` must be within 127 bytes.
pub macro loopne(target: int)
    | emits Rel8Instr { @emit rel8_instr(0xe0, target) }
## `loopne`, under another name. `target` must be within 127 bytes.
pub macro loopnz(target: int)
    | emits Rel8Instr { @emit rel8_instr(0xe0, target) }
## Jumps to the label `target` if `rcx` is 0. `target` must be within 127 bytes.
pub macro jrcxz(target: int)
    | emits Rel8Instr { @emit rel8_instr(0xe3, target) }
## Jumps to the label `target` if `ecx` is 0. `target` must be within 127
## bytes.
pub macro jecxz(target: int)
    | emits Rel8Instr2
{
    @emit Rel8Instr2(
        prefix = Byte(0x67),
        opcode = Byte(0xE3),
        rel8 = Positioned<8> { value: rel32_offset(target, 3) }
    )
}

# =================
# nop, ud0, ud1, out, lfs, lgs, lss
# =================

## Does nothing.
pub macro nop()
    | emits Bytes<...> { @emit fixed(0x90, 1) }
## Does nothing, in a longer encoding that names `rd`: for padding.
pub macro nop<R>(rd: R)
    | emits Bytes<...> { @emit ri(-1, 0x0F1F, 0, rd, 0, 0) }
## Does nothing, in a longer encoding that names `dst`: for padding.
pub macro nop(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(-1, 0x0F1F, 0, dst, 0, 0, size) }
## Raises an invalid-opcode exception.
pub macro ud0<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0fff, rd, rs, 0, 0) }
## Raises an invalid-opcode exception.
pub macro ud0<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fff, rd, src, 0, 0) }
## Raises an invalid-opcode exception.
pub macro ud1<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0fb9, rd, rs, 0, 0) }
## Raises an invalid-opcode exception.
pub macro ud1<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fb9, rd, src, 0, 0) }

# The accumulator, `al`, `ax` or `eax`, as an I/O port operand.
macro port_operand<R>(rs: R) -> Gpr {
    const s = gpr(rs)
    @assert s.num.value == 0 && s.rex != -1 && s.size <= 32, "the data register must be al, ax or eax"
    @return s
}

## Writes `rs` (`al`, `ax` or `eax`) to the I/O port in `port`, which must be
## `dx`.
pub macro out<R>(port: Reg16, rs: R)
    | emits Bytes<...>
{
    @assert port.reg.value == 2, "the port register must be dx"
    const s = port_operand(rs)
    @emit imm_instr(s.size == 16, sized_opcode(s.size, 0xEE, 0xEF), 0, 0)
}
## Writes `rs` (`al`, `ax` or `eax`) to I/O port `port`, 0 to 255.
pub macro out<R>(port: int, rs: R)
    | emits Bytes<...>
{
    const s = port_operand(rs)
    @emit imm_instr(s.size == 16, sized_opcode(s.size, 0xE6, 0xE7), port, 1)
}

## Loads the far pointer at `src` into `fs` and `rd`.
pub macro lfs<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fb4, rd, src, 0, 0) }
## Loads the far pointer at `src` into `gs` and `rd`.
pub macro lgs<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fb5, rd, src, 0, 0) }
## Loads the far pointer at `src` into `ss` and `rd`.
pub macro lss<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fb2, rd, src, 0, 0) }

# =================
# instructions with no operands
# =================
# Each is a fixed byte sequence. The string instructions name their size in
# a suffix (`movsb` to `movsq`) and work on `rsi`/`rdi`; the prefixes
# (`rep`, `lock`, ...) go on a line of their own, before the instruction
# they apply to.

## Clears the carry flag.
pub macro clc()
    | emits Bytes<...> { @emit fixed(0xf8, 1) }
## Sets the carry flag.
pub macro stc()
    | emits Bytes<...> { @emit fixed(0xf9, 1) }
## Flips the carry flag.
pub macro cmc()
    | emits Bytes<...> { @emit fixed(0xf5, 1) }
## Clears the direction flag, so string instructions count up.
pub macro cld()
    | emits Bytes<...> { @emit fixed(0xfc, 1) }
## Sets the direction flag, so string instructions count down.
pub macro std()
    | emits Bytes<...> { @emit fixed(0xfd, 1) }
## Clears the interrupt flag. Needs I/O privilege.
pub macro cli()
    | emits Bytes<...> { @emit fixed(0xfa, 1) }
## Sets the interrupt flag. Needs I/O privilege.
pub macro sti()
    | emits Bytes<...> { @emit fixed(0xfb, 1) }
## Sign-extends `al` into `ax`.
pub macro cbw()
    | emits Bytes<...> { @emit fixed(0x6698, 2) }
## Sign-extends `ax` into `eax`.
pub macro cwde()
    | emits Bytes<...> { @emit fixed(0x98, 1) }
## Sign-extends `eax` into `rax`.
pub macro cdqe()
    | emits Bytes<...> { @emit fixed(0x4898, 2) }
## Sign-extends `ax` into `dx:ax`.
pub macro cwd()
    | emits Bytes<...> { @emit fixed(0x6699, 2) }
## Sign-extends `eax` into `edx:eax`.
pub macro cdq()
    | emits Bytes<...> { @emit fixed(0x99, 1) }
## Sign-extends `rax` into `rdx:rax`.
pub macro cqo()
    | emits Bytes<...> { @emit fixed(0x4899, 2) }
## Loads the low byte of the flags into `ah`.
pub macro lahf()
    | emits Bytes<...> { @emit fixed(0x9f, 1) }
## Stores `ah` into the low byte of the flags.
pub macro sahf()
    | emits Bytes<...> { @emit fixed(0x9e, 1) }
## Pushes the flags.
pub macro pushf()
    | emits Bytes<...> { @emit fixed(0x9c, 1) }
## Pushes the flags.
pub macro pushfq()
    | emits Bytes<...> { @emit fixed(0x9c, 1) }
## Pops the flags.
pub macro popf()
    | emits Bytes<...> { @emit fixed(0x9d, 1) }
## Pops the flags.
pub macro popfq()
    | emits Bytes<...> { @emit fixed(0x9d, 1) }
## Hints that this is a spin-wait loop.
pub macro pause()
    | emits Bytes<...> { @emit fixed(0xf390, 2) }
## Raises an invalid-opcode exception.
pub macro ud2()
    | emits Bytes<...> { @emit fixed(0x0f0b, 2) }
## Reads processor identification and features, picked by `eax`.
pub macro cpuid()
    | emits Bytes<...> { @emit fixed(0x0fa2, 2) }
## Stops in a debugger.
pub macro int3()
    | emits Bytes<...> { @emit fixed(0xcc, 1) }
## Returns from an interrupt.
pub macro iret()
    | emits Bytes<...> { @emit fixed(0xcf, 1) }
## Returns from an interrupt.
pub macro iretd()
    | emits Bytes<...> { @emit fixed(0xcf, 1) }
## Returns from an interrupt, with 64-bit stack values.
pub macro iretq()
    | emits Bytes<...> { @emit fixed(0x48cf, 2) }
## `al = [rbx + al]`: looks `al` up in a table.
pub macro xlatb()
    | emits Bytes<...> { @emit fixed(0xd7, 1) }
## Repeats the next string instruction `rcx` times.
pub macro rep()
    | emits Bytes<...> { @emit fixed(0xf3, 1) }
## Repeats the next `cmps` or `scas` while equal, up to `rcx` times.
pub macro repe()
    | emits Bytes<...> { @emit fixed(0xf3, 1) }
## `repe`, under another name.
pub macro repz()
    | emits Bytes<...> { @emit fixed(0xf3, 1) }
## Repeats the next `cmps` or `scas` while not equal, up to `rcx` times.
pub macro repne()
    | emits Bytes<...> { @emit fixed(0xf2, 1) }
## `repne`, under another name.
pub macro repnz()
    | emits Bytes<...> { @emit fixed(0xf2, 1) }
## Makes the next instruction's memory access atomic.
pub macro lock()
    | emits Bytes<...> { @emit fixed(0xf0, 1) }

## Copies a byte from `[rsi]` to `[rdi]`, then steps both.
pub macro movsb()
    | emits Bytes<...> { @emit fixed(0xa4, 1) }
## Copies a word from `[rsi]` to `[rdi]`, then steps both.
pub macro movsw()
    | emits Bytes<...> { @emit fixed(0x66a5, 2) }
## Copies a doubleword from `[rsi]` to `[rdi]`, then steps both.
pub macro movsd()
    | emits Bytes<...> { @emit fixed(0xa5, 1) }
## Copies a quadword from `[rsi]` to `[rdi]`, then steps both.
pub macro movsq()
    | emits Bytes<...> { @emit fixed(0x48a5, 2) }
## Compares a byte at `[rsi]` and `[rdi]`, then steps both.
pub macro cmpsb()
    | emits Bytes<...> { @emit fixed(0xa6, 1) }
## Compares a word at `[rsi]` and `[rdi]`, then steps both.
pub macro cmpsw()
    | emits Bytes<...> { @emit fixed(0x66a7, 2) }
## Compares a doubleword at `[rsi]` and `[rdi]`, then steps both.
pub macro cmpsd()
    | emits Bytes<...> { @emit fixed(0xa7, 1) }
## Compares a quadword at `[rsi]` and `[rdi]`, then steps both.
pub macro cmpsq()
    | emits Bytes<...> { @emit fixed(0x48a7, 2) }
## Compares the accumulator with a byte at `[rdi]`, then steps it.
pub macro scasb()
    | emits Bytes<...> { @emit fixed(0xae, 1) }
## Compares the accumulator with a word at `[rdi]`, then steps it.
pub macro scasw()
    | emits Bytes<...> { @emit fixed(0x66af, 2) }
## Compares the accumulator with a doubleword at `[rdi]`, then steps it.
pub macro scasd()
    | emits Bytes<...> { @emit fixed(0xaf, 1) }
## Compares the accumulator with a quadword at `[rdi]`, then steps it.
pub macro scasq()
    | emits Bytes<...> { @emit fixed(0x48af, 2) }
## Loads a byte from `[rsi]` into the accumulator, then steps it.
pub macro lodsb()
    | emits Bytes<...> { @emit fixed(0xac, 1) }
## Loads a word from `[rsi]` into the accumulator, then steps it.
pub macro lodsw()
    | emits Bytes<...> { @emit fixed(0x66ad, 2) }
## Loads a doubleword from `[rsi]` into the accumulator, then steps it.
pub macro lodsd()
    | emits Bytes<...> { @emit fixed(0xad, 1) }
## Loads a quadword from `[rsi]` into the accumulator, then steps it.
pub macro lodsq()
    | emits Bytes<...> { @emit fixed(0x48ad, 2) }
## Stores the accumulator's low byte at `[rdi]`, then steps it.
pub macro stosb()
    | emits Bytes<...> { @emit fixed(0xaa, 1) }
## Stores the accumulator's low word at `[rdi]`, then steps it.
pub macro stosw()
    | emits Bytes<...> { @emit fixed(0x66ab, 2) }
## Stores the accumulator's low doubleword at `[rdi]`, then steps it.
pub macro stosd()
    | emits Bytes<...> { @emit fixed(0xab, 1) }
## Stores the accumulator's low quadword at `[rdi]`, then steps it.
pub macro stosq()
    | emits Bytes<...> { @emit fixed(0x48ab, 2) }
## Reads a byte from I/O port `dx` into `[rdi]`, then steps it.
pub macro insb()
    | emits Bytes<...> { @emit fixed(0x6c, 1) }
## Reads a word from I/O port `dx` into `[rdi]`, then steps it.
pub macro insw()
    | emits Bytes<...> { @emit fixed(0x666d, 2) }
## Reads a doubleword from I/O port `dx` into `[rdi]`, then steps it.
pub macro insd()
    | emits Bytes<...> { @emit fixed(0x6d, 1) }
## Writes a byte from `[rsi]` to I/O port `dx`, then steps it.
pub macro outsb()
    | emits Bytes<...> { @emit fixed(0x6e, 1) }
## Writes a word from `[rsi]` to I/O port `dx`, then steps it.
pub macro outsw()
    | emits Bytes<...> { @emit fixed(0x666f, 2) }
## Writes a doubleword from `[rsi]` to I/O port `dx`, then steps it.
pub macro outsd()
    | emits Bytes<...> { @emit fixed(0x6f, 1) }
