#! The x86-64 base instruction set: general-purpose registers, memory
#! operands, and the core integer instructions, each emitted as its machine
#! code.
#!
#! Coverage: 299 of 301 operand forms (99%), through `std.x86_64.nasm`.
#!
#! Import a dialect rather than this module: `std.x86_64.intel`,
#! `std.x86_64.nasm` or `std.x86_64.att`. Here every instruction takes its
#! operands in order, destination first. The operand size comes from the
#! register: `rax` is 64 bits, `eax` 32, `ax` 16 and `al` 8. A memory
#! operand with no register to size it takes a final `OperandSize`: `byte`,
#! `word`, `dword`, `qword`, or `oword` for `cmpxchg16b`.
#!
#! ```
#! from std.x86_64.impl import *
#!
#! mov rax, rbx
#! mov eax, Mem(rsp, 8)
#! add Mem(rbx, 0), 1, qword
#!
#! again:
#!     sub rcx, 1
#!     jne again
#! ```
#!
#! ```bytes
#! 48 89 d8
#! 8b 44 24 08
#! 48 81 03 01 00 00 00
#! 48 81 e9 01 00 00 00
#! 0f 85 f3 ff ff ff
#! ```
#!
#! The first instructions written here also have a form that takes the
#! size as a final `w` instead, 1 for 64 bits and 0 for 32, with every
#! register a `Reg`: `mov rax, rbx, 0` is `mov eax, ebx`. `std.x86_64.att`
#! uses those.
#!
#! Jumps and calls use a 32-bit offset, worked out by `bitter` once the
#! program is laid out; there's no automatic choice of the short form.
#! `loop`, `jrcxz` and `jecxz` have only the 8-bit one.

from std.binary import *
from std.bitfield import *
from std.bitter.deferred import *
from std.bitter.byte_order import *

# =================
# registers
# =================
# 16 general-purpose registers. An x86-64 register's 4-bit number is split
# across two different bytes: 3 bits in a ModRM/SIB field or opcode, plus 1
# extension bit in the REX prefix. The public, skipped backing value of
# `bits<4>` lets the helpers below extract those pieces while preserving `Reg`
# as a distinct, width-checked type.
## A register number, 0 to 15. As an operand it means the whole 64-bit
## register.
pub type Reg = bits<4>

@for i in 0..16 {
    ## A 64-bit general-purpose register. `r0` to `r7` are better known as
    ## `rax` to `rdi`.
    pub const r`i`: Reg = i
}

# Standard ABI names for the low 8 registers, aliased to the `rN` registers they
# name. r8-r15 have no separate ABI name and keep their numeric spelling.
## `r0`, the accumulator: where a function returns its result.
pub const rax = r0
## `r1`, the counter: a function's fourth argument.
pub const rcx = r1
## `r2`: a function's third argument.
pub const rdx = r2
## `r3`, saved across calls.
pub const rbx = r3
## `r4`, the stack pointer.
pub const rsp = r4
## `r5`, the frame pointer, saved across calls.
pub const rbp = r5
## `r6`: a function's second argument.
pub const rsi = r6
## `r7`: a function's first argument.
pub const rdi = r7

# The 32-bit views of the same 16 registers (`eax`, `r8d`, ...). Encoded with
# the same register number as their 64-bit counterpart — only the REX.W bit
# (the `w` argument every sized instruction below takes) tells them apart — so
# a `Reg32` just wraps the `Reg` it views. A struct rather than another
# `bits<4>` alias so it's a genuinely distinct type: dialects overload each
# mnemonic on `Reg` vs. `Reg32` and pick `w` from which one they got.
## The low 32 bits of a register. An instruction given one works on 32 bits
## instead of 64, and writing one zeroes the register's upper half.
pub struct Reg32 {
    ## The register it's the low half of.
    pub reg: Reg,
}

## The low 32 bits of `rax`.
pub const eax = Reg32(reg = rax)
## The low 32 bits of `rcx`.
pub const ecx = Reg32(reg = rcx)
## The low 32 bits of `rdx`.
pub const edx = Reg32(reg = rdx)
## The low 32 bits of `rbx`.
pub const ebx = Reg32(reg = rbx)
## The low 32 bits of `rsp`.
pub const esp = Reg32(reg = rsp)
## The low 32 bits of `rbp`.
pub const ebp = Reg32(reg = rbp)
## The low 32 bits of `rsi`.
pub const esi = Reg32(reg = rsi)
## The low 32 bits of `rdi`.
pub const edi = Reg32(reg = rdi)

## The low 32 bits of `r8`.
pub const r8d = Reg32(reg = r8)
## The low 32 bits of `r9`.
pub const r9d = Reg32(reg = r9)
## The low 32 bits of `r10`.
pub const r10d = Reg32(reg = r10)
## The low 32 bits of `r11`.
pub const r11d = Reg32(reg = r11)
## The low 32 bits of `r12`.
pub const r12d = Reg32(reg = r12)
## The low 32 bits of `r13`.
pub const r13d = Reg32(reg = r13)
## The low 32 bits of `r14`.
pub const r14d = Reg32(reg = r14)
## The low 32 bits of `r15`.
pub const r15d = Reg32(reg = r15)

# The 16- and 8-bit views. Like `Reg32`, each is its own struct so the
# instructions can overload on it, and pick the operand size from it.
## The low 16 bits of a register. An instruction given one works on 16
## bits, with a `0x66` prefix.
pub struct Reg16 {
    ## The register it's the low quarter of.
    pub reg: Reg,
}
## The low 16 bits of `rax`.
pub const ax = Reg16(reg = rax)
## The low 16 bits of `rcx`.
pub const cx = Reg16(reg = rcx)
## The low 16 bits of `rdx`.
pub const dx = Reg16(reg = rdx)
## The low 16 bits of `rbx`.
pub const bx = Reg16(reg = rbx)
## The low 16 bits of `rsp`.
pub const sp = Reg16(reg = rsp)
## The low 16 bits of `rbp`.
pub const bp = Reg16(reg = rbp)
## The low 16 bits of `rsi`.
pub const si = Reg16(reg = rsi)
## The low 16 bits of `rdi`.
pub const di = Reg16(reg = rdi)

@for i in 8..16 {
    ## The low 16 bits of `r8` to `r15`.
    pub const r`i`w = Reg16(reg = r`i`)
}

# `spl`, `bpl`, `sil` and `dil` share their numbers (4 to 7) with `ah`,
# `ch`, `dh` and `bh`: a REX prefix picks the first four, its absence the
# second. So `spl` always needs one, and `ah` can never have one.
## An 8-bit register: the low byte of a register, or for `ah`, `ch`, `dh`
## and `bh`, the byte above it.
pub struct Reg8 {
    ## The register number it's encoded with: `ah` is 4, like `spl`.
    pub reg: Reg,
    ## 1 for `ah`, `ch`, `dh` and `bh`, which can't be used in an
    ## instruction with a REX prefix; 0 otherwise.
    pub high: int,
}
## The low 8 bits of `rax`.
pub const al = Reg8(reg = rax, high = 0)
## The low 8 bits of `rcx`.
pub const cl = Reg8(reg = rcx, high = 0)
## The low 8 bits of `rdx`.
pub const dl = Reg8(reg = rdx, high = 0)
## The low 8 bits of `rbx`.
pub const bl = Reg8(reg = rbx, high = 0)
## The low 8 bits of `rsp`.
pub const spl = Reg8(reg = rsp, high = 0)
## The low 8 bits of `rbp`.
pub const bpl = Reg8(reg = rbp, high = 0)
## The low 8 bits of `rsi`.
pub const sil = Reg8(reg = rsi, high = 0)
## The low 8 bits of `rdi`.
pub const dil = Reg8(reg = rdi, high = 0)

@for i in 8..16 {
    ## The low 8 bits of `r8` to `r15`.
    pub const r`i`b = Reg8(reg = r`i`, high = 0)
}

## Bits 8 to 15 of `rax`.
pub const ah = Reg8(reg = rsp, high = 1)
## Bits 8 to 15 of `rcx`.
pub const ch = Reg8(reg = rbp, high = 1)
## Bits 8 to 15 of `rdx`.
pub const dh = Reg8(reg = rsi, high = 1)
## Bits 8 to 15 of `rbx`.
pub const bh = Reg8(reg = rdi, high = 1)

## A segment register. In 64-bit mode only `fs` and `gs` still have a base
## address of their own, usually for thread-local storage.
pub struct SReg {
    ## Its number: `es` 0, `cs` 1, `ss` 2, `ds` 3, `fs` 4, `gs` 5.
    pub num: int,
}

## The extra segment register.
pub const es = SReg(num = 0)
## The code segment register.
pub const cs = SReg(num = 1)
## The stack segment register.
pub const ss = SReg(num = 2)
## The data segment register.
pub const ds = SReg(num = 3)
## A segment register with a base address, used for thread-local storage.
pub const fs = SReg(num = 4)
## A segment register with a base address, used for thread-local storage.
pub const gs = SReg(num = 5)

# Every register type, as the instruction builders below see it. The
# instructions are generic over their register's type and call `gpr` to
# get its number and size, so one macro covers `rax`, `eax`, `ax` and `al`.
## A general-purpose register of any size, with what encoding it needs.
pub struct Gpr {
    ## The register number.
    pub num: Reg,
    ## The operand size in bits: 8, 16, 32 or 64.
    pub size: int,
    ## 1 if it needs a REX prefix (`spl`, `bpl`, `sil`, `dil`), -1 if it
    ## can't have one (`ah`, `ch`, `dh`, `bh`), 0 otherwise.
    pub rex: int,
}

## `r` as a 64-bit `Gpr`.
pub macro gpr(r: Reg) -> Gpr {
    @return Gpr(num = r, size = 64, rex = 0)
}
## `r` as a 32-bit `Gpr`.
pub macro gpr(r: Reg32) -> Gpr {
    @return Gpr(num = r.reg, size = 32, rex = 0)
}
## `r` as a 16-bit `Gpr`.
pub macro gpr(r: Reg16) -> Gpr {
    @return Gpr(num = r.reg, size = 16, rex = 0)
}
## `r` as an 8-bit `Gpr`.
pub macro gpr(r: Reg8) -> Gpr {
    @if r.high == 1 {
        @return Gpr(num = r.reg, size = 8, rex = -1)
    }
    @if r.reg.value >= 4 && r.reg.value <= 7 {
        @return Gpr(num = r.reg, size = 8, rex = 1)
    }
    @return Gpr(num = r.reg, size = 8, rex = 0)
}
## Fails: an `int` where an instruction expects a register.
pub macro gpr(_x: int) -> Gpr {
    @assert 0 == 1, "expected a register here"
    @return Gpr(num = r0, size = 0, rex = 0)
}
# Reached when a memory operand lands where a register was expected, as in
# `add [rbx], 1`, which has no register to give the operand size.
## Fails: a memory operand here needs its size written out.
pub macro gpr(_m: MemOperand) -> Gpr {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
    @return Gpr(num = r0, size = 0, rex = 0)
}

# The 3 low bits of a register number — the field width every ModRM `reg`/`rm`,
# SIB `index`/`base`, and register-in-opcode encoding actually carries.
## The low 3 bits of `r`'s number: the part a ModRM or SIB field, or an
## opcode, holds.
pub macro reg_field(r: Reg) -> int {
    @return slice(r.value, 2, 0)
}

# The register number's 4th bit — folded into the REX prefix (R/X/B) whenever
# the register is r8-r15, since the 3-bit fields above can't carry it.
## Bit 3 of `r`'s number, which goes in the REX prefix: 1 for `r8` to
## `r15`.
pub macro reg_ext(r: Reg) -> int {
    @return bit(r.value, 3)
}

# =================
# byte building blocks
# =================

## A byte.
pub type Byte = bits<8>

# A fixed-length run of bytes, meant to be `bitter`-packed directly.
# Deliberately its own copy rather than imported from `std.wasm.leb128`'s
# identical-looking `Bytes<N>` — a cross-domain dependency between an x86-64
# package and a WASM one — the same duplication `std/riscv/impl.basm`'s own
# field-width aliases already embrace for self-documentation (see its own
# comment on `Funct7`/`Imm7`).
## `N` bytes, packed by `bitter` in order: an instruction's encoding.
pub struct Bytes<const N: int>
    | invariant N >= 0
{
    @for i in 0..N {
        pub __el`i`: Byte,
    }
}

# REX prefix byte: `0100WRXB`. `w` selects 64-bit operand size; `r`/`x`/`b` are
# the extension bits for, respectively, ModRM.reg, SIB.index, and
# ModRM.rm/SIB.base/an opcode-embedded register. Every argument is a plain 0/1
# `int`, not a `bits<1>` — see `reg_ext` above for why x86 fields stay plain
# `int` until the final byte.
## A REX prefix, `0100WRXB`. `w` selects 64-bit operands; `r`, `x` and `b`
## are bit 3 of the ModRM.reg, SIB.index and ModRM.rm (or SIB.base, or
## opcode) register numbers.
pub macro rex_byte(
    w: int,
    r: int,
    x: int,
    b: int
) -> Byte {
    @return Byte(0b0100_0000 | (w << 3) | (r << 2) | (x << 1) | b)
}

# ModRM byte: `mod` (2 bits), `reg` (3 bits, a register or an opcode-extension
# digit depending on the instruction), `rm` (3 bits, a register or the start of
# a memory addressing form).
## A ModRM byte: `mod` (2 bits), `reg` (3) and `rm` (3).
pub macro modrm_byte(
    mod: int,
    reg: int,
    rm: int
) -> Byte {
    @return Byte(place(mod, 7, 6) | place(reg, 5, 3) | place(rm, 2, 0))
}

# SIB byte: `scale` (2 bits, log2 of the index's multiplier), `index` (3 bits),
# `base` (3 bits). Only present when a ModRM byte's `rm` field is `0b100`.
## A SIB byte: `scale` (2 bits, log2 of the index's multiplier), `index`
## (3) and `base` (3).
pub macro sib_byte(
    scale: int,
    index: int,
    base: int
) -> Byte {
    @return Byte(place(scale, 7, 6) | place(index, 5, 3) | place(base, 2, 0))
}

# Little-endian byte `index` (0 = least significant) of `value`, for any width —
# reused for every immediate and displacement, whatever their byte count.
## Byte `index` of `value`, counting from the least significant, byte 0.
pub macro byte_of(
    value: int,
    index: int
) -> Byte {
    @return field(value, 8 * index + 7, 8 * index)
}

# =================
# operand sizes
# =================

## An operand size, for an instruction whose memory operand has no
## register to give it one, as in `add qword [rbx], 1`.
pub struct OperandSize {
    ## The size in bits.
    pub bits: int,
}

## 8 bits.
pub const byte = OperandSize(bits = 8)
## 16 bits.
pub const word = OperandSize(bits = 16)
## 32 bits.
pub const dword = OperandSize(bits = 32)
## 64 bits.
pub const qword = OperandSize(bits = 64)
## 128 bits, for `cmpxchg16b`.
pub const oword = OperandSize(bits = 128)

# The forms that take `w` (1 for 64-bit, 0 for 32-bit) instead of a sized
# register: `w`'s operand size.
macro w_size(w: int) -> int {
    @return 32 + 32 * w
}

# Register-direct forms with `w`: opcode + ModRM `mod=11`, ModRM.rm = `rd`,
# ModRM.reg = `rs` (the "r/m, r" direction, as `0x89`-style opcodes read).
macro reg_reg_instr(
    opcode: int,
    rd: Reg,
    rs: Reg,
    w: int
) -> Bytes<...> {
    @return reg_rm_instr(w_size(w), opcode, gpr(rs), gpr(rd), 0, 0)
}

# reg,imm and shift forms with `w`: ModRM.reg holds the opcode's `digit`.
macro reg_imm_instr(
    opcode: int,
    digit: int,
    rd: Reg,
    imm: int,
    imm_len: int,
    w: int
) -> Bytes<...> {
    @return digit_rm_instr(w_size(w), opcode, digit, gpr(rd), imm, imm_len)
}

# =================
# mov
# =================
# The forms with `w`. Their reg,reg opcodes are the "r/m, r" direction
# (`0x89`: ModRM.rm is the destination, ModRM.reg the source). With
# `mod=11` the "r, r/m" opcode would decode the same; this one matches the
# Intel manual's usual listing.
## `rd = rs`.
pub macro mov(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...>
{
    @emit reg_reg_instr(0x89, rd, rs, w)
}

# `mov reg, imm` (`0xB8+reg`) folds the destination register into the
# opcode's own low 3 bits instead of a ModRM byte, so it can't share
# `reg_imm_instr`'s shape. Its immediate is width-dependent in a way no
# other instruction here is: with `REX.W` set, `0xB8+reg` takes a full
# 8-byte imm64 (not a sign-extended imm32 like every other `w=1` form in
# this file) — confirmed against the Intel SDM's own `MOV` opcode table.
## `rd = imm`. With `w` = 1 it takes a full 64-bit `imm`.
pub macro mov(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...>
{
    @emit reg_in_opcode_instr(w_size(w), 0xB8, gpr(rd), imm, 4 + 4 * w)
}

# =================
# ALU ops: add, or, and, sub, xor, cmp
# =================
# reg,reg (opcode + ModRM `mod=11`) and reg,imm32 (`0x81 /digit`) forms,
# with `w`. Each mnemonic differs only in its opcode byte or digit.

## `rd = rd + rs`.
pub macro add(
    rd: Reg,
    rs: Reg,
    w: int
) | emits Bytes<...> { 
    @emit reg_reg_instr(0x01, rd, rs, w) 
}
## `rd = rd | rs`.
pub macro or(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_reg_instr(0x09, rd, rs, w) }
## `rd = rd & rs`.
pub macro and(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_reg_instr(0x21, rd, rs, w) }
## `rd = rd - rs`.
pub macro sub(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_reg_instr(0x29, rd, rs, w) }
## `rd = rd ^ rs`.
pub macro xor(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_reg_instr(0x31, rd, rs, w) }
## Sets the flags from `rd - rs`, without storing it.
pub macro cmp(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_reg_instr(0x39, rd, rs, w) }

# reg,imm32 forms overload their reg,reg counterparts. `Reg` is a distinct
# `bits<4>` type, so the resolver selects the encoding by operand type.
## `rd = rd + imm`, with a 32-bit `imm` sign-extended to 64 bits.
pub macro add(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0x81, 0, rd, imm, 4, w) }
## `rd = rd | imm`, with a 32-bit `imm` sign-extended to 64 bits.
pub macro or(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0x81, 1, rd, imm, 4, w) }
## `rd = rd & imm`, with a 32-bit `imm` sign-extended to 64 bits.
pub macro and(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0x81, 4, rd, imm, 4, w) }
## `rd = rd - imm`, with a 32-bit `imm` sign-extended to 64 bits.
pub macro sub(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0x81, 5, rd, imm, 4, w) }
## `rd = rd ^ imm`, with a 32-bit `imm` sign-extended to 64 bits.
pub macro xor(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0x81, 6, rd, imm, 4, w) }
## Sets the flags from `rd - imm`, without storing it.
pub macro cmp(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0x81, 7, rd, imm, 4, w) }

# =================
# test
# =================
## Sets the flags from `rd & rs`, without storing it.
pub macro test(
    rd: Reg,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_reg_instr(0x85, rd, rs, w) }
## Sets the flags from `rd & imm`, without storing it.
pub macro test(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xF7, 0, rd, imm, 4, w) }

# =================
# memory operands
# =================
# Three named constructors, not one giant optional-everything struct — `Mem`
# (`[base]`/`[base+disp]`), `MemIndexed` (`[base+index*scale+disp]`), and
# `MemRipRelative` (`[rip+disp]`), matching the three memory forms this package
# supports (no bare `[disp32]` absolute addressing — that would need a fourth,
# index-less "no base" constructor nothing here asks for). Each wraps its own
# field struct in one `MemOperand` enum variant so every reg/mem- accepting
# instruction below only ever needs to overload on the one `MemOperand` type,
# never on which constructor built it — `addr_mode` below is the only place that
# ever inspects which variant a given value actually is.
## `[base + disp]`. `Mem` builds one.
pub struct MemBase {
    ## The base register.
    pub base: Reg,
    ## The displacement added to it.
    pub disp: int,
}

## `[base + index * scale + disp]`. `MemIndexed` builds one.
pub struct MemSib {
    ## The base register.
    pub base: Reg,
    ## The index register.
    pub index: Reg,
    ## The index's multiplier: 1, 2, 4 or 8.
    pub scale: int,
    ## The displacement.
    pub disp: int,
}

## `[rip + disp]`. `MemRipRelative` builds one.
pub struct MemRip {
    ## The displacement from the end of the instruction.
    pub disp: int,
}

## A memory operand, built by `Mem`, `MemIndexed` or `MemRipRelative`.
pub enum MemOperand {
    ## `[base + disp]`.
    Base: MemBase,
    ## `[base + index * scale + disp]`.
    Indexed: MemSib,
    ## `[rip + disp]`.
    RipRelative: MemRip,
}

## The memory at `[base + disp]`. A displacement from -128 to 127 takes one
## byte; any other takes four.
pub macro Mem(
    base: Reg,
    disp: int
) -> MemOperand {
    @return MemOperand.Base(MemBase(base = base, disp = disp))
}

## The memory at `[base + index * scale + disp]`. `scale` is 1, 2, 4 or 8,
## and `index` can be any register but `rsp`.
##
## ```
## from std.x86_64.impl import *
##
## mov rax, MemIndexed(rbx, r12, 4, 0), 1
## ```
##
## ```bytes
## 4a 8b 04 a3
## ```
##
## ```fail
## from std.x86_64.impl import *
##
## mov rax, MemIndexed(rbx, rsp, 4, 0), 1
## ```
##
## ```error
## rsp cannot be a SIB index register
## ```
pub macro MemIndexed(
    base: Reg,
    index: Reg,
    scale: int,
    disp: int
) -> MemOperand {
    @assert scale == 1 || scale == 2 || scale == 4 || scale == 8, "SIB scale must be 1, 2, 4, or 8"
    # SIB.index = 100 means "no index", but REX.X tells `r12` (1100) apart
    # from `rsp` (0100), so only `rsp` itself can't be an index.
    @assert index.value != 4, "rsp cannot be a SIB index register"
    @return MemOperand.Indexed(MemSib(
            base = base,
            index = index,
            scale = scale,
            disp = disp
    ))
}

## The memory at `[rip + disp]`: `disp` bytes past the end of the
## instruction. To address a label, use a `RipLabel` instead.
pub macro MemRipRelative(disp: int) -> MemOperand {
    @return MemOperand.RipRelative(MemRip(disp = disp))
}

# SIB.scale is the *log2* of the actual multiplier — `MemIndexed` takes the real
# multiplier (1/2/4/8) since that's what every Intel-syntax
# `[base+index*N+disp]` writes literally, and `@assert`s it's one of those four
# up front so this never sees anything else.
macro scale_code(scale: int) -> int {
    @if scale == 1 { @return 0b00 }
    @if scale == 2 { @return 0b01 }
    @if scale == 4 { @return 0b10 }
    @return 0b11
}

# disp8 vs disp32 is chosen automatically from the displacement's own magnitude
# — pure encoding-size selection with no semantic difference (unlike the branch-
# relaxation this repo deliberately keeps manual), the same
# `uleb128_length`-style "let the value's own magnitude pick the encoding"
# reasoning `std/wasm/leb128.basm` already uses.
macro fits_disp8(disp: int) -> int {
    @return disp >= -128 && disp <= 127
}

# Every field `addr_mode` below needs to hand back to its caller in one shot:
# the ModRM `mod`/`rm` pair, whether a SIB byte follows (and its value), the
# displacement's value and byte count (0, 1, or 4), and the REX.X/REX.B
# extension bits a memory operand's index/base registers may need — a macro can
# only ever `@return` one value, so these all travel together as one struct
# instead of one macro per field.
struct AddrMode {
    pub mode: int,
    pub rm: int,
    pub has_sib: int,
    pub sib: Byte,
    pub disp: int,
    pub disp_len: int,
    pub rex_x: int,
    pub rex_b: int,
}

# The actual addressing-mode selection logic — `mod`/`rm`/SIB selection:
# - `mod=11` register-direct doesn't appear here at all (`reg_reg_instr`/
# `reg_imm_instr` already cover it; `MemOperand` only ever models a true memory
# operand).
# - A base register whose low 3 bits are `0b100` (`rsp`/`r12`) can never be
# ModRM's `rm` directly — `rm=100` always means "read a SIB byte instead" — so
# `Mem` with such a base is *always* routed through a SIB byte with
# `index=0b100` ("no index"), never through the plain non-SIB path below.
# - A base register whose low 3 bits are `0b101` (`rbp`/`r13`) combined with
# `mod=00` doesn't mean "no displacement" the way every other register does — it
# means RIP-relative (no base register at all) or, inside a SIB byte, "no base,
# disp32 only". The only way to address `[rbp]`/`[r13]` (or a SIB base of
# `rbp`/`r13`) with a *literal* zero displacement is therefore to force `mod=01`
# with an explicit `disp8=0` — never `mod=00`. A non-zero displacement never
# hits this ambiguity in the first place (`mod` is already `01`/`10` on its own
# account), so the forcing only ever applies in the `disp==0` case.
macro addr_mode(mem: MemOperand) -> AddrMode {
    @match mem {
        Base(fields) => {
            const base_low3 = reg_field(fields.base)
            @if base_low3 == 0b100 {
                const sib = sib_byte(0b00, 0b100, base_low3)
                @if fields.disp == 0 {
                    @return AddrMode(
                        mode = 0b00,
                        rm = 0b100,
                        has_sib = 1,
                        sib = sib,
                        disp = 0,
                        disp_len = 0,
                        rex_x = 0,
                        rex_b = reg_ext(fields.base)
                    )
                }
                @if fits_disp8(fields.disp) {
                    @return AddrMode(
                        mode = 0b01,
                        rm = 0b100,
                        has_sib = 1,
                        sib = sib,
                        disp = fields.disp,
                        disp_len = 1,
                        rex_x = 0,
                        rex_b = reg_ext(fields.base)
                    )
                }
                @return AddrMode(
                    mode = 0b10,
                    rm = 0b100,
                    has_sib = 1,
                    sib = sib,
                    disp = fields.disp,
                    disp_len = 4,
                    rex_x = 0,
                    rex_b = reg_ext(fields.base)
                )
            }
            @if base_low3 == 0b101 && fields.disp == 0 {
                @return AddrMode(
                    mode = 0b01,
                    rm = 0b101,
                    has_sib = 0,
                    sib = Byte(0),
                    disp = 0,
                    disp_len = 1,
                    rex_x = 0,
                    rex_b = reg_ext(fields.base)
                )
            }
            @if fields.disp == 0 {
                @return AddrMode(
                    mode = 0b00,
                    rm = base_low3,
                    has_sib = 0,
                    sib = Byte(0),
                    disp = 0,
                    disp_len = 0,
                    rex_x = 0,
                    rex_b = reg_ext(fields.base)
                )
            }
            @if fits_disp8(fields.disp) {
                @return AddrMode(
                    mode = 0b01,
                    rm = base_low3,
                    has_sib = 0,
                    sib = Byte(0),
                    disp = fields.disp,
                    disp_len = 1,
                    rex_x = 0,
                    rex_b = reg_ext(fields.base)
                )
            }
            @return AddrMode(
                mode = 0b10,
                rm = base_low3,
                has_sib = 0,
                sib = Byte(0),
                disp = fields.disp,
                disp_len = 4,
                rex_x = 0,
                rex_b = reg_ext(fields.base)
            )
        },
        Indexed(fields) => {
            const base_low3 = reg_field(fields.base)
            const sib = sib_byte(
                scale_code(fields.scale),
                reg_field(fields.index),
                base_low3
            )
            @if base_low3 == 0b101 && fields.disp == 0 {
                @return AddrMode(
                    mode = 0b01,
                    rm = 0b100,
                    has_sib = 1,
                    sib = sib,
                    disp = 0,
                    disp_len = 1,
                    rex_x = reg_ext(fields.index),
                    rex_b = reg_ext(fields.base)
                )
            }
            @if fields.disp == 0 {
                @return AddrMode(
                    mode = 0b00,
                    rm = 0b100,
                    has_sib = 1,
                    sib = sib,
                    disp = 0,
                    disp_len = 0,
                    rex_x = reg_ext(fields.index),
                    rex_b = reg_ext(fields.base)
                )
            }
            @if fits_disp8(fields.disp) {
                @return AddrMode(
                    mode = 0b01,
                    rm = 0b100,
                    has_sib = 1,
                    sib = sib,
                    disp = fields.disp,
                    disp_len = 1,
                    rex_x = reg_ext(fields.index),
                    rex_b = reg_ext(fields.base)
                )
            }
            @return AddrMode(
                mode = 0b10,
                rm = 0b100,
                has_sib = 1,
                sib = sib,
                disp = fields.disp,
                disp_len = 4,
                rex_x = reg_ext(fields.index),
                rex_b = reg_ext(fields.base)
            )
        },
        RipRelative(fields) => {
            @return AddrMode(
                mode = 0b00,
                rm = 0b101,
                has_sib = 0,
                sib = Byte(0),
                disp = fields.disp,
                disp_len = 4,
                rex_x = 0,
                rex_b = 0
            )
        }
    }
}

# =================
# instruction builder
# =================
# Every instruction here is some subset of
#
# [66] [REX] [0F] opcode [ModRM [SIB] [disp]] [imm]
#
# `Encoding` says which parts are there, `encoding_byte` picks byte `index`
# out of that shape, and `encoding_bytes` builds the whole `Bytes<N>`.

struct Encoding {
    # 1 for the `0x66` operand-size prefix, which makes an instruction 16-bit.
    pub prefix: int,
    pub need_rex: int,
    pub rex: Byte,
    # 1 for a two-byte opcode, `0x0F` then `opcode`.
    pub escape: int,
    pub opcode: Byte,
    pub has_modrm: int,
    pub modrm: Byte,
    pub has_sib: int,
    pub sib: Byte,
    pub disp: int,
    pub disp_len: int,
    pub imm: int,
    pub imm_len: int,
}

macro encoding_byte(
    e: Encoding,
    index: int
) -> Byte {
    @if index < e.prefix {
        @return Byte(0x66)
    }
    const after_prefix = index - e.prefix
    @if after_prefix < e.need_rex {
        @return e.rex
    }
    const after_rex = after_prefix - e.need_rex
    @if after_rex < e.escape {
        @return Byte(0x0F)
    }
    const after_escape = after_rex - e.escape
    @if after_escape == 0 {
        @return e.opcode
    }
    const after_opcode = after_escape - 1
    @if after_opcode < e.has_modrm {
        @return e.modrm
    }
    const after_modrm = after_opcode - e.has_modrm
    @if after_modrm < e.has_sib {
        @return e.sib
    }
    const after_sib = after_modrm - e.has_sib
    @if after_sib < e.disp_len {
        @return byte_of(e.disp, after_sib)
    }
    @return byte_of(e.imm, after_sib - e.disp_len)
}

macro encoding_bytes(e: Encoding) -> Bytes<...> {
    const n = e.prefix + e.need_rex + e.escape + 1 + e.has_modrm + e.has_sib + e.disp_len + e.imm_len
    @return Bytes<n> {
        @for i in 0..n {
            __el`i`: encoding_byte(e, i),
        }
    }
}

# An instruction with a ModRM byte.
# - `size`: the operand size in bits. 16 adds the `0x66` prefix and 64 sets
# REX.W; 8 and 32 need neither, since 8-bit forms have opcodes of their
# own.
# - `opcode`: one byte, or `0x0Fxx` for the two-byte opcode `0F xx`.
# - `reg`: the ModRM.reg value, a register number (0 to 15) or the opcode's
# digit (0 to 7).
# - `need` / `forbid`: 1 if a register operand needs a REX prefix (`spl`)
# or can't have one (`ah`).
macro modrm_instr(
    size: int,
    opcode: int,
    reg: int,
    need: int,
    forbid: int,
    addr: AddrMode,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    const w = size == 64
    const r = bit(reg, 3)
    const need_rex = w || r == 1 || addr.rex_x == 1 || addr.rex_b == 1 || need == 1
    @assert !(need_rex && forbid == 1), "ah, ch, dh and bh can't be used in an instruction that needs a REX prefix"
    @return encoding_bytes(Encoding(
            prefix = size == 16,
            need_rex = need_rex,
            rex = rex_byte(w, r, addr.rex_x, addr.rex_b),
            escape = opcode > 0xFF,
            opcode = Byte(opcode & 0xFF),
            has_modrm = 1,
            modrm = modrm_byte(addr.mode, reg & 0b111, addr.rm),
            has_sib = addr.has_sib,
            sib = addr.sib,
            disp = addr.disp,
            disp_len = addr.disp_len,
            imm = imm,
            imm_len = imm_len
    ))
}

# Register-direct addressing for `r`: ModRM `mod=11`.
macro direct(r: Gpr) -> AddrMode {
    @return AddrMode(
        mode = 0b11,
        rm = reg_field(r.num),
        has_sib = 0,
        sib = Byte(0),
        disp = 0,
        disp_len = 0,
        rex_x = 0,
        rex_b = reg_ext(r.num)
    )
}

# The four ModRM shapes: ModRM.reg is a register `r` or a `digit`, and
# ModRM.rm is a register `rm` or a memory operand `mem`.
macro reg_rm_instr(
    size: int,
    opcode: int,
    r: Gpr,
    rm: Gpr,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    @return modrm_instr(
        size,
        opcode,
        r.num.value,
        r.rex == 1 || rm.rex == 1,
        r.rex == -1 || rm.rex == -1,
        direct(rm),
        imm,
        imm_len
    )
}

macro reg_mem_instr(
    size: int,
    opcode: int,
    r: Gpr,
    mem: MemOperand,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    @return modrm_instr(
        size,
        opcode,
        r.num.value,
        r.rex == 1,
        r.rex == -1,
        addr_mode(mem),
        imm,
        imm_len
    )
}

macro digit_rm_instr(
    size: int,
    opcode: int,
    digit: int,
    rm: Gpr,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    @return modrm_instr(
        size,
        opcode,
        digit,
        rm.rex == 1,
        rm.rex == -1,
        direct(rm),
        imm,
        imm_len
    )
}

macro digit_mem_instr(
    size: int,
    opcode: int,
    digit: int,
    mem: MemOperand,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    @return modrm_instr(size, opcode, digit, 0, 0, addr_mode(mem), imm, imm_len)
}

# An instruction with its register in the opcode's low 3 bits and no
# ModRM byte: `push`, `pop`, `mov reg, imm`, `bswap`.
macro reg_in_opcode_instr(
    size: int,
    opcode: int,
    r: Gpr,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    const w = size == 64
    const need_rex = w || reg_ext(r.num) == 1 || r.rex == 1
    @assert !(need_rex && r.rex == -1), "ah, ch, dh and bh can't be used in an instruction that needs a REX prefix"
    @return encoding_bytes(Encoding(
            prefix = size == 16,
            need_rex = need_rex,
            rex = rex_byte(w, 0, 0, reg_ext(r.num)),
            escape = opcode > 0xFF,
            opcode = Byte((opcode & 0xFF) + reg_field(r.num)),
            has_modrm = 0,
            modrm = Byte(0),
            has_sib = 0,
            sib = Byte(0),
            disp = 0,
            disp_len = 0,
            imm = imm,
            imm_len = imm_len
    ))
}

# `len` fixed bytes, written as one number, most significant byte first:
# `fixed(0x4899, 2)` is `48 99`.
macro fixed(
    value: int,
    len: int
) -> Bytes<...> {
    @return Bytes<len> {
        @for i in 0..len {
            __el`i`: byte_of(value, len - 1 - i),
        }
    }
}

# The opcode for `size`: most instructions have a separate 8-bit one.
macro sized(
    size: int,
    op8: int,
    op: int
) -> int {
    @if size == 8 {
        @return op8
    }
    @return op
}

# An immediate's length in bytes for `size`. A 64-bit operation takes a
# 32-bit immediate, sign-extended.
macro imm_len_of(size: int) -> int {
    @if size == 8 {
        @return 1
    }
    @if size == 16 {
        @return 2
    }
    @return 4
}

# Memory forms with `w`: ModRM.reg = `rs`, ModRM.rm (+ SIB + disp) = `dst`.
macro mem_reg_instr(
    opcode: int,
    dst: MemOperand,
    rs: Reg,
    w: int
) -> Bytes<...> {
    @return reg_mem_instr(w_size(w), opcode, gpr(rs), dst, 0, 0)
}

# Memory forms with `w` and a 32-bit immediate: ModRM.reg = `digit`.
macro mem_imm_instr(
    opcode: int,
    digit: int,
    dst: MemOperand,
    imm: int,
    w: int
) -> Bytes<...> {
    @return digit_mem_instr(w_size(w), opcode, digit, dst, imm, 4)
}

# =================
# mov/ALU ops/test: memory-operand overloads
# =================
# Memory forms with `w`, overloaded on `MemOperand`, a type distinct from
# both `Reg` and `int`.
## Stores `rs` at `dst`.
pub macro mov(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x89, dst, rs, w) }

# The load direction, `0x8B` ("r, r/m"): ModRM.reg is the destination.
## Loads the value at `src` into `rd`.
pub macro mov(
    rd: Reg,
    src: MemOperand,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x8B, src, rd, w) }

## `[dst] = [dst] + rs`.
pub macro add(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x01, dst, rs, w) }
## `[dst] = [dst] | rs`.
pub macro or(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x09, dst, rs, w) }
## `[dst] = [dst] & rs`.
pub macro and(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x21, dst, rs, w) }
## `[dst] = [dst] - rs`.
pub macro sub(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x29, dst, rs, w) }
## `[dst] = [dst] ^ rs`.
pub macro xor(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x31, dst, rs, w) }
## Sets the flags from `[dst] - rs`, without storing it.
pub macro cmp(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x39, dst, rs, w) }
## Sets the flags from `[dst] & rs`, without storing it.
pub macro test(
    dst: MemOperand,
    rs: Reg,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x85, dst, rs, w) }

# `0xC7 /0`, not `0xB8+reg` — see `mem_imm_instr`'s own comment above.
## Stores `imm` at `dst`: 32 bits, sign-extended to 64 when `w` is 1.
pub macro mov(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0xC7, 0, dst, imm, w) }
## `[dst] = [dst] + imm`, with a 32-bit `imm`.
pub macro add(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0x81, 0, dst, imm, w) }
## `[dst] = [dst] | imm`, with a 32-bit `imm`.
pub macro or(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0x81, 1, dst, imm, w) }
## `[dst] = [dst] & imm`, with a 32-bit `imm`.
pub macro and(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0x81, 4, dst, imm, w) }
## `[dst] = [dst] - imm`, with a 32-bit `imm`.
pub macro sub(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0x81, 5, dst, imm, w) }
## `[dst] = [dst] ^ imm`, with a 32-bit `imm`.
pub macro xor(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0x81, 6, dst, imm, w) }
## Sets the flags from `[dst] - imm`, without storing it.
pub macro cmp(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0x81, 7, dst, imm, w) }
## Sets the flags from `[dst] & imm`, without storing it.
pub macro test(
    dst: MemOperand,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit mem_imm_instr(0xF7, 0, dst, imm, w) }

# =================
# control flow: jmp/jcc/call/ret
# =================
# Near-only (`rel32`), no automatic short/near relaxation — a real assembler's
# `rel8` vs `rel32` choice is deliberately not this language's job to make
# automatically.
#
# `target` is a label's already-resolved entry position, exactly like
# `std/riscv/impl.basm`'s branch instructions take theirs — `beq x1, x2,
# start`'s `start` and this file's `jmp target`'s `target` mean the same thing.
#
# x86's `rel32` is relative to the address of the *next* instruction, not this
# instruction's own start the way RISC-V's `here()`-based offset is: `here()`
# only ever resolves to an entry *index*, never a byte address (so RISC-V's own
# fixed-width `mul(sub(target, here()), 4)` trick can't generalize to x86's
# variable-length instructions), and `span` — the one primitive that does track
# real per-entry byte widths — needed generalizing to accept a `Deferred`
# endpoint and to resolve bidirectionally before it could serve here at all
# (`std/bitter/ deferred.basm`). `rel32_offset` below is exactly `span(here(),
# target)` (the real byte distance from this instruction's own start to the
# target's), corrected by this instruction's own fixed length to land on the
# *next* instruction instead.
macro rel32_offset(
    target: int,
    own_length: int
) -> Deferred {
    @return sub(span(here(), target), own_length)
}

# opcode + rel32 (`jmp`/`call`: one opcode byte; `jcc`: two). The `rel32` field
# is wrapped in `LittleEndian<Positioned<32>, 32>` rather than folded into a
# `Bytes<N>` alongside the opcode byte(s) the way the other instructions'
# immediates are:
# those were always already-known plain `int`s at macro-expansion time, so
# `byte_of` could split them into individual little-endian `Byte`s directly, but
# `rel32_offset` stays a `Deferred` until `bitter` resolves it — there's no
# concrete `int` for `byte_of` to split yet. `LittleEndian<T, width>` is the
# primitive for exactly this: wrap the *whole* resolved 32-bit value once
# `bitter` knows it, then byte-reverse just that value — not the surrounding
# opcode byte(s), which are already individual, order-fixed bytes needing no
# such treatment (the same distinction RISC-V's own single indivisible 32-bit
# word never has to draw).
## A `jmp` or `call`: an opcode byte and a 32-bit offset `bitter` works out.
pub struct Rel32Instr {
    ## The opcode.
    pub opcode: Byte,
    ## The offset from the next instruction to the target.
    pub rel32: LittleEndian<Positioned<32>, 32>,
}

## A conditional jump: two opcode bytes and a 32-bit offset `bitter` works
## out.
pub struct Rel32Instr2 {
    ## The first opcode byte, `0x0F`.
    pub opcode1: Byte,
    ## The second opcode byte, which holds the condition.
    pub opcode2: Byte,
    ## The offset from the next instruction to the target.
    pub rel32: LittleEndian<Positioned<32>, 32>,
}

# `jmp rel32` is always 5 bytes (1 opcode + 4 disp) — `own_length` below is that
# fixed size, known here at macro-expansion time since there's no
# variable-length encoding in this instruction at all (unlike, say, the
# memory operands).
## Jumps to the label `target`.
pub macro jmp(target: int)
    | emits Rel32Instr
{
    @emit Rel32Instr(
        opcode = Byte(0xE9),
        rel32 = LittleEndian<Positioned<32>, 32> { value: Positioned<32> { value: rel32_offset(
                    target,
                    5
        ) } }
    )
}

# `call rel32` — same shape as `jmp`, different opcode, still 5 bytes total.
## Pushes the address of the next instruction and jumps to the label
## `target`.
pub macro call(target: int)
    | emits Rel32Instr
{
    @emit Rel32Instr(
        opcode = Byte(0xE8),
        rel32 = LittleEndian<Positioned<32>, 32> { value: Positioned<32> { value: rel32_offset(
                    target,
                    5
        ) } }
    )
}

# Shared by every `jcc` mnemonic below: `0x0F 0x8_`, where the low nibble is the
# Intel SDM's own 4-bit condition code (`tttn`) — the same code shared by the
# short `Jcc rel8`, `SETcc`, and `CMOVcc` families this file doesn't implement,
# not something invented here. 6 bytes total (2 opcode + 4 disp), one byte
# longer than `jmp`/`call`'s `own_length`.
macro jcc_instr(
    condition: int,
    target: int
) -> Rel32Instr2 {
    @return Rel32Instr2(
        opcode1 = Byte(0x0F),
        opcode2 = Byte(0x80 | condition),
        rel32 = LittleEndian<Positioned<32>, 32> { value: Positioned<32> { value: rel32_offset(
                    target,
                    6
        ) } }
    )
}

# All 16 near-`Jcc` condition codes, first under their most common reading (`je`
# over its `jz` synonym, etc.) — condition codes straight out of the Intel SDM's
# own `Jcc` opcode table, cross-checked pairwise (`je`/`jne`, `jb`/`jae`,
# `ja`/`jbe`, `jl`/`jge`, `jle`/`jg`, `js`/`jns`, `jo`/`jno`, `jp`/`jnp` are
# each other's exact bit-complement — `tttn` vs `tttn⊕1`).
## Jumps to the label `target` if equal (ZF = 1).
pub macro je(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x4, target) }
## Jumps to the label `target` if not equal (ZF = 0).
pub macro jne(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x5, target) }
## Jumps to the label `target` if below, unsigned (CF = 1).
pub macro jb(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x2, target) }
## Jumps to the label `target` if above or equal, unsigned (CF = 0).
pub macro jae(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x3, target) }
## Jumps to the label `target` if above, unsigned.
pub macro ja(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x7, target) }
## Jumps to the label `target` if below or equal, unsigned.
pub macro jbe(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x6, target) }
## Jumps to the label `target` if less, signed.
pub macro jl(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xC, target) }
## Jumps to the label `target` if greater or equal, signed.
pub macro jge(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xD, target) }
## Jumps to the label `target` if less or equal, signed.
pub macro jle(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xE, target) }
## Jumps to the label `target` if greater, signed.
pub macro jg(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xF, target) }
## Jumps to the label `target` if the result was negative (SF = 1).
pub macro js(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x8, target) }
## Jumps to the label `target` if the result wasn't negative (SF = 0).
pub macro jns(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x9, target) }
## Jumps to the label `target` on signed overflow (OF = 1).
pub macro jo(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x0, target) }
## Jumps to the label `target` without signed overflow (OF = 0).
pub macro jno(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x1, target) }
## Jumps to the label `target` if the parity flag is set (PF = 1).
pub macro jp(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xA, target) }
## Jumps to the label `target` if the parity flag is clear (PF = 0).
pub macro jnp(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xB, target) }

# The SDM's synonyms for the same 16 condition codes — every alternate spelling
# its `Jcc` table lists, so code written against any of them assembles as-is.
## `je`, under another name.
pub macro jz(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x4, target) }
## `jne`, under another name.
pub macro jnz(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x5, target) }
## `jb`, under another name.
pub macro jc(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x2, target) }
## `jb`, under another name.
pub macro jnae(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x2, target) }
## `jae`, under another name.
pub macro jnc(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x3, target) }
## `jae`, under another name.
pub macro jnb(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x3, target) }
## `ja`, under another name.
pub macro jnbe(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x7, target) }
## `jbe`, under another name.
pub macro jna(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0x6, target) }
## `jl`, under another name.
pub macro jnge(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xC, target) }
## `jge`, under another name.
pub macro jnl(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xD, target) }
## `jle`, under another name.
pub macro jng(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xE, target) }
## `jg`, under another name.
pub macro jnle(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xF, target) }
## `jp`, under another name.
pub macro jpe(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xA, target) }
## `jnp`, under another name.
pub macro jpo(target: int)
    | emits Rel32Instr2 { @emit jcc_instr(0xB, target) }

## Returns: pops an address and jumps to it.
pub macro ret()
    | emits Byte
{
    @emit Byte(0xC3)
}

# =================
# shl/shr/sar
# =================
# The forms with `w`: `0xC1 /digit` takes an 8-bit count, `0xD3 /digit`
# takes it from `cl`. The `cl` forms are `shl_cl` and so on, since
# `shr(rd: Reg, w: int)` would collide with `std.bitter.deferred`'s
# `shr(a: int, b: int)`. The sized forms below take `cl` as an operand.
## `rd = rd << imm`.
pub macro shl(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xC1, 4, rd, imm, 1, w) }
## `rd = rd << cl`.
pub macro shl_cl(
    rd: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xD3, 4, rd, 0, 0, w) }

## `rd = rd >> imm`, shifting in zeros.
pub macro shr(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xC1, 5, rd, imm, 1, w) }
## `rd = rd >> cl`, shifting in zeros.
pub macro shr_cl(
    rd: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xD3, 5, rd, 0, 0, w) }

## `rd = rd >> imm`, shifting in copies of the sign bit.
pub macro sar(
    rd: Reg,
    imm: int,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xC1, 7, rd, imm, 1, w) }
## `rd = rd >> cl`, shifting in copies of the sign bit.
pub macro sar_cl(
    rd: Reg,
    w: int
)
    | emits Bytes<...> { @emit reg_imm_instr(0xD3, 7, rd, 0, 0, w) }

# =================
# lea
# =================
# `0x8D /r`: ModRM.reg is the destination and the memory operand is the
# address to compute. Memory isn't read.
## Loads the address `src` stands for into `rd`, without reading memory.
pub macro lea(
    rd: Reg,
    src: MemOperand,
    w: int
)
    | emits Bytes<...> { @emit mem_reg_instr(0x8D, src, rd, w) }

## Loads the address `src` stands for into `rd`, without reading memory.
pub macro lea<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x8D, rd, src, 0, 0) }

# =================
# RIP-relative label operands
# =================
# `MemRipRelative(disp)` takes a displacement the caller already knows. A
# `RipLabel` names a *label* instead, and lets `bitter` work out the
# displacement once the code is laid out — the same `rel32_offset` trick
# `jmp`/`call` use: `span(here(), target)` is the byte distance from this
# instruction's start to the label, minus this instruction's own length to
# measure from the next instruction, which is what the CPU adds `disp32` to.
# The encoding is always `mod=00 rm=101` + disp32, so the only variable part
# is whether a REX byte is needed — hence one struct with REX and one without,
# each emitted as a single entry so `span` sees the whole instruction.
## A label used as a memory operand, addressed relative to the next
## instruction: NASM's `[rel label]`.
pub struct RipLabel {
    ## The label.
    pub target: int,
}

## An instruction with a `RipLabel` operand and no REX prefix.
pub struct RipRelInstr {
    ## The opcode.
    pub opcode: Byte,
    ## The ModRM byte, with `rm` = RIP-relative.
    pub modrm: Byte,
    ## The displacement from the next instruction to the label.
    pub disp32: LittleEndian<Positioned<32>, 32>,
}

## An instruction with a `RipLabel` operand and a REX prefix.
pub struct RipRelInstrRex {
    ## The REX prefix.
    pub rex: Byte,
    ## The opcode.
    pub opcode: Byte,
    ## The ModRM byte, with `rm` = RIP-relative.
    pub modrm: Byte,
    ## The displacement from the next instruction to the label.
    pub disp32: LittleEndian<Positioned<32>, 32>,
}

# ModRM.reg = `r`, r/m = the label. Same "reg field is the other register"
# shape as `mem_reg_instr`, for whichever direction `opcode` encodes. `pub`
# only because a private macro invoked as a statement doesn't resolve once
# this file is imported.
## An instruction with opcode `opcode` whose memory operand is the label
## `addr`, and whose other operand is `r`. The dialects' `[rel label]`
## forms are built on it.
pub macro rip_label_instr(
    opcode: int,
    addr: RipLabel,
    r: Reg,
    w: int
) {
    const modrm = modrm_byte(0b00, reg_field(r), 0b101)
    @if w == 1 || reg_ext(r) == 1 {
        @emit RipRelInstrRex(
            rex = rex_byte(w, reg_ext(r), 0, 0),
            opcode = Byte(opcode),
            modrm = modrm,
            disp32 = LittleEndian<Positioned<32>, 32> { value: Positioned<32> { value: rel32_offset(
                        addr.target,
                        7
            ) } }
        )
    } @else {
        @emit RipRelInstr(
            opcode = Byte(opcode),
            modrm = modrm,
            disp32 = LittleEndian<Positioned<32>, 32> { value: Positioned<32> { value: rel32_offset(
                        addr.target,
                        6
            ) } }
        )
    }
}

## Loads the address of the label `src` into `rd`.
pub macro lea(
    rd: Reg,
    src: RipLabel,
    w: int
) { rip_label_instr 0x8D, src, rd, w }
## Loads the value at the label `src` into `rd`.
pub macro mov(
    rd: Reg,
    src: RipLabel,
    w: int
) { rip_label_instr 0x8B, src, rd, w }
## Stores `rs` at the label `dst`.
pub macro mov(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x89, dst, rs, w }
## `[dst] = [dst] + rs`, where `dst` is a label.
pub macro add(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x01, dst, rs, w }
## `[dst] = [dst] | rs`, where `dst` is a label.
pub macro or(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x09, dst, rs, w }
## `[dst] = [dst] & rs`, where `dst` is a label.
pub macro and(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x21, dst, rs, w }
## `[dst] = [dst] - rs`, where `dst` is a label.
pub macro sub(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x29, dst, rs, w }
## `[dst] = [dst] ^ rs`, where `dst` is a label.
pub macro xor(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x31, dst, rs, w }
## Sets the flags from `[dst] - rs`, where `dst` is a label, without storing
## it.
pub macro cmp(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x39, dst, rs, w }
## Sets the flags from `[dst] & rs`, where `dst` is a label, without storing
## it.
pub macro test(
    dst: RipLabel,
    rs: Reg,
    w: int
) { rip_label_instr 0x85, dst, rs, w }

# The same with the operand size from the register: `Reg` for 64 bits,
# `Reg32` for 32.
## Loads the address of the label `src` into `rd`.
pub macro lea(rd: Reg, src: RipLabel) { rip_label_instr 0x8D, src, rd, 1 }
pub macro lea(rd: Reg32, src: RipLabel) { rip_label_instr 0x8D, src, rd.reg, 0 }
## Loads the value at the label `src` into `rd`.
pub macro mov(rd: Reg, src: RipLabel) { rip_label_instr 0x8B, src, rd, 1 }
pub macro mov(rd: Reg32, src: RipLabel) { rip_label_instr 0x8B, src, rd.reg, 0 }
## Stores `rs` at the label `dst`.
pub macro mov(dst: RipLabel, rs: Reg) { rip_label_instr 0x89, dst, rs, 1 }
pub macro mov(dst: RipLabel, rs: Reg32) { rip_label_instr 0x89, dst, rs.reg, 0 }
## `[dst] = [dst] + rs`, where `dst` is a label.
pub macro add(dst: RipLabel, rs: Reg) { rip_label_instr 0x01, dst, rs, 1 }
pub macro add(dst: RipLabel, rs: Reg32) { rip_label_instr 0x01, dst, rs.reg, 0 }
## `[dst] = [dst] | rs`, where `dst` is a label.
pub macro or(dst: RipLabel, rs: Reg) { rip_label_instr 0x09, dst, rs, 1 }
pub macro or(dst: RipLabel, rs: Reg32) { rip_label_instr 0x09, dst, rs.reg, 0 }
## `[dst] = [dst] & rs`, where `dst` is a label.
pub macro and(dst: RipLabel, rs: Reg) { rip_label_instr 0x21, dst, rs, 1 }
pub macro and(dst: RipLabel, rs: Reg32) { rip_label_instr 0x21, dst, rs.reg, 0 }
## `[dst] = [dst] - rs`, where `dst` is a label.
pub macro sub(dst: RipLabel, rs: Reg) { rip_label_instr 0x29, dst, rs, 1 }
pub macro sub(dst: RipLabel, rs: Reg32) { rip_label_instr 0x29, dst, rs.reg, 0 }
## `[dst] = [dst] ^ rs`, where `dst` is a label.
pub macro xor(dst: RipLabel, rs: Reg) { rip_label_instr 0x31, dst, rs, 1 }
pub macro xor(dst: RipLabel, rs: Reg32) { rip_label_instr 0x31, dst, rs.reg, 0 }
## Sets the flags from `[dst] - rs`, where `dst` is a label, without storing it.
pub macro cmp(dst: RipLabel, rs: Reg) { rip_label_instr 0x39, dst, rs, 1 }
pub macro cmp(dst: RipLabel, rs: Reg32) { rip_label_instr 0x39, dst, rs.reg, 0 }
## Sets the flags from `[dst] & rs`, where `dst` is a label, without storing it.
pub macro test(dst: RipLabel, rs: Reg) { rip_label_instr 0x85, dst, rs, 1 }
pub macro test(
    dst: RipLabel,
    rs: Reg32
) { rip_label_instr 0x85, dst, rs.reg, 0 }

# =================
# push/pop
# =================
# `0x50+reg`/`0x58+reg`: the register in the opcode's low 3 bits, its
# extension bit in REX.B. In 64-bit mode a register push or pop is 64 bits
# by default, so these take no `w`; the 16-bit forms are with the sized
# instructions below.
## Pushes the 64-bit `rd` onto the stack.
pub macro push(rd: Reg)
    | emits Bytes<...>
{
    @emit reg_in_opcode_instr(32, 0x50, gpr(rd), 0, 0)
}

## Pops 64 bits off the stack into `rd`.
pub macro pop(rd: Reg)
    | emits Bytes<...>
{
    @emit reg_in_opcode_instr(32, 0x58, gpr(rd), 0, 0)
}

# =================
# syscall
# =================
# `0F 05`, no ModRM/REX/operand of any kind — Linux x86-64's fast system-call
# entry point. The kernel reads its own calling convention (syscall number in
# `rax`, arguments in `rdi`/`rsi`/`rdx`/`r10`/`r8`/`r9`) straight out of
# registers, so unlike every other macro in this file there is no addressing
# mode, operand size, or register argument for this instruction to encode at
# all — same zero-operand shape as `ret` above.
## Calls the operating system. On Linux, `rax` holds the call number and
## `rdi`, `rsi`, `rdx`, ... its arguments.
pub macro syscall()
    | emits Bytes<2>
{
    @emit Bytes<2> { __el0: Byte(0x0F), __el1: Byte(0x05) }
}

# =================
# sized instructions: shared shapes
# =================
# The instructions below are generic over their register operands' type,
# so `add rax, rbx`, `add eax, ebx`, `add ax, bx` and `add al, bl` are one
# macro, and mixing sizes (`add rax, ebx`) matches no overload. A memory
# operand with no register to size it takes an `OperandSize`:
# `add Mem(rbx, 0), 1, qword`. `op8` is the 8-bit opcode, or -1 for an
# instruction that has no 8-bit form. An `imm_len` of -1 means the usual
# immediate for the operand size: 1, 2 or 4 bytes.

macro sized_opcode(
    size: int,
    op8: int,
    op: int
) -> int {
    @if size == 8 {
        @assert op8 >= 0, "this instruction has no 8-bit form"
        @return op8
    }
    @return op
}

macro imm_bytes(
    size: int,
    imm_len: int
) -> int {
    @if imm_len < 0 {
        @return imm_len_of(size)
    }
    @return imm_len
}

# ModRM.rm = `rd`, ModRM.reg = `rs`.
macro rr<R>(
    op8: int,
    op: int,
    rd: R,
    rs: R,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    const d = gpr(rd)
    @return reg_rm_instr(
        d.size,
        sized_opcode(d.size, op8, op),
        gpr(rs),
        d,
        imm,
        imm_bytes(d.size, imm_len)
    )
}

# ModRM.reg = `rd`, ModRM.rm = `rs`: the "r, r/m" direction.
macro rr_load<R>(
    op8: int,
    op: int,
    rd: R,
    rs: R,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    const d = gpr(rd)
    @return reg_rm_instr(
        d.size,
        sized_opcode(d.size, op8, op),
        d,
        gpr(rs),
        imm,
        imm_bytes(d.size, imm_len)
    )
}

# ModRM.reg = `r`, ModRM.rm = `mem`, either direction.
macro rmem<R>(
    op8: int,
    op: int,
    r: R,
    mem: MemOperand,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    const g = gpr(r)
    @return reg_mem_instr(
        g.size,
        sized_opcode(g.size, op8, op),
        g,
        mem,
        imm,
        imm_bytes(g.size, imm_len)
    )
}

# ModRM.reg = `digit`, ModRM.rm = `rd`.
macro ri<R>(
    op8: int,
    op: int,
    digit: int,
    rd: R,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    const d = gpr(rd)
    @return digit_rm_instr(
        d.size,
        sized_opcode(d.size, op8, op),
        digit,
        d,
        imm,
        imm_bytes(d.size, imm_len)
    )
}

# ModRM.reg = `digit`, ModRM.rm = `dst`, `size` wide.
macro mi(
    op8: int,
    op: int,
    digit: int,
    dst: MemOperand,
    imm: int,
    imm_len: int,
    size: OperandSize
) -> Bytes<...> {
    @return digit_mem_instr(
        size.bits,
        sized_opcode(size.bits, op8, op),
        digit,
        dst,
        imm,
        imm_bytes(size.bits, imm_len)
    )
}

# An opcode and an immediate, with no ModRM byte.
macro imm_instr(
    prefix: int,
    opcode: int,
    imm: int,
    imm_len: int
) -> Bytes<...> {
    @return encoding_bytes(Encoding(
            prefix = prefix,
            need_rex = 0,
            rex = Byte(0),
            escape = opcode > 0xFF,
            opcode = Byte(opcode & 0xFF),
            has_modrm = 0,
            modrm = Byte(0),
            has_sib = 0,
            sib = Byte(0),
            disp = 0,
            disp_len = 0,
            imm = imm,
            imm_len = imm_len
    ))
}

## Fails to compile unless `count` is `cl`, the only register a shift can
## take its count from.
pub macro assert_cl(count: Reg8) {
    @assert count.reg.value == 1 && count.high == 0, "a shift count register must be `cl`"
}

## Fails to compile unless `size` is `bits` bits.
pub macro assert_size(size: OperandSize, bits: int) {
    @assert size.bits == bits, "wrong operand size for this instruction"
}

# =================
# add, or, adc, sbb, and, sub, xor, cmp
# =================

## `rd = rd + rs`.
pub macro add<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x00, 0x01, rd, rs, 0, 0) }
## `rd = rd + imm`; a 64-bit `rd` takes a 32-bit `imm`, sign-extended.
pub macro add<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 0, rd, imm, -1) }
## `rd = rd + [src]`.
pub macro add<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x02, 0x03, rd, src, 0, 0) }
## `[dst] = [dst] + rs`.
pub macro add<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x00, 0x01, rs, dst, 0, 0) }
## `[dst] = [dst] + imm`, `size` wide.
pub macro add(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 0, dst, imm, -1, size) }
## Fails: `add [dst], imm` needs a size, like `add qword [rbx], 1`.
pub macro add(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## `rd = rd | rs`.
pub macro or<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x08, 0x09, rd, rs, 0, 0) }
## `rd = rd | imm`; a 64-bit `rd` takes a 32-bit `imm`, sign-extended.
pub macro or<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 1, rd, imm, -1) }
## `rd = rd | [src]`.
pub macro or<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x0a, 0x0b, rd, src, 0, 0) }
## `[dst] = [dst] | rs`.
pub macro or<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x08, 0x09, rs, dst, 0, 0) }
## `[dst] = [dst] | imm`, `size` wide.
pub macro or(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 1, dst, imm, -1, size) }
## Fails: `or [dst], imm` needs a size, like `or qword [rbx], 1`.
pub macro or(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## `rd = rd + rs + CF`: add with carry.
pub macro adc<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x10, 0x11, rd, rs, 0, 0) }
## `rd = rd + imm + CF`: add with carry; a 64-bit `rd` takes a 32-bit `imm`,
## sign-extended.
pub macro adc<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 2, rd, imm, -1) }
## `rd = rd + [src] + CF`: add with carry.
pub macro adc<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x12, 0x13, rd, src, 0, 0) }
## `[dst] = [dst] + rs + CF`: add with carry.
pub macro adc<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x10, 0x11, rs, dst, 0, 0) }
## `[dst] = [dst] + imm + CF`: add with carry, `size` wide.
pub macro adc(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 2, dst, imm, -1, size) }
## Fails: `adc [dst], imm` needs a size, like `adc qword [rbx], 1`.
pub macro adc(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## `rd = rd - rs - CF`: subtract with borrow.
pub macro sbb<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x18, 0x19, rd, rs, 0, 0) }
## `rd = rd - imm - CF`: subtract with borrow; a 64-bit `rd` takes a 32-bit
## `imm`, sign-extended.
pub macro sbb<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 3, rd, imm, -1) }
## `rd = rd - [src] - CF`: subtract with borrow.
pub macro sbb<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x1a, 0x1b, rd, src, 0, 0) }
## `[dst] = [dst] - rs - CF`: subtract with borrow.
pub macro sbb<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x18, 0x19, rs, dst, 0, 0) }
## `[dst] = [dst] - imm - CF`: subtract with borrow, `size` wide.
pub macro sbb(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 3, dst, imm, -1, size) }
## Fails: `sbb [dst], imm` needs a size, like `sbb qword [rbx], 1`.
pub macro sbb(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## `rd = rd & rs`.
pub macro and<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x20, 0x21, rd, rs, 0, 0) }
## `rd = rd & imm`; a 64-bit `rd` takes a 32-bit `imm`, sign-extended.
pub macro and<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 4, rd, imm, -1) }
## `rd = rd & [src]`.
pub macro and<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x22, 0x23, rd, src, 0, 0) }
## `[dst] = [dst] & rs`.
pub macro and<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x20, 0x21, rs, dst, 0, 0) }
## `[dst] = [dst] & imm`, `size` wide.
pub macro and(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 4, dst, imm, -1, size) }
## Fails: `and [dst], imm` needs a size, like `and qword [rbx], 1`.
pub macro and(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## `rd = rd - rs`.
pub macro sub<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x28, 0x29, rd, rs, 0, 0) }
## `rd = rd - imm`; a 64-bit `rd` takes a 32-bit `imm`, sign-extended.
pub macro sub<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 5, rd, imm, -1) }
## `rd = rd - [src]`.
pub macro sub<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x2a, 0x2b, rd, src, 0, 0) }
## `[dst] = [dst] - rs`.
pub macro sub<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x28, 0x29, rs, dst, 0, 0) }
## `[dst] = [dst] - imm`, `size` wide.
pub macro sub(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 5, dst, imm, -1, size) }
## Fails: `sub [dst], imm` needs a size, like `sub qword [rbx], 1`.
pub macro sub(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## `rd = rd ^ rs`.
pub macro xor<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x30, 0x31, rd, rs, 0, 0) }
## `rd = rd ^ imm`; a 64-bit `rd` takes a 32-bit `imm`, sign-extended.
pub macro xor<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 6, rd, imm, -1) }
## `rd = rd ^ [src]`.
pub macro xor<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x32, 0x33, rd, src, 0, 0) }
## `[dst] = [dst] ^ rs`.
pub macro xor<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x30, 0x31, rs, dst, 0, 0) }
## `[dst] = [dst] ^ imm`, `size` wide.
pub macro xor(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 6, dst, imm, -1, size) }
## Fails: `xor [dst], imm` needs a size, like `xor qword [rbx], 1`.
pub macro xor(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## Sets the flags from `rd - rs`, without storing it.
pub macro cmp<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x38, 0x39, rd, rs, 0, 0) }
## Sets the flags from `rd - imm`, without storing it; a 64-bit `rd` takes a
## 32-bit `imm`, sign-extended.
pub macro cmp<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0x80, 0x81, 7, rd, imm, -1) }
## Sets the flags from `rd - [src]`, without storing it.
pub macro cmp<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x3a, 0x3b, rd, src, 0, 0) }
## Sets the flags from `[dst] - rs`, without storing it.
pub macro cmp<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x38, 0x39, rs, dst, 0, 0) }
## Sets the flags from `[dst] - imm`, without storing it, `size` wide.
pub macro cmp(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0x80, 0x81, 7, dst, imm, -1, size) }
## Fails: `cmp [dst], imm` needs a size, like `cmp qword [rbx], 1`.
pub macro cmp(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

# =================
# mov, test, xchg, xadd, cmpxchg
# =================

## `rd = rs`.
pub macro mov<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x88, 0x89, rd, rs, 0, 0) }
## `rd = imm`. A 64-bit `rd` takes a full 64-bit `imm`.
pub macro mov<R>(rd: R, imm: int)
    | emits Bytes<...>
{
    const d = gpr(rd)
    const imm_len = imm_len_of(d.size) + 4 * (d.size == 64)
    @emit reg_in_opcode_instr(
        d.size,
        sized_opcode(d.size, 0xB0, 0xB8),
        d,
        imm,
        imm_len
    )
}
## Loads the value at `src` into `rd`.
pub macro mov<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x8A, 0x8B, rd, src, 0, 0) }
## Loads the value at `src` into `rd`; `size` must match `rd`'s.
pub macro mov<R>(rd: R, src: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, gpr(rd).size
    @emit rmem(0x8A, 0x8B, rd, src, 0, 0)
}
## Stores `rs` at `dst`.
pub macro mov<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x88, 0x89, rs, dst, 0, 0) }
## Stores `imm` at `dst`, `size` wide. A 64-bit store takes a 32-bit
## `imm`, sign-extended.
pub macro mov(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC6, 0xC7, 0, dst, imm, -1, size) }
## Fails: `mov [dst], imm` needs a size, like `mov qword [rbx], 1`.
pub macro mov(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}
# `mov` to or from a segment register. Like NASM, a 64-bit general
# register gets the 32-bit encoding, which zero-extends the same way.
## `rd = sr`.
pub macro mov<R>(rd: R, sr: SReg)
    | emits Bytes<...>
{
    const d = gpr(rd)
    const size = d.size - 32 * (d.size == 64)
    @emit modrm_instr(
        size,
        0x8C,
        sr.num,
        d.rex == 1,
        d.rex == -1,
        direct(d),
        0,
        0
    )
}
## Loads `sr` from the low 16 bits of `rs`.
pub macro mov<R>(sr: SReg, rs: R)
    | emits Bytes<...>
{
    const s = gpr(rs)
    @emit modrm_instr(
        32,
        0x8E,
        sr.num,
        s.rex == 1,
        s.rex == -1,
        direct(s),
        0,
        0
    )
}
## Stores `sr` at `dst`, 16 bits wide.
pub macro mov(dst: MemOperand, sr: SReg)
    | emits Bytes<...> { @emit modrm_instr(
            32,
            0x8C,
            sr.num,
            0,
            0,
            addr_mode(dst),
            0,
            0
    ) }
## Stores `sr` at `dst`; `size` must be `word`.
pub macro mov(dst: MemOperand, sr: SReg, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 16
    @emit modrm_instr(32, 0x8C, sr.num, 0, 0, addr_mode(dst), 0, 0)
}
## Loads `sr` from the 16 bits at `src`.
pub macro mov(sr: SReg, src: MemOperand)
    | emits Bytes<...> { @emit modrm_instr(
            32,
            0x8E,
            sr.num,
            0,
            0,
            addr_mode(src),
            0,
            0
    ) }
## Loads `sr` from `src`; `size` must be `word`.
pub macro mov(sr: SReg, src: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 16
    @emit modrm_instr(32, 0x8E, sr.num, 0, 0, addr_mode(src), 0, 0)
}

## Sets the flags from `rd & rs`, without storing it.
pub macro test<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x84, 0x85, rd, rs, 0, 0) }
## Sets the flags from `rd & imm`, without storing it.
pub macro test<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xF6, 0xF7, 0, rd, imm, -1) }
## Sets the flags from `rd & [src]`, without storing it.
pub macro test<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x84, 0x85, rd, src, 0, 0) }
## Sets the flags from `[dst] & rs`, without storing it.
pub macro test<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x84, 0x85, rs, dst, 0, 0) }
## Sets the flags from `[dst] & imm`, `size` wide, without storing it.
pub macro test(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xF6, 0xF7, 0, dst, imm, -1, size) }
## Fails: `test [dst], imm` needs a size, like `test qword [rbx], 1`.
pub macro test(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}

## Swaps `rd` and `rs`.
pub macro xchg<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x86, 0x87, rd, rs, 0, 0) }
## Swaps `rd` and the value at `src`, atomically.
pub macro xchg<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(0x86, 0x87, rd, src, 0, 0) }
## Swaps the value at `dst` and `rs`, atomically.
pub macro xchg<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x86, 0x87, rs, dst, 0, 0) }
## Exchanges and adds: `rs` gets `rd`, and `rd` gets their sum.
pub macro xadd<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x0FC0, 0x0FC1, rd, rs, 0, 0) }
## Exchanges and adds: `rs` gets `[dst]`, and `[dst]` gets their sum.
pub macro xadd<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x0FC0, 0x0FC1, rs, dst, 0, 0) }
## Compares the accumulator (`al`, `ax`, `eax` or `rax`) with `rd`: if
## equal, `rd = rs`, else the accumulator gets `rd`.
pub macro cmpxchg<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(0x0FB0, 0x0FB1, rd, rs, 0, 0) }
## Compares the accumulator with `[dst]`: if equal, `[dst] = rs`, else
## the accumulator gets `[dst]`.
pub macro cmpxchg<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(0x0FB0, 0x0FB1, rs, dst, 0, 0) }
## Compares `edx:eax` with the 64 bits at `dst`: if equal, stores
## `ecx:ebx` there, else loads them into `edx:eax`.
pub macro cmpxchg8b(dst: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(32, 0x0FC7, 1, dst, 0, 0) }
## `cmpxchg8b`; `size` must be `qword`.
pub macro cmpxchg8b(dst: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 64
    @emit digit_mem_instr(32, 0x0FC7, 1, dst, 0, 0)
}
## Compares `rdx:rax` with the 128 bits at `dst`: if equal, stores
## `rcx:rbx` there, else loads them into `rdx:rax`.
pub macro cmpxchg16b(dst: MemOperand)
    | emits Bytes<...> { @emit digit_mem_instr(64, 0x0FC7, 1, dst, 0, 0) }
## `cmpxchg16b`; `size` must be `oword`.
pub macro cmpxchg16b(dst: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 128
    @emit digit_mem_instr(64, 0x0FC7, 1, dst, 0, 0)
}

# =================
# not, neg, mul, imul, div, idiv, inc, dec
# =================

## `rd = ~rd`.
pub macro not<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xf6, 0xf7, 2, rd, 0, 0) }
## `[dst] = ~[dst]`, `size` wide.
pub macro not(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xf6, 0xf7, 2, dst, 0, 0, size) }
## `rd = -rd`.
pub macro neg<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xf6, 0xf7, 3, rd, 0, 0) }
## `[dst] = -[dst]`, `size` wide.
pub macro neg(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xf6, 0xf7, 3, dst, 0, 0, size) }
## Unsigned multiply: `rdx:rax = rax * rd` (or the smaller registers for a
## smaller operand).
pub macro mul<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xf6, 0xf7, 4, rd, 0, 0) }
## Unsigned multiply: `rdx:rax = rax * [dst]` (or the smaller registers for a
## smaller operand), `size` wide.
pub macro mul(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xf6, 0xf7, 4, dst, 0, 0, size) }
## Signed multiply: `rdx:rax = rax * rd` (or the smaller registers for a
## smaller operand).
pub macro imul<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xf6, 0xf7, 5, rd, 0, 0) }
## Signed multiply: `rdx:rax = rax * [dst]` (or the smaller registers for a
## smaller operand), `size` wide.
pub macro imul(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xf6, 0xf7, 5, dst, 0, 0, size) }
## Unsigned divide: `rax = rdx:rax / rd`, `rdx` = the remainder (or the
## smaller registers for a smaller operand).
pub macro div<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xf6, 0xf7, 6, rd, 0, 0) }
## Unsigned divide: `rax = rdx:rax / [dst]`, `rdx` = the remainder (or the
## smaller registers for a smaller operand), `size` wide.
pub macro div(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xf6, 0xf7, 6, dst, 0, 0, size) }
## Signed divide: `rax = rdx:rax / rd`, `rdx` = the remainder (or the
## smaller registers for a smaller operand).
pub macro idiv<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xf6, 0xf7, 7, rd, 0, 0) }
## Signed divide: `rax = rdx:rax / [dst]`, `rdx` = the remainder (or the
## smaller registers for a smaller operand), `size` wide.
pub macro idiv(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xf6, 0xf7, 7, dst, 0, 0, size) }
## `rd = rd + 1`, leaving CF alone.
pub macro inc<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xfe, 0xff, 0, rd, 0, 0) }
## `[dst] = [dst] + 1`, leaving CF alone, `size` wide.
pub macro inc(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xfe, 0xff, 0, dst, 0, 0, size) }
## `rd = rd - 1`, leaving CF alone.
pub macro dec<R>(rd: R)
    | emits Bytes<...> { @emit ri(0xfe, 0xff, 1, rd, 0, 0) }
## `[dst] = [dst] - 1`, leaving CF alone, `size` wide.
pub macro dec(dst: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xfe, 0xff, 1, dst, 0, 0, size) }
## `rd = rd * rs`, signed, keeping the low half.
pub macro imul<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0FAF, rd, rs, 0, 0) }
## `rd = rd * [src]`, signed, keeping the low half.
pub macro imul<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0FAF, rd, src, 0, 0) }
## `rd = rs * imm`, signed, keeping the low half.
pub macro imul<R>(rd: R, rs: R, imm: int)
    | emits Bytes<...> { @emit rr_load(-1, 0x69, rd, rs, imm, -1) }
## `rd = [src] * imm`, signed, keeping the low half.
pub macro imul<R>(rd: R, src: MemOperand, imm: int)
    | emits Bytes<...> { @emit rmem(-1, 0x69, rd, src, imm, -1) }

# =================
# shifts and rotates
# =================
# `0xC1 /digit` takes an 8-bit count and `0xD3 /digit` takes it from `cl`,
# which the count operand, a `Reg8`, must be.

## Rotates `rd` left by `imm`.
pub macro rol<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 0, rd, imm, 1) }
## Rotates `rd` left by `cl`.
pub macro rol<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 0, rd, 0, 0)
}
## Rotates `[dst]` left by `imm`, `size` wide.
pub macro rol(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 0, dst, imm, 1, size) }
## Rotates `[dst]` left by `cl`, `size` wide.
pub macro rol(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 0, dst, 0, 0, size)
}
## Rotates `rd` right by `imm`.
pub macro ror<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 1, rd, imm, 1) }
## Rotates `rd` right by `cl`.
pub macro ror<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 1, rd, 0, 0)
}
## Rotates `[dst]` right by `imm`, `size` wide.
pub macro ror(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 1, dst, imm, 1, size) }
## Rotates `[dst]` right by `cl`, `size` wide.
pub macro ror(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 1, dst, 0, 0, size)
}
## Rotates `rd` and CF left by `imm`.
pub macro rcl<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 2, rd, imm, 1) }
## Rotates `rd` and CF left by `cl`.
pub macro rcl<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 2, rd, 0, 0)
}
## Rotates `[dst]` and CF left by `imm`, `size` wide.
pub macro rcl(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 2, dst, imm, 1, size) }
## Rotates `[dst]` and CF left by `cl`, `size` wide.
pub macro rcl(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 2, dst, 0, 0, size)
}
## Rotates `rd` and CF right by `imm`.
pub macro rcr<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 3, rd, imm, 1) }
## Rotates `rd` and CF right by `cl`.
pub macro rcr<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 3, rd, 0, 0)
}
## Rotates `[dst]` and CF right by `imm`, `size` wide.
pub macro rcr(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 3, dst, imm, 1, size) }
## Rotates `[dst]` and CF right by `cl`, `size` wide.
pub macro rcr(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 3, dst, 0, 0, size)
}
## `rd = rd << imm`.
pub macro shl<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 4, rd, imm, 1) }
## `rd = rd << cl`.
pub macro shl<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 4, rd, 0, 0)
}
## `[dst] = [dst] << imm`, `size` wide.
pub macro shl(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 4, dst, imm, 1, size) }
## `[dst] = [dst] << cl`, `size` wide.
pub macro shl(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 4, dst, 0, 0, size)
}
## `rd = rd >> imm`, shifting in zeros.
pub macro shr<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 5, rd, imm, 1) }
## `rd = rd >> cl`, shifting in zeros.
pub macro shr<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 5, rd, 0, 0)
}
## `[dst] = [dst] >> imm`, shifting in zeros, `size` wide.
pub macro shr(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 5, dst, imm, 1, size) }
## `[dst] = [dst] >> cl`, shifting in zeros, `size` wide.
pub macro shr(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 5, dst, 0, 0, size)
}
## `rd = rd >> imm`, shifting in copies of the sign bit.
pub macro sar<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(0xC0, 0xC1, 7, rd, imm, 1) }
## `rd = rd >> cl`, shifting in copies of the sign bit.
pub macro sar<R>(rd: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit ri(0xD2, 0xD3, 7, rd, 0, 0)
}
## `[dst] = [dst] >> imm`, shifting in copies of the sign bit, `size` wide.
pub macro sar(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(0xC0, 0xC1, 7, dst, imm, 1, size) }
## `[dst] = [dst] >> cl`, shifting in copies of the sign bit, `size` wide.
pub macro sar(dst: MemOperand, count: Reg8, size: OperandSize)
    | emits Bytes<...>
{
    assert_cl count
    @emit mi(0xD2, 0xD3, 7, dst, 0, 0, size)
}
## Shifts `rd` left by `imm`, filling from the top of `rs`.
pub macro shld<R>(rd: R, rs: R, imm: int)
    | emits Bytes<...> { @emit rr(-1, 0x0fa4, rd, rs, imm, 1) }
## Shifts `rd` left by `cl`, filling from the top of `rs`.
pub macro shld<R>(rd: R, rs: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit rr(-1, 0x0fa5, rd, rs, 0, 0)
}
## Shifts `[dst]` left by `imm`, filling from the top of `rs`.
pub macro shld<R>(dst: MemOperand, rs: R, imm: int)
    | emits Bytes<...> { @emit rmem(-1, 0x0fa4, rs, dst, imm, 1) }
## Shifts `[dst]` left by `cl`, filling from the top of `rs`.
pub macro shld<R>(dst: MemOperand, rs: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit rmem(-1, 0x0fa5, rs, dst, 0, 0)
}
## Shifts `rd` right by `imm`, filling from the bottom of `rs`.
pub macro shrd<R>(rd: R, rs: R, imm: int)
    | emits Bytes<...> { @emit rr(-1, 0x0fac, rd, rs, imm, 1) }
## Shifts `rd` right by `cl`, filling from the bottom of `rs`.
pub macro shrd<R>(rd: R, rs: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit rr(-1, 0x0fad, rd, rs, 0, 0)
}
## Shifts `[dst]` right by `imm`, filling from the bottom of `rs`.
pub macro shrd<R>(dst: MemOperand, rs: R, imm: int)
    | emits Bytes<...> { @emit rmem(-1, 0x0fac, rs, dst, imm, 1) }
## Shifts `[dst]` right by `cl`, filling from the bottom of `rs`.
pub macro shrd<R>(dst: MemOperand, rs: R, count: Reg8)
    | emits Bytes<...>
{
    assert_cl count
    @emit rmem(-1, 0x0fad, rs, dst, 0, 0)
}

# =================
# bit tests and scans, bswap, movzx, movsx
# =================

## Copies bit `rs` of `rd` into CF.
pub macro bt<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(-1, 0x0fa3, rd, rs, 0, 0) }
## Copies bit `imm` of `rd` into CF.
pub macro bt<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(-1, 0x0FBA, 4, rd, imm, 1) }
## Copies bit `rs` of `[dst]` into CF. The bit string can extend past `dst`.
pub macro bt<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(-1, 0x0fa3, rs, dst, 0, 0) }
## Copies bit `imm` of `[dst]` into CF, `size` wide.
pub macro bt(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(-1, 0x0FBA, 4, dst, imm, 1, size) }
## Fails: `bt [dst], imm` needs a size, like `bt qword [rbx], 1`.
pub macro bt(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}
## Copies bit `rs` of `rd` into CF, then sets it.
pub macro bts<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(-1, 0x0fab, rd, rs, 0, 0) }
## Copies bit `imm` of `rd` into CF, then sets it.
pub macro bts<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(-1, 0x0FBA, 5, rd, imm, 1) }
## Copies bit `rs` of `[dst]` into CF, then sets it. The bit string can extend
## past `dst`.
pub macro bts<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(-1, 0x0fab, rs, dst, 0, 0) }
## Copies bit `imm` of `[dst]` into CF, then sets it, `size` wide.
pub macro bts(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(-1, 0x0FBA, 5, dst, imm, 1, size) }
## Fails: `bts [dst], imm` needs a size, like `bts qword [rbx], 1`.
pub macro bts(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}
## Copies bit `rs` of `rd` into CF, then clears it.
pub macro btr<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(-1, 0x0fb3, rd, rs, 0, 0) }
## Copies bit `imm` of `rd` into CF, then clears it.
pub macro btr<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(-1, 0x0FBA, 6, rd, imm, 1) }
## Copies bit `rs` of `[dst]` into CF, then clears it. The bit string can extend
## past `dst`.
pub macro btr<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(-1, 0x0fb3, rs, dst, 0, 0) }
## Copies bit `imm` of `[dst]` into CF, then clears it, `size` wide.
pub macro btr(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(-1, 0x0FBA, 6, dst, imm, 1, size) }
## Fails: `btr [dst], imm` needs a size, like `btr qword [rbx], 1`.
pub macro btr(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}
## Copies bit `rs` of `rd` into CF, then flips it.
pub macro btc<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr(-1, 0x0fbb, rd, rs, 0, 0) }
## Copies bit `imm` of `rd` into CF, then flips it.
pub macro btc<R>(rd: R, imm: int)
    | emits Bytes<...> { @emit ri(-1, 0x0FBA, 7, rd, imm, 1) }
## Copies bit `rs` of `[dst]` into CF, then flips it. The bit string can extend
## past `dst`.
pub macro btc<R>(dst: MemOperand, rs: R)
    | emits Bytes<...> { @emit rmem(-1, 0x0fbb, rs, dst, 0, 0) }
## Copies bit `imm` of `[dst]` into CF, then flips it, `size` wide.
pub macro btc(dst: MemOperand, imm: int, size: OperandSize)
    | emits Bytes<...> { @emit mi(-1, 0x0FBA, 7, dst, imm, 1, size) }
## Fails: `btc [dst], imm` needs a size, like `btc qword [rbx], 1`.
pub macro btc(_dst: MemOperand, _imm: int) {
    @assert 0 == 1, "this memory operand needs a size, like `qword [rbx]`"
}
## Sets `rd` to the index of the lowest set bit of `rs`; ZF = 1 if
## `rs` is 0.
pub macro bsf<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0fbc, rd, rs, 0, 0) }
## Sets `rd` to the index of the lowest set bit of `[src]`; ZF = 1 if
## it's 0.
pub macro bsf<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fbc, rd, src, 0, 0) }
## Sets `rd` to the index of the highest set bit of `rs`; ZF = 1 if
## `rs` is 0.
pub macro bsr<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0fbd, rd, rs, 0, 0) }
## Sets `rd` to the index of the highest set bit of `[src]`; ZF = 1 if
## it's 0.
pub macro bsr<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0fbd, rd, src, 0, 0) }
## Reverses the byte order of the 32- or 64-bit `rd`.
pub macro bswap<R>(rd: R)
    | emits Bytes<...>
{
    const d = gpr(rd)
    @assert d.size >= 32, "bswap takes a 32- or 64-bit register"
    @emit reg_in_opcode_instr(d.size, 0x0FC8, d, 0, 0)
}

# `movzx`/`movsx`: the destination's size gives the prefix and REX.W, and
# the source's size the opcode: `0F B6`/`0F BE` for 8 bits, `0F B7`/`0F BF`
# for 16.
macro extend_opcode(
    source_size: int,
    op8: int
) -> int {
    @assert source_size == 8 || source_size == 16, "the source must be 8 or 16 bits"
    @return op8 + (source_size == 16)
}

macro extend<D, S>(
    op8: int,
    rd: D,
    rs: S
) -> Bytes<...> {
    const d = gpr(rd)
    const s = gpr(rs)
    @assert d.size > s.size, "the destination must be wider than the source"
    @return reg_rm_instr(d.size, extend_opcode(s.size, op8), d, s, 0, 0)
}

macro extend_mem<D>(
    op8: int,
    rd: D,
    src: MemOperand,
    size: OperandSize
) -> Bytes<...> {
    const d = gpr(rd)
    @assert d.size > size.bits, "the destination must be wider than the source"
    @return reg_mem_instr(d.size, extend_opcode(size.bits, op8), d, src, 0, 0)
}

## `rd = rs`, zero-extended.
pub macro movzx<D, S>(rd: D, rs: S)
    | emits Bytes<...> { @emit extend(0x0FB6, rd, rs) }
## Loads the `size`-wide value at `src` into `rd`, zero-extended.
pub macro movzx<D>(rd: D, src: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit extend_mem(0x0FB6, rd, src, size) }
## `rd = rs`, sign-extended.
pub macro movsx<D, S>(rd: D, rs: S)
    | emits Bytes<...> { @emit extend(0x0FBE, rd, rs) }
## Loads the `size`-wide value at `src` into `rd`, sign-extended.
pub macro movsx<D>(rd: D, src: MemOperand, size: OperandSize)
    | emits Bytes<...> { @emit extend_mem(0x0FBE, rd, src, size) }

## `rd = rs`, a 32-bit register sign-extended into the 64-bit `rd`.
pub macro movsxd<D>(rd: D, rs: Reg32)
    | emits Bytes<...>
{
    const d = gpr(rd)
    @assert d.size == 64, "movsxd's destination is a 64-bit register"
    @emit reg_rm_instr(64, 0x63, d, gpr(rs), 0, 0)
}
## Loads the 32 bits at `src` into the 64-bit `rd`, sign-extended.
pub macro movsxd<D>(rd: D, src: MemOperand)
    | emits Bytes<...>
{
    const d = gpr(rd)
    @assert d.size == 64, "movsxd's destination is a 64-bit register"
    @emit reg_mem_instr(64, 0x63, d, src, 0, 0)
}
## `movsxd`; `size` must be `dword`.
pub macro movsxd<D>(rd: D, src: MemOperand, size: OperandSize)
    | emits Bytes<...>
{
    assert_size size, 32
    const d = gpr(rd)
    @assert d.size == 64, "movsxd's destination is a 64-bit register"
    @emit reg_mem_instr(64, 0x63, d, src, 0, 0)
}

# =================
# cmovcc and setcc
# =================
# The same 16 condition codes as `jcc`, and the same synonyms: `0F 40+cc`
# moves, `0F 90+cc` stores a byte, 1 or 0.

## `rd = rs` on signed overflow (OF = 1).
pub macro cmovo<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f40, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` on signed overflow (OF = 1).
pub macro cmovo<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f40, rd, src, 0, 0) }
## `rd = rs` without signed overflow (OF = 0).
pub macro cmovno<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f41, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` without signed overflow (OF = 0).
pub macro cmovno<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f41, rd, src, 0, 0) }
## `rd = rs` if below, unsigned (CF = 1).
pub macro cmovb<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f42, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if below, unsigned (CF = 1).
pub macro cmovb<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f42, rd, src, 0, 0) }
## `rd = rs` if above or equal, unsigned (CF = 0).
pub macro cmovae<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f43, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if above or equal, unsigned (CF = 0).
pub macro cmovae<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f43, rd, src, 0, 0) }
## `rd = rs` if equal (ZF = 1).
pub macro cmove<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f44, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if equal (ZF = 1).
pub macro cmove<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f44, rd, src, 0, 0) }
## `rd = rs` if not equal (ZF = 0).
pub macro cmovne<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f45, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if not equal (ZF = 0).
pub macro cmovne<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f45, rd, src, 0, 0) }
## `rd = rs` if below or equal, unsigned.
pub macro cmovbe<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f46, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if below or equal, unsigned.
pub macro cmovbe<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f46, rd, src, 0, 0) }
## `rd = rs` if above, unsigned.
pub macro cmova<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f47, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if above, unsigned.
pub macro cmova<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f47, rd, src, 0, 0) }
## `rd = rs` if the result was negative (SF = 1).
pub macro cmovs<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f48, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if the result was negative (SF = 1).
pub macro cmovs<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f48, rd, src, 0, 0) }
## `rd = rs` if the result wasn't negative (SF = 0).
pub macro cmovns<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f49, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if the result wasn't negative (SF = 0).
pub macro cmovns<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f49, rd, src, 0, 0) }
## `rd = rs` if the parity flag is set (PF = 1).
pub macro cmovp<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f4a, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if the parity flag is set (PF = 1).
pub macro cmovp<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f4a, rd, src, 0, 0) }
## `rd = rs` if the parity flag is clear (PF = 0).
pub macro cmovnp<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f4b, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if the parity flag is clear (PF = 0).
pub macro cmovnp<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f4b, rd, src, 0, 0) }
## `rd = rs` if less, signed.
pub macro cmovl<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f4c, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if less, signed.
pub macro cmovl<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f4c, rd, src, 0, 0) }
## `rd = rs` if greater or equal, signed.
pub macro cmovge<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f4d, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if greater or equal, signed.
pub macro cmovge<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f4d, rd, src, 0, 0) }
## `rd = rs` if less or equal, signed.
pub macro cmovle<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f4e, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if less or equal, signed.
pub macro cmovle<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f4e, rd, src, 0, 0) }
## `rd = rs` if greater, signed.
pub macro cmovg<R>(rd: R, rs: R)
    | emits Bytes<...> { @emit rr_load(-1, 0x0f4f, rd, rs, 0, 0) }
## Loads the value at `src` into `rd` if greater, signed.
pub macro cmovg<R>(rd: R, src: MemOperand)
    | emits Bytes<...> { @emit rmem(-1, 0x0f4f, rd, src, 0, 0) }
