#! NASM-flavored x86-64 assembly: everything `std.x86_64.intel` provides,
#! plus the NASM spellings it doesn't have.
#!
#! ```
#! from std.x86_64.nasm import *
#!
#! lea rsi, [rel msg]
#! mov eax, [rel counter]
#! add [rel total], rcx
#!
#! msg:
#!     db "Hello, World!", 10
#! counter:
#!     dd 0
#! total:
#!     dq 0
#! ```
#!
#! `[rip+disp]` from `std.x86_64.intel` takes a displacement you already
#! know; `[rel label]` takes a label and computes the displacement once the
#! code is laid out.
#!
#! Not covered: NASM's `$`/`$$`, `equ`, `times`, `resb`, and
#! `global`/`extern` (use `const`, `@for`, and `pub` labels instead).

# `impl.basm`'s `RipLabel` section has the encoding.

pub from .intel import *
from std.strings.utf8 import string_from_struct

# =================
# [rel label]
# =================
# An operand pattern, like `std.x86_64.intel`'s memory operands: `[rel msg]`
# is the call `rel(msg)`, a `RipLabel`, which picks `impl.basm`'s `RipLabel`
# overloads of `lea`, `mov` and the ALU instructions by type.

## `[rel label]`: the memory at `label`, addressed relative to the next
## instruction, so the code works wherever it's loaded.
##
## ```
## from std.x86_64.nasm import *
##
## lea rsi, [rel msg]    # msg is 6 bytes past the end of this instruction
## mov eax, [rel msg]    # and right after this one
##
## msg:
##     db "Hi", 10
## ```
##
## ```bytes
## 48 8d 35 06 00 00 00
## 8b 05 00 00 00 00
## 48 69 0a
## ```
pub macro rel(target: label) -> RipLabel
    | syntax { [rel $target$] }
{
    @return RipLabel(target = target)
}

# =================
# data: db/dw/dd/dq
# =================

## `value` as `width` little-endian bytes, truncated the way NASM does.
pub macro data_int(value: int, width: int) -> Bytes<...> {
    @return Bytes<width> {
        @for i in 0..width {
            __el`i`: byte_of(value, i),
        }
    }
}

## A string literal's UTF-8 bytes, with no terminator.
# A string's `String<N>` packs its first byte most significant, hence the
# reversed index.
pub macro data_string<S>(source: S) -> Bytes<...> {
    const packed = string_from_struct(source)
    const n = packed.len
    @return Bytes<n> {
        @for i in 0..n {
            __el`i`: byte_of(packed.value, n - 1 - i),
        }
    }
}

## Bytes. Each operand is an integer, stored in one byte, or a string
## literal, stored as its UTF-8 bytes with no terminator (add `, 0`
## yourself). Up to four operands; `db "Hello", 10` is the common case.
pub macro db(a: int) { @emit data_int(a, 1) }
pub macro db<S>(a: S) { @emit data_string(a) }
pub macro db<S>(a: S, b: int) {
    @emit data_string(a)
    @emit data_int(b, 1)
}

pub macro db<S>(a: S, b: int, c: int) {
    @emit data_string(a)
    @emit data_int(b, 1)
    @emit data_int(c, 1)
}

pub macro db(a: int, b: int) {
    @emit data_int(a, 1)
    @emit data_int(b, 1)
}

pub macro db(a: int, b: int, c: int) {
    @emit data_int(a, 1)
    @emit data_int(b, 1)
    @emit data_int(c, 1)
}

pub macro db(a: int, b: int, c: int, d: int) {
    @emit data_int(a, 1)
    @emit data_int(b, 1)
    @emit data_int(c, 1)
    @emit data_int(d, 1)
}

## 16-bit little-endian words, one or two per line.
pub macro dw(a: int) { @emit data_int(a, 2) }
pub macro dw(a: int, b: int) {
    @emit data_int(a, 2)
    @emit data_int(b, 2)
}

## 32-bit little-endian doublewords, one or two per line.
pub macro dd(a: int) { @emit data_int(a, 4) }
pub macro dd(a: int, b: int) {
    @emit data_int(a, 4)
    @emit data_int(b, 4)
}

## 64-bit little-endian quadwords, one or two per line.
pub macro dq(a: int) { @emit data_int(a, 8) }
pub macro dq(a: int, b: int) {
    @emit data_int(a, 8)
    @emit data_int(b, 8)
}
