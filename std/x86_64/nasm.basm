#! NASM-flavored x86-64 assembly: everything `std.x86_64.intel` provides,
#! plus the NASM spellings it doesn't have.
#!
#! ```
#! from std.x86_64.nasm import *
#!
#! lea rsi, [rel msg]
#! mov eax, [rel counter]
#! add [rel total], rcx
#!
#! msg:
#!     db "Hello, World!", 10
#! counter:
#!     dd 0
#! total:
#!     dq 0
#! ```
#!
#! `[rip+disp]` from `std.x86_64.intel` takes a displacement you already
#! know; `[rel label]` takes a label and computes the displacement once the
#! code is laid out. The two can't share a spelling: a label is a plain `int`
#! too, so `[rip+label]` would be exactly as well-typed as `[rip+disp]`.
#!
#! Not covered: NASM's `$`/`$$`, `equ`, `times`, `resb`, and
#! `global`/`extern` (use `const`, `@for`, and `pub` labels instead).

# `impl.basm`'s `RipLabel` section has the encoding.

pub from .intel import *
from std.string import string_from_struct

# =================
# [rel label]
# =================
# An *operand* syntax (its pattern starts with `[`, which no statement can, so
# the parser tries it wherever an operand starts — see
# `facets::syntax::is_operand_pattern`): `[rel msg]` parses as the call
# `rel(msg)`, a `RipLabel` value, which then picks the `RipLabel` overloads
# below by ordinary type-based overload resolution, reusing each mnemonic's
# existing `mov $a$, $b$`-shaped pattern.

## `[rel label]`: the memory at `label`, addressed relative to the next
## instruction, so the code works wherever it's loaded.
##
## ```
## from std.x86_64.nasm import *
##
## lea rsi, [rel msg]    # msg is 6 bytes past the end of this instruction
## mov eax, [rel msg]    # and right after this one
##
## msg:
##     db "Hi", 10
## ```
##
## ```bytes
## 48 8d 35 06 00 00 00
## 8b 05 00 00 00 00
## 48 69 0a
## ```
pub macro rel(target: int) -> RipLabel
    | syntax { [rel $target$] } {
        @return RipLabel(target = target)
    }

# `lea` had no two-operand pattern of its own in `intel.basm` (only its four
# bracketed shapes, registered unanchored under `lea_base`/... names), so
# claiming it here needs the same full-arity restatement every mnemonic there
# gets — see `intel.basm`'s header on why.
syntax lea(a, b, c) = { lea $a$, $b$, $c$ }

## Loads the address of `src` into `rd`.
pub macro lea(rd: Reg, src: RipLabel)
    | syntax { lea $rd$, $src$ } { lea rd, src, 1 }
pub macro lea(rd: Reg32, src: RipLabel)
    | syntax { lea $rd$, $src$ } { lea rd.reg, src, 0 }

## Loads the value at `src` into `rd`.
pub macro mov(rd: Reg, src: RipLabel)
    | syntax { mov $rd$, $src$ } { mov rd, src, 1 }
pub macro mov(rd: Reg32, src: RipLabel)
    | syntax { mov $rd$, $src$ } { mov rd.reg, src, 0 }
## Stores `rs` at `dst`.
pub macro mov(dst: RipLabel, rs: Reg)
    | syntax { mov $dst$, $rs$ } { mov dst, rs, 1 }
pub macro mov(dst: RipLabel, rs: Reg32)
    | syntax { mov $dst$, $rs$ } { mov dst, rs.reg, 0 }

## Adds `rs` to the value at `dst`.
pub macro add(dst: RipLabel, rs: Reg)
    | syntax { add $dst$, $rs$ } { add dst, rs, 1 }
pub macro add(dst: RipLabel, rs: Reg32)
    | syntax { add $dst$, $rs$ } { add dst, rs.reg, 0 }
## ORs `rs` into the value at `dst`.
pub macro or(dst: RipLabel, rs: Reg)
    | syntax { or $dst$, $rs$ } { or dst, rs, 1 }
pub macro or(dst: RipLabel, rs: Reg32)
    | syntax { or $dst$, $rs$ } { or dst, rs.reg, 0 }
## ANDs `rs` into the value at `dst`.
pub macro and(dst: RipLabel, rs: Reg)
    | syntax { and $dst$, $rs$ } { and dst, rs, 1 }
pub macro and(dst: RipLabel, rs: Reg32)
    | syntax { and $dst$, $rs$ } { and dst, rs.reg, 0 }
## Subtracts `rs` from the value at `dst`.
pub macro sub(dst: RipLabel, rs: Reg)
    | syntax { sub $dst$, $rs$ } { sub dst, rs, 1 }
pub macro sub(dst: RipLabel, rs: Reg32)
    | syntax { sub $dst$, $rs$ } { sub dst, rs.reg, 0 }
## XORs `rs` into the value at `dst`.
pub macro xor(dst: RipLabel, rs: Reg)
    | syntax { xor $dst$, $rs$ } { xor dst, rs, 1 }
pub macro xor(dst: RipLabel, rs: Reg32)
    | syntax { xor $dst$, $rs$ } { xor dst, rs.reg, 0 }
## Compares the value at `dst` with `rs`, setting flags like `sub` without
## storing.
pub macro cmp(dst: RipLabel, rs: Reg)
    | syntax { cmp $dst$, $rs$ } { cmp dst, rs, 1 }
pub macro cmp(dst: RipLabel, rs: Reg32)
    | syntax { cmp $dst$, $rs$ } { cmp dst, rs.reg, 0 }
## ANDs the value at `dst` with `rs`, setting flags without storing.
pub macro test(dst: RipLabel, rs: Reg)
    | syntax { test $dst$, $rs$ } { test dst, rs, 1 }
pub macro test(dst: RipLabel, rs: Reg32)
    | syntax { test $dst$, $rs$ } { test dst, rs.reg, 0 }

# =================
# data: db/dw/dd/dq
# =================

## `value` as `width` little-endian bytes, truncated the way NASM does.
pub macro data_int(value: int, width: int) -> Bytes<...> {
    @return Bytes<width> {
        @for i in 0..width {
            __el`i`: byte_of(value, i),
        }
    }
}

## A string literal's UTF-8 bytes, with no terminator.
# A string's `String<N>` packs its first byte most significant, hence the
# reversed index.
pub macro data_string<S>(source: S) -> Bytes<...> {
    const packed = string_from_struct(source)
    const n = packed.len
    @return Bytes<n> {
        @for i in 0..n {
            __el`i`: byte_of(packed.value, n - 1 - i),
        }
    }
}

## Bytes. Each operand is an integer, stored in one byte, or a string
## literal, stored as its UTF-8 bytes with no terminator (add `, 0`
## yourself). Up to four operands; `db "Hello", 10` is the common case.
pub macro db(a: int) { @emit data_int(a, 1) }
pub macro db<S>(a: S) { @emit data_string(a) }
pub macro db<S>(a: S, b: int) {
    @emit data_string(a)
    @emit data_int(b, 1)
}
pub macro db<S>(a: S, b: int, c: int) {
    @emit data_string(a)
    @emit data_int(b, 1)
    @emit data_int(c, 1)
}
pub macro db(a: int, b: int) {
    @emit data_int(a, 1)
    @emit data_int(b, 1)
}
pub macro db(a: int, b: int, c: int) {
    @emit data_int(a, 1)
    @emit data_int(b, 1)
    @emit data_int(c, 1)
}
pub macro db(a: int, b: int, c: int, d: int) {
    @emit data_int(a, 1)
    @emit data_int(b, 1)
    @emit data_int(c, 1)
    @emit data_int(d, 1)
}

## 16-bit little-endian words, one or two per line.
pub macro dw(a: int) { @emit data_int(a, 2) }
pub macro dw(a: int, b: int) {
    @emit data_int(a, 2)
    @emit data_int(b, 2)
}

## 32-bit little-endian doublewords, one or two per line.
pub macro dd(a: int) { @emit data_int(a, 4) }
pub macro dd(a: int, b: int) {
    @emit data_int(a, 4)
    @emit data_int(b, 4)
}

## 64-bit little-endian quadwords, one or two per line.
pub macro dq(a: int) { @emit data_int(a, 8) }
pub macro dq(a: int, b: int) {
    @emit data_int(a, 8)
    @emit data_int(b, 8)
}
