from std.math import *

macro verify() {
    @emit gcd(48, 18)
    @emit lcm(21, 6)
    @emit isqrt(81)
    @emit pow(3, 5)
    @emit pow_mod(4, 13, 497)
    @emit div_floor(-7, 3)
    @emit div_ceil(-7, 3)
    @emit rem_euclid(-7, 3)
    @emit div_euclid(-7, 3)
    @emit popcount(255)
    @emit clz(1, 8)
    @emit ctz(8)
    @emit rotate_left(129, 1, 8)
    @emit rotate_right(3, 1, 8)
    @emit next_pow_of_two(9)
    @emit is_pow_of_two(16)
    @emit PI()
    @emit TAU(8)
    @emit E(8)
    @emit SQRT2(8)
    @emit LN2(8)
    @emit LN10(8)
    @emit root(27, 3, 8)
    @emit sqrt(2, 8)
    @emit hypot(Decimal(value = 3, scale = 0), Decimal(value = 4, scale = 0), 8)
    @emit exp(Decimal(value = 1, scale = 0), 8)
    @emit pow(Decimal(value = -2, scale = 0), 3, 8)
    @emit exp2(Decimal(value = 3, scale = 0), 8)
    @emit ln(E(12), 8)
    @emit ln(Decimal(value = 5, scale = 1), 8)
    @emit log2(Decimal(value = 8, scale = 0), 8)
    @emit log10(Decimal(value = 100, scale = 0), 8)
    @emit log1p(Decimal(value = 1, scale = 0), 8)
    @emit expm1(Decimal(value = 1, scale = 0), 8)
    @emit sin(PI(12), 8)
    @emit cos(Decimal(value = 0, scale = 0), 8)
    @emit tan(Decimal(value = 0, scale = 0), 8)
    @emit asin(Decimal(value = 5, scale = 1), 8)
    @emit acos(Decimal(value = 5, scale = 1), 8)
    @emit atan(Decimal(value = 1, scale = 1), 8)
    @emit atan2(Decimal(value = 1, scale = 0), Decimal(value = 1, scale = 0), 8)
    @emit sinh(Decimal(value = 1, scale = 0), 8)
    @emit cosh(Decimal(value = 1, scale = 0), 8)
    @emit tanh(Decimal(value = 1, scale = 0), 8)
    @emit asinh(Decimal(value = 1, scale = 0), 8)
    @emit acosh(Decimal(value = 2, scale = 0), 8)
    @emit atanh(Decimal(value = 5, scale = 1), 8)
}

verify
