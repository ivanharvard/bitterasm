# The exact same instructions as dialect_intel.basm, in the same order, spelled
# with std/x86_64/impl.basm's own default positional syntax (explicit w=1,
# Mem(...)/MemIndexed(...)/MemRipRelative(...) instead of bracket syntax) — see
# tests/x86_64_dialects.rs and std/x86_64/PROGRESS.md's Phase 6 section.

from std.x86_64.impl import *

mov rax, rbx, 1
mov rax, Mem(rbx, 0), 1
mov rax, Mem(rbx, 8), 1
mov rax, MemIndexed(rbx, rcx, 4, 0x10), 1
mov rax, MemRipRelative(0x20), 1
mov Mem(rbx, 0), rax, 1
mov Mem(rbx, 8), rax, 1
mov MemIndexed(rbx, rcx, 4, 0x10), rax, 1
mov MemRipRelative(0x20), rax, 1

add rax, rbx, 1
addi rax, 5, 1
or rax, rbx, 1
ori rax, 5, 1
and rax, rbx, 1
andi rax, 5, 1
sub rax, rbx, 1
subi rax, 5, 1
xor rax, rbx, 1
xori rax, 5, 1
cmp rax, rbx, 1
cmpi rax, 5, 1
test rax, rbx, 1
testi rax, 5, 1
movi rax, 100, 1

lea rax, Mem(rbx, 8), 1
lea rax, MemIndexed(rbx, rcx, 4, 0x10), 1

shl rax, 4, 1
shl_cl rax, 1
shr rax, 4, 1
shr_cl rax, 1
sar rax, 4, 1
sar_cl rax, 1

push rax
pop rax

target:
call target
jmp target
je target
jne target
ret
