# Phase 4 control flow: jmp/jcc/call/ret. Deliberately mixes instructions of
# different byte lengths between labels (2/5/5/3/3/6/5/1 bytes) so a forward
# branch (jmp) and two backward branches (je, call) each have to cross a
# genuinely non-uniform byte distance — the exact case that broke RISC-V's
# fixed-width `mul(sub(target, here()), 4)` trick and motivated generalizing
# `span()`. See tests/x86_64_encoding.rs for the hand-computed expected bytes.

from std.x86_64.impl import *

start:
mov rax, rbx, 0            # 2 bytes
movi rax, 0x12345678, 0    # 5 bytes
jmp target                 # 5 bytes, forward branch (skips over the next instruction)
add rcx, rdx, 1            # 3 bytes
target:
mov r8, r9, 0              # 3 bytes
je start                   # 6 bytes, backward branch
call target                # 5 bytes, backward branch
ret                        # 1 byte
syscall                    # 2 bytes
