pub struct Cartesian
    | to cartesian_to_polar(source.x, source.y)
{
    pub x: int,
    pub y: int,
}

pub struct Polar
    | invariant source.radius >= 0
    | from polar_from_int(source)
{
    pub radius: int,
    pub angle: int,
}

macro cartesian_to_polar(x: int, y: int) -> Polar {
    @return Polar(radius = x + y, angle = 0)
}

macro polar_from_int(value: int) -> Polar {
    @return Polar(radius = value, angle = 0)
}

macro convert_cartesian(value: Cartesian) -> Polar {
    @return value as Polar
}

macro convert_int(value: int) -> Polar {
    @return value as Polar
}

pub struct Sized<const len: int>
    | from sized_from_int(source, target.len)
{
    pub value: int,
    pub requested_len: int,
}

macro sized_from_int(value: int, len: int) -> Sized<7> {
    @return Sized<7> {
        value: value,
        requested_len: len
    }
}

macro convert_int_to_sized(value: int) -> Sized<7> {
    @return value as Sized<7>
}
