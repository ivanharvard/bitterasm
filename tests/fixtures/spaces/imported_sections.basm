# A section imported as a const. A label in `.vectors` is in its space,
# `rom`. A bare `section .text` needs nothing imported.
from .section_lib import rom, VECTORS

macro show(value: int) {
    @emit value
}

macro in_rom(at: label<rom>) {
    @emit at as int
}

@into VECTORS
reset:
    show 1
section .text
show 2
in_rom reset
