# Sections imported by name and with `*`. A label in the imported
# `.vectors` is in its space, `rom`.
from .section_lib import rom, .vectors
from std.formats.elf import *

macro show(value: int) {
    @emit value
}

macro in_rom(at: label<rom>) {
    @emit at as int
}

section .vectors
reset:
    show 1
section .text
show 2
in_rom reset
