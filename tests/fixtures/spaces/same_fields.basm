# Two consts holding spaces with the same fields hold the same space, so a
# label in `also_flash` is a `label<flash>`.
from std.spaces import start

macro show(value: int) {
    @emit value
}

macro in_flash(at: label<flash>) {
    @emit at as int
}

const flash: space = stream | start(0x100)
const also_flash: space = stream | start(0x100)

section .text in also_flash
here:
    show 1
    in_flash here
