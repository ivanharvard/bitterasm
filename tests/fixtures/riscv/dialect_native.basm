from std.riscv.native import *

start:
add x1, x2, x3
sub x1, x2, x3
and x1, x2, x3
or x1, x2, x3
xor x1, x2, x3
sll x1, x2, x3
srl x1, x2, x3
sra x1, x2, x3
slt x1, x2, x3

addi x1, x2, 5
andi x1, x2, 5
ori x1, x2, 5
xori x1, x2, 5
slli x1, x2, 5
srli x1, x2, 5
srai x1, x2, 5
slti x1, x2, 5

lb x1, 4(x2)
lbu x1, 4(x2)
lh x1, 4(x2)
lhu x1, 4(x2)
lw x1, 4(x2)

sb x1, 4(x2)
sh x1, 4(x2)
sw x1, 4(x2)

beq x1, x2, start
bne x1, x2, start
blt x1, x2, start
bge x1, x2, start

jal x1, start
jalr x1, x2, 4
