from std.riscv.c_like import *

start:
x1 = x2 + x3
x1 = x2 - x3
x1 = x2 & x3
x1 = x2 | x3
x1 = x2 ^ x3
x1 = x2 << x3
x1 = x2 >>> x3
x1 = x2 >> x3
x1 = x2 < x3

x1 <- x2 + 5
x1 <- x2 & 5
x1 <- x2 | 5
x1 <- x2 ^ 5
x1 <- x2 << 5
x1 <- x2 >>> 5
x1 <- x2 >> 5
x1 <- x2 < 5

