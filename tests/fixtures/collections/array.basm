from std.array import *

macro show_all<const N: int>(values: Array<int, N>) {
    @for v in values {
        @emit v
    }
}

macro show(v: int) {
    @emit v
}

macro is_even(x: int) -> int {
    @return x % 2 == 0
}

const a = Array<int, 3>(3, 1, 2)
show_all filled<int, 3>(7)
show_all concatenated(a, Array<int, 2>(9, 8))
show sum(a)
show sum(Array<int, 0>())
show any(a, is_even)
show all(a, is_even)
show_all sorted(Array<int, 6>(5, -1, 3, 3, 0, 9))
show_all sorted(Array<int, 0>())
